@using Radzen
@using Radzen.Blazor
@inject IJSRuntime JSRuntime
@inject IMatToaster Toaster
@inject SicemService sicemService
@inject ConsultaGralService consultaGralService;

@if (Show)
{
    <div class="busy-control">

        <div id="draggable" class="SicemDialog-control" style="width:990px; height:auto;">

            @* *********** Cabecera *********** *@
            <div class="SicemDialog-header">
                <div>@_titulo</div>
                <MatIcon @onclick="@Cerrar_Modal" Class="close-icon" style="margin-left: auto;" Icon="clear"></MatIcon>
            </div>

            @* *********** Contenido *********** *@
            <div class="SicemDialog-content" style="height: 100%; width:100%;  display:grid; grid-template-columns: 100%; grid-template-rows: 115px 525px 40px;">

                <div class="p-1" style="grid-row: 1/2; grid-column: 1/2; align-items: center;">
                    <div class="container-fluid mt-3 mb-5">
                        <div class="row">
                            <div class="col-12">
                                <div class="row">
                                    <div class="col-12 p-1">
                                        <RadzenTextBox Placeholder="Razon Social" @bind-Value="BusquedaModel.Nombre" @onkeydown="@TextBox_KeyDown" class="w-100" />
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-6 p-1">
                                        <RadzenTextBox Placeholder="Direccion" @bind-Value="BusquedaModel.Direccion" @onkeydown="@TextBox_KeyDown" class="w-100" />
                                    </div>
                                    <div class="col-6 p-1">
                                        <RadzenTextBox Placeholder="Colonia" @bind-Value="BusquedaModel.Colonia" @onkeydown="@TextBox_KeyDown" class="w-100" />
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-6 p-1">
                                        <RadzenTextBox Placeholder="Nº Medidor" @bind-Value="BusquedaModel.Medidor" @onkeydown="@TextBox_KeyDown" class="w-100" />
                                    </div>
                                    <div class="col-4 p-1">
                                        <RadzenCheckBox TValue="bool" @bind-Value="BusquedaModel.SoloActivos" Name="cbSoloActivos" />
                                        <RadzenLabel Text="Mostrar solo cuentas activas" Component="cbSoloActivos" class="ml-1" />
                                    </div>
                                    <div class="col-2 p-1">

                                        @if (_busy)
                                        {
                                            <MatButton Outlined="true" Dense="true" style="width: 120px;">
                                                <MatProgressCircle Indeterminate="true" Size="MatProgressCircleSize.Small" />
                                            </MatButton>
                                        }
                                        else
                                        {
                                            <MatButton Id="BotonBusquedaCuenta" Outlined="true" Dense="true" @onclick="Busqueda_Click" TrailingIcon="search" style="width: 120px;">Buscar</MatButton>
                                        }

                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="p-1" style="grid-row: 2/3; grid-column: 1/2;">
                    <RadzenDataGrid @ref="@_myGrid" TItem="Cuenta_Arquos" Data="@ItemsGrid" AllowSorting="true" AllowFiltering="false" AllowColumnResize="true" AllowAlternatingRows="true"
                                SelectionMode="DataGridSelectionMode.Single" RowSelect="@SelectionGrid_Changed" RowDeselect="@SelectionGrid_Unselected" RowDoubleClick="@RecordDoubleClickHandler"
                                Style="height:100%; width:100%;">
                                <Columns>
                                    <RadzenDataGridColumn Property="@nameof(Cuenta_Arquos.Id_cuenta)" Title="N CUENTA" TextAlign="TextAlign.Left" Width="100px" />
                                    <RadzenDataGridColumn Property="@nameof(Cuenta_Arquos.Razon_social)" Title="RAZON SOCIAL" TextAlign="TextAlign.Left" Width="230px" />
                                    <RadzenDataGridColumn Property="@nameof(Cuenta_Arquos.Nombre_comercial)" Title="NOM COMERCIAL" TextAlign="TextAlign.Left" Width="230px" />
                                    <RadzenDataGridColumn Property="@nameof(Cuenta_Arquos.Direccion)" Title="DIRECCION" TextAlign="TextAlign.Left" Width="140px" />
                                    <RadzenDataGridColumn Property="@nameof(Cuenta_Arquos.Servicio)" Title="SERVICIO" TextAlign="TextAlign.Left" Width="110px" />
                                    <RadzenDataGridColumn Property="@nameof(Cuenta_Arquos.Colonia)" Title="COLONIA" TextAlign="TextAlign.Left" Width="110px" />
                                    <RadzenDataGridColumn Property="@nameof(Cuenta_Arquos.Poblacion)" Title="POBLACION" TextAlign="TextAlign.Left" Width="110px" />
                                    <RadzenDataGridColumn Property="@nameof(Cuenta_Arquos.Medidor)" Title="MEDIDOR" TextAlign="TextAlign.Left" Width="110px" />
                                    <RadzenDataGridColumn Property="@nameof(Cuenta_Arquos.Estatus)" Title="ESTATUS" TextAlign="TextAlign.Left" Width="90px" />
                                </Columns>
                            </RadzenDataGrid>
                </div>

                <div class="p-1 d-flex justify-content-center align-items-center " style="grid-row: 3/4; grid-column: 1/2; align-items: center;">
                    <MatButton Disabled="_botonDesactivado" Unelevated="true" OnClick="@Cerrar_Modal_Value" style="width:260px;">Seleccionar Cuenta</MatButton>
                </div>

            </div>
        </div>

    </div>
}


@code
{
    [Parameter]
    public EventCallback<long?> CerrarModal { get; set; }
    [Parameter]
    public bool Show { get; set; }

    RadzenDataGrid<Cuenta_Arquos> _myGrid;
    public BusquedaCuentaModel BusquedaModel { get; set; }
    public Cuenta_Arquos[] ItemsGrid { get; set; }
    private string _titulo = "BUSQUEDA DE CUENTA";
    private bool _busy = false;
    private long? _cuentaSeleccionada;
    private bool _botonDesactivado = true;
    private Ruta _oficinaActual;


    protected override void OnInitialized()
    {
        BusquedaModel = new BusquedaCuentaModel();
    }

    public async Task Inicializar(Ruta ofi)
    {
        await JSRuntime.InvokeVoidAsync("ConfigurateDragg", "");
        ItemsGrid = null;
        this._oficinaActual = ofi;
        this._titulo = $"{ofi.Oficina.ToUpper()} - BUSQUEDA DE CUENTA";
    }
    private async Task Busqueda_Click()
    {
        this._busy = true;
        await Task.Delay(200);
        var tmpItems = consultaGralService.BusquedaCuentas(_oficinaActual.Id, BusquedaModel.Nombre, BusquedaModel.Medidor, BusquedaModel.Direccion, BusquedaModel.Colonia, (BusquedaModel.SoloActivos) ? 1 : 0);
        if (tmpItems.Length > 0)
        {
            ItemsGrid = tmpItems;
        }
        else
        {
            ItemsGrid = null;
            Toaster.Add("No hay datos disponibles.", MatToastType.Info, "");
        }
        await Task.Delay(200);
        this._busy = false;
    }

    private async void TextBox_KeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await JSRuntime.InvokeVoidAsync("FocusElement", "BotonBusquedaCuenta");
        }
    }
    protected async Task Cerrar_Modal_Value()
    {
        BusquedaModel = new BusquedaCuentaModel();
        await CerrarModal.InvokeAsync(_cuentaSeleccionada);
    }
    protected async Task Cerrar_Modal()
    {
        BusquedaModel = new BusquedaCuentaModel();
        await CerrarModal.InvokeAsync(null);
    }
    private void SelectionGrid_Changed(Cuenta_Arquos selectedRow)
    {
        if (selectedRow != null)
        {
            _cuentaSeleccionada = selectedRow.Id_cuenta;
            _botonDesactivado = false;
        }
        else
        {
            _cuentaSeleccionada = null;
            _botonDesactivado = true;
        }
    }
    private void SelectionGrid_Unselected(Cuenta_Arquos deselectedRow)
    {
        _cuentaSeleccionada = null;
        _botonDesactivado = true;
    }
    private async Task RecordDoubleClickHandler(DataGridRowMouseEventArgs<Cuenta_Arquos> param)
    {
        if (param.Data != null)
        {
            _cuentaSeleccionada = param.Data.Id_cuenta;
            _botonDesactivado = false;
            await Cerrar_Modal_Value();
        }
    }
}