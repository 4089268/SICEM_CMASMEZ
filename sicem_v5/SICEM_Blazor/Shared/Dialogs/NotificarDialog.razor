@namespace Sicem_Blazor.Shared.Dialogs
@using Radzen
@using Radzen.Blazor
@using Sicem_Blazor.Data.KML
@using System.Text.RegularExpressions
@using Sicem_Blazor.Models
@using Sicem_Blazor.Data.Whatsapp


<VentanaSecundaria Titulo="@Titulo" Filas="@_filasTemplate" Columnas="@_columnasTemplate" CerrarVentana="CerrarVentana_Click">
    <Content>

        <div class="pb-1" id="lista-templates">
            
            <RadzenDataGrid TItem="NotificacionTemplate" Data="@DatosGrid" AllowColumnResize="true" AllowSorting="true" AllowFiltering="false"
                SelectionMode="DataGridSelectionMode.Single" RowSelect="@OnDataGrid_SelectionChanged" Style="height:100%; width:100%;">
                <Columns>
                    <RadzenDataGridColumn Property="@nameof(NotificacionTemplate.Titulo)" Title="Templates" TextAlign="TextAlign.Left" Width="140px">
                        <Template Context="data">
                            <i class="fa fa-newspaper mr-2" />
                            <span>@data.Titulo</span>
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
        </div>

        <div id="panel-message" class="carousel slide d-flex" data-ride="carousel">
            <RadzenTextArea Placeholder="Mensaje a notificar" @bind-Value="@TextoMensaje" />
        </div>

        <div id="panel-dest" class="carousel slide" data-ride="carousel">
            <RadzenDataGrid TItem="CatPadron" Data="@PadronUsuarios_ConTelefono" AllowColumnResize="true" AllowSorting="true" Density="Density.Compact"
                SelectionMode="DataGridSelectionMode.Single" RowSelect="@OnDestinatarioSeleccionado" Style="height:100%; width:100%;">
                <Columns>
                    <RadzenDataGridColumn Property="@nameof(CatPadron.RazonSocial)" Title="Razon Social" TextAlign="TextAlign.Left" Width="210px" />
                    <RadzenDataGridColumn Property="@nameof(CatPadron.Telefono1)" Title="Telefono" TextAlign="TextAlign.Left" Width="120px" />
                </Columns>
            </RadzenDataGrid>
        </div>

        <div class="p-2 d-flex bg-white border rounded" style="width:100%; height:100%; grid-area:2/2/3/4;">

            <div class="button px-3 py-2 bg-success mr-4  @( DestinatarioSeleccionado == null?"dissable": " ")" @onclick="PrevisualizarTexto_Click" >
                <i class="fa fa-terminal mr-2"></i>
                <span>Pre-Visualizar mensaje</span>
            </div>


            <div class="button px-3 py-2 bg-success mr-4" @onclick="EnviarMensaje">
                <i class="fa fa-send mr-2"></i>
                <span>Notificar destinatarios</span>
            </div>

        </div>

    </Content>
</VentanaSecundaria>

<BusyIndicator Busy="_cargando" ContentText="Cargando datos..." />

@if(_mostrarPre)
{
    <div class="busy-control" >
        <div class="busy-content justify-content-start" style="width:34rem; height:14rem;">
            <div class="d-flex align-items-end justify-content-end w-100">
                <i class="fa fa-close" @onclick="@(e => _mostrarPre = false)"></i>
            </div>
            <div class="w-100 h-100">
                @MesnajePrevisualizado
            </div>
        </div>
    </div>
}

<style>

    #lista-templates{
        width:100%;
        height:100%;
        grid-area:1/1/4/2;
    }
    #textarea-message
    {
        height: 100%;
        width: 100%;
    }

    #panel-message
    {
        width:100%;
        height:100%;
        grid-area:1/2/2/3;
    }
    #panel-message textarea{
        height: 100%;
        width: 100%;
        resize: none;
    }

    #panel-dest
    {
        width:100%;
        height:100%;
        grid-area:1/3/2/4;
    }

    #panel-dest .rz-cell-data{
        font-size: 10px !important;
    }

</style>