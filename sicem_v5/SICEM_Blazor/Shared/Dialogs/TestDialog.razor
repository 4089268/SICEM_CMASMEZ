@using Radzen
@using Radzen.Blazor
@inject SicemService sicemService
@inject HttpClient Http
@inject IJSRuntime JSRuntime

@if (Show)
{
    <div class="busy-control">

        <div @ref="_myElementReference" id="draggable" class="SicemDialog-control" style="width:940px; height:720px;">
        
            <div class="SicemDialog-header">
                <h4>Movimientos @RazonSocial</h4>
                <MatIcon @onclick="@Cerrar_Modal" Class="close-icon" style="margin-left: auto;" Icon="clear"></MatIcon>
            </div>

            <div class="SicemDialog-content">                        
                <RadzenDataGrid TItem="ConsultaGreal_MovimientosResponse" Data="@movimientosItems" AllowSorting="true" AllowFiltering="false" Style="height:100%; width:100%;">
                    <Columns>
                        <RadzenDataGridColumn Property="@nameof(ConsultaGreal_MovimientosResponse.Fecha)" Title="Fecha" TextAlign="TextAlign.Center" Width="120px" />
                        <RadzenDataGridColumn Property="@nameof(ConsultaGreal_MovimientosResponse.Id_tipomovto)" Title="tipo_movimiento" TextAlign="TextAlign.Center" Width="90px" />
                        <RadzenDataGridColumn Property="@nameof(ConsultaGreal_MovimientosResponse.Operacion)" Title="Operacion" TextAlign="TextAlign.Left" Width="120px" />
                        <RadzenDataGridColumn Property="@nameof(ConsultaGreal_MovimientosResponse.Folio_movto)" Title="Movimiento" TextAlign="TextAlign.Center" Width="100px" />
                        <RadzenDataGridColumn Property="@nameof(ConsultaGreal_MovimientosResponse.Cargo)" Title="Cargo" TextAlign="TextAlign.Right" Width="100px" FormatString="{0:c2}" />
                        <RadzenDataGridColumn Property="@nameof(ConsultaGreal_MovimientosResponse.Abono)" Title="Abono" TextAlign="TextAlign.Right" Width="100px" FormatString="{0:c2}" />
                        <RadzenDataGridColumn Property="@nameof(ConsultaGreal_MovimientosResponse.Saldo)" Title="Saldo" TextAlign="TextAlign.Right" Width="100px" FormatString="{0:c2}" />
                        <RadzenDataGridColumn Property="@nameof(ConsultaGreal_MovimientosResponse.Quien)" Title="Realizo" TextAlign="TextAlign.Left" Width="100px" />
                    </Columns>
                </RadzenDataGrid>
            </div>
        </div>

    </div>
}

@code
{
    [Parameter]
    public EventCallback CerrarModal { get; set; }

    [Parameter]
    public bool Show { get; set;}

    [Parameter]
    public int Id_padron {get;set;}

    [Parameter]
    public string RazonSocial {get;set;}


    ElementReference _myElementReference;
    public List<ConsultaGreal_MovimientosResponse> movimientosItems { get; set; }


    /******** FUNCIONES ********/
    protected override void OnAfterRender(bool firstRender)
    {
        JSRuntime.InvokeAsync<int>("ConfigurateDragg", _myElementReference);
        base.OnAfterRender(firstRender);
    }

    protected async Task Cerrar_Modal()
    {
        await CerrarModal.InvokeAsync("");
    }
    
}