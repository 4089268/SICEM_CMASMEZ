
@* Filtro de rango numérico: operador (Cualquiera / Mayor que / Menor que / Entre / Igual) + uno o dos valores *@
<div class="NsRangeNumeric">
    <RadzenStack Orientation="Orientation.Vertical" Gap="0.1rem">
        <RadzenDropDown TValue="int" Value="@OpcionSeleccionado" ValueChanged="@OnOpcion_Changed"
            Data="@_opciones" TextProperty="Value" ValueProperty="Key"
            Name="@Name" Style="width: 100%;" />

        @if (OpcionSeleccionado != 0)
        {
            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.25rem">
                <RadzenNumeric TValue="decimal" Value="@Valor1" ValueChanged="@OnValor1_Changed" Format="@Format" ShowUpDown="false" TextAlign="TextAlign.Right"
                    Style="@($"width: {(OpcionSeleccionado != 3 ? "50" : "100")}%;")" />

                @if (OpcionSeleccionado == 3)
                {
                    <RadzenNumeric TValue="decimal" Value="@Valor2" ValueChanged="@OnValor2_Changed" Format="@Format" ShowUpDown="false" TextAlign="TextAlign.Right"
                        Style="width: 100%;" />
                }
            </RadzenStack>
        }
    </RadzenStack>
</div>


@code
{
    [Parameter] public string Format { get; set; } = "n2";
    [Parameter] public string Name { get; set; }

    [Parameter] public int OpcionSeleccionado { get; set; }
    [Parameter] public EventCallback<int> OpcionSeleccionadoChanged { get; set; }

    [Parameter] public decimal Valor1 { get; set; }
    [Parameter] public EventCallback<decimal> Valor1Changed { get; set; }

    [Parameter] public decimal Valor2 { get; set; }
    [Parameter] public EventCallback<decimal> Valor2Changed { get; set; }

    // Valores numéricos del operador (los usa la consulta: 0 = Cualquiera, 1 = Mayor que, 2 = Menor que, 3 = Entre, 4 = Igual)
    private static readonly Dictionary<int, string> _opciones = new Dictionary<int, string>()
    {
        { 0, "Cualquiera" },
        { 1, "Mayor que" },
        { 2, "Menor que" },
        { 3, "Entre" },
        { 4, "Igual" }
    };

    private async Task OnOpcion_Changed(int valor)
    {
        OpcionSeleccionado = valor;
        await OpcionSeleccionadoChanged.InvokeAsync(valor);
    }

    private async Task OnValor1_Changed(decimal valor)
    {
        Valor1 = valor;
        await Valor1Changed.InvokeAsync(valor);
    }

    private async Task OnValor2_Changed(decimal valor)
    {
        Valor2 = valor;
        await Valor2Changed.InvokeAsync(valor);
    }
}
