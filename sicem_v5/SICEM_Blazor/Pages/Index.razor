@page "/"
@inject NavigationManager NavManager
@inject IJSRuntime JSRuntime
@inject SicemService sicemService

<div id="imglogo" class="b d-flex justify-content-center align-items-center" style="height:80vh; opacity:0; padding-top:6rem;">
    <img class="logoIndex" src="/img/logo_cmas.png" style="opacity: 0.75;" />
</div>


<style>
    body {
        background-image: url("./img/textures/texture.png");
        background-position: center;
        background-repeat: repeat;
    }
    .logoIndex{
        width: 35vh;
    }
    @@media (max-width: 580px) {
        .logoIndex{
            width: 80%;
            
        }
    }


</style>

@code {

    protected override async Task OnAfterRenderAsync(bool firstRender) {
        await JSRuntime.InvokeVoidAsync("fadeIn", "#imglogo", 600);
    }

}