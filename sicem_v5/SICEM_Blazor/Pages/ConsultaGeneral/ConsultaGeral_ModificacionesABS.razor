@inject IJSRuntime JSRuntime

@if (Show)
{
    <VentanaSecundaria Titulo="@Titulo" CerrarVentana="@CerrarModal" Filas="@(new double[]{150, 420, 40 })" Columnas="@(new double[]{.45, .4})">
        <Content>
            <div class="p-1" style="grid-row: 1 / 2; grid-column: 1 / 3; align-items: center;">
                <div class="container-fluid" style="font-weight:bold;">
                    <div class="row my-1">
                        <div class="col-2"> CUENTA </div>
                        <div class="col-4">
                            <RadzenNumeric TValue="long?" ReadOnly="true" Value="@((long?)DatosGenerales.Id_Cuenta)" Format="000000000" Placeholder="Cuenta" ShowUpDown="false" class="w-100" />
                        </div>

                        <div class="col-2"> ESTATUS </div>
                        <div class="col-4">
                            <RadzenTextBox ReadOnly="true" Value="@DatosGenerales.Estatus" Placeholder="Estatus" class="w-100" />
                        </div>
                    </div>
                    <div class="row my-1">
                        <div class="col-2"> RAZON SOCIAL </div>
                        <div class="col-4">
                            <RadzenTextBox ReadOnly="true" Value="@DatosGenerales.Razon_social" Placeholder="Nombre" class="w-100" />
                        </div>

                        <div class="col-2"> TARIFA </div>
                        <div class="col-4">
                            <RadzenTextBox ReadOnly="true" Value="@DatosGenerales.TarifaFija" Placeholder="Tarifa" class="w-100" />
                        </div>
                    </div>
                    <div class="row my-1">
                        <div class="col-2"> DIRECCION </div>
                        <div class="col-4">
                            <RadzenTextBox ReadOnly="true" Value="@DatosGenerales.Direccion" Placeholder="Direccion" class="w-100" />
                        </div>

                        <div class="col-2"> SERVICIO </div>
                        <div class="col-4">
                            <RadzenTextBox ReadOnly="true" Value="@DatosGenerales.Servicio" Placeholder="Servicio" class="w-100" />
                        </div>
                    </div>
                    <div class="row my-1">
                        <div class="col-2"> COLONIA </div>
                        <div class="col-4">
                            <RadzenTextBox ReadOnly="true" Value="@DatosGenerales.Colonia" Placeholder="Colonia" class="w-100" />
                        </div>

                        <div class="col-2"> MEDIDOR </div>
                        <div class="col-4">
                            <RadzenTextBox ReadOnly="true" Value="@DatosGenerales.Medidor" Placeholder="Medidor" class="w-100" />
                        </div>
                    </div>
                    <div class="row my-1">
                        <div class="col-2"> GIRO </div>
                        <div class="col-4">
                            <RadzenTextBox ReadOnly="true" Value="@DatosGenerales.Giro" Placeholder="Giro" class="w-100" />
                        </div>

                        <div class="col-2"> ADEUDO </div>
                        <div class="col-4">
                            <RadzenNumeric TValue="double?" ReadOnly="true" Value="@((double?)DatosGenerales.SaldoAct_total)" Format="c2" Placeholder="Saldo" ShowUpDown="false" class="w-100" />
                        </div>
                    </div>
                </div>
            </div>

            <div class="p-1" style="grid-row: 2/3; grid-column: 1/2;">
                <div class="w-100 h-100">
                    <RadzenDataGrid @ref="@MyDataGrid" TItem="ConsultaGral_ModificacionesABCResponse" Data="@MovimientosItems" AllowColumnResize="true" AllowSorting="true" AllowFiltering="false"
                        SelectionMode="DataGridSelectionMode.Single" RowSelect="@SelectionGrid_Changed" Style="height:100%;">
                        <Columns>
                            <RadzenDataGridColumn Property="@nameof(ConsultaGral_ModificacionesABCResponse.Fecha)" Title="Fecha" TextAlign="TextAlign.Center" Width="180px" FormatString="{0:dd/MM/yyyy HH:mm}" />
                            <RadzenDataGridColumn Property="@nameof(ConsultaGral_ModificacionesABCResponse.Operador)" Title="Operador" TextAlign="TextAlign.Left" Width="220px" />
                            <RadzenDataGridColumn Property="@nameof(ConsultaGral_ModificacionesABCResponse.Maquina)" Title="Maquina" TextAlign="TextAlign.Left" Width="220px" />
                            <RadzenDataGridColumn Property="@nameof(ConsultaGral_ModificacionesABCResponse.Sucursal)" Title="Sucursal" TextAlign="TextAlign.Left" Width="220px" />
                        </Columns>
                    </RadzenDataGrid>
                </div>
            </div>

            <div class="p-1" style="grid-row: 2/3; grid-column: 2/3; align-items: center;">
                <RadzenDataGrid SelectionMode="DataGridSelectionMode.Single" @ref="@MyDataGrid2" TItem="ConsultaGral_ModificacionesABCResponse_Item" Data="@CamposModificados" AllowColumnResize="true" AllowSorting="true" AllowFiltering="false" Style="height:100%;">
                    <Columns>
                        <RadzenDataGridColumn Property="@nameof(ConsultaGral_ModificacionesABCResponse_Item.Campo)" Title="Campo" TextAlign="TextAlign.Left" Width="140px" />
                        <RadzenDataGridColumn Property="@nameof(ConsultaGral_ModificacionesABCResponse_Item.Valor_Ant)" Title="Valor Anterior" TextAlign="TextAlign.Left" Width="140px" />
                        <RadzenDataGridColumn Property="@nameof(ConsultaGral_ModificacionesABCResponse_Item.Valor_Act)" Title="Valor Actual" TextAlign="TextAlign.Left" Width="140px" />
                    </Columns>
                </RadzenDataGrid>
            </div>

            <div class="p-1" style="grid-row: 3 / 4; grid-column: 1 / 3; align-items: center;">
                <RadzenTextBox Placeholder="Observacion" ReadOnly="true" class="w-100 h-100" Value="@_observacionSeleccionada" />
            </div>
        </Content>
    </VentanaSecundaria>
}

@code
{
    [Parameter] public EventCallback CerrarModal { get; set; }
    [Parameter] public bool Show { get; set;}
    [Parameter] public ConsultaGralResponse DatosGenerales {get;set;}
    public string Titulo = "MODIFICACIONES ABC";

    RadzenDataGrid<ConsultaGral_ModificacionesABCResponse> MyDataGrid { get; set; }
    RadzenDataGrid<ConsultaGral_ModificacionesABCResponse_Item> MyDataGrid2 { get; set; }
    public List<ConsultaGral_ModificacionesABCResponse> MovimientosItems { get; set; }
    private ConsultaGral_ModificacionesABCResponse ModificacionSeleccionada { get; set; }
    private string _observacionSeleccionada = "";
    private List<ConsultaGral_ModificacionesABCResponse_Item> CamposModificados { get; set; }


    /******** FUNCIONES ********/
    public async Task Inicializar(List<ConsultaGral_ModificacionesABCResponse> items)
    {
        this.MovimientosItems = items;
        ProcesarDatos();
        await Task.Delay(100);
    }

    protected void ProcesarDatos()
    {
        ModificacionSeleccionada = null;
        CamposModificados = null;
        _observacionSeleccionada = "";
    }

    protected async Task Cerrar_Modal()
    {
        await CerrarModal.InvokeAsync("");
    }

    private void SelectionGrid_Changed(ConsultaGral_ModificacionesABCResponse selectedRow)
    {
        if (selectedRow != null)
        {
            ModificacionSeleccionada = selectedRow;
            _observacionSeleccionada = selectedRow.Observacion;
            CamposModificados = selectedRow.Detalle;
        }
        else
        {
            ProcesarDatos();
        }
    }
}
