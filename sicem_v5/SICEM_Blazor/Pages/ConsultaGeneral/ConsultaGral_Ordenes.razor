@code
{
    [Parameter] public EventCallback CerrarModal { get; set; }
    [Parameter] public bool Show { get; set;}
    [Parameter] public int? Id_Padron {get;set;}
    public string Titulo = "CONSULTA ORDENES DE TRABAJO ";
    RadzenDataGrid<ConsultaGral_Ordenesresponse> MyDataGrid { get; set; }
    private List<ConsultaGral_Ordenesresponse> _listaOrdenes;
    private ConsultaGral_Ordenesresponse _ordenSeleccionada = new ConsultaGral_Ordenesresponse();


    /******** FUNCIONES ********/
    public async Task Inicializar(List<ConsultaGral_Ordenesresponse> items)
    {
        _listaOrdenes = items;
        await Task.Delay(100);
    }

    private void SelectionGrid_Changed(ConsultaGral_Ordenesresponse selectedRow)
    {
        if (selectedRow != null)
        {
            _ordenSeleccionada = selectedRow;
        }
        else
        {
            _ordenSeleccionada = new ConsultaGral_Ordenesresponse();
        }
    }

    protected async Task Cerrar_Modal()
    {
        _listaOrdenes = null;
        _ordenSeleccionada = new ConsultaGral_Ordenesresponse();
        await CerrarModal.InvokeAsync("");
    }
}
