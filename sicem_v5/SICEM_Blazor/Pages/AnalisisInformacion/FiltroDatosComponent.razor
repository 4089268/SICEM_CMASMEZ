                    <RadzenStack Orientation="Orientation.Vertical" Gap="0.1rem">
                        <RadzenLabel Text="Tipo Calculo" Component="Id_TipoCalculo" />
                        <RadzenDropDown Name="Id_TipoCalculo" @bind-Value=@FiltroBusqueda.Id_TipoCalculo
