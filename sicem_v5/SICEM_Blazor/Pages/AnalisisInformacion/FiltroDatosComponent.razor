            @if(CatEstatus != null)
            {
                <div class="item">
                    <RadzenStack Orientation="Orientation.Vertical" Gap="0.1rem">
                        <RadzenLabel Text="Estatus" Component="Id_Estatus" />
                        <RadzenDropDown Name="Id_Estatus" @bind-Value=@FiltroBusqueda.Id_Estatus
                            Data=@CatEstatus
                            TextProperty="Value"
                            ValueProperty="Key"
                            Multiple=true AllowClear=true Placeholder="TODOS"
                            Style="width: 100%;" />
                    </RadzenStack>
                </div>
            }
            else
            {
                <div class="item">
                    <RadzenStack Orientation="Orientation.Vertical" Gap="0.1rem">
                        <RadzenLabel Text="Estatus" />
                        <RadzenTextBox Disabled="true" Placeholder="Cargando..." Style="width: 100%;" />
