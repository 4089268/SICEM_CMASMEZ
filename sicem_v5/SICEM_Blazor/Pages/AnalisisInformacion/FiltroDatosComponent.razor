                <NsRangeNumeric Format="n0" @bind-OpcionSeleccionado="@FiltroBusqueda.LPS_Opcion" @bind-Valor1="@FiltroBusqueda.LPS_Valor1" @bind-Valor2="@FiltroBusqueda.LPS_Valor2" />
