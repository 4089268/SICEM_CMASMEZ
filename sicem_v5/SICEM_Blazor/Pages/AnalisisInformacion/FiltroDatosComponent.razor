@using System.Collections
@using System.Data
@using System.IO
@using System.Linq
@using Microsoft.Extensions.Logging
@inject SicemService sicemService
@inject ILogger<FiltroDatosComponent> logger

<div class="d-flex flex-column align-items-start" style="height: 100%;">
    <div class="d-flex align-items-center w-100" style="padding: .5rem 1rem .25rem 1rem; ">
        <div class="ofi-title mb-0 mr-3">Oficinas:</div>
        @if(CatOficinas!=null)
        {
            <RadzenDropDown @bind-Value=@FiltroBusqueda.Id_Oficinas
                Data=@CatOficinas
                TextProperty="@nameof(IEnlace.Nombre)"
                ValueProperty="@nameof(IEnlace.Id)"
                Name="DropDownMultiple"
                Multiple=true AllowClear=true Placeholder="Seleccione almenos una oficina"
                Style="width: 100%; max-width: 400px;" />
        }
        else
        {
            <RadzenDropDown TValue="int" Disabled="true" Placeholder="Cargando oficinas...." Style="width: 100%; max-width: 400px; cursor: wait;" />
        }
    </div>
    <div class="d-flex align-items-center w-100" style="padding: .5rem 1rem .25rem 1rem; ">
        <div class="px-2 h5 py-auto">Seleccionar cuentas:</div>
        <InputFile OnChange="@LoadFiles" multiple accept=".xlsx, .xls" />
    </div>

    @******* Datos Generales *******@
