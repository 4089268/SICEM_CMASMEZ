            <div class="item">
                <RadzenStack Orientation="Orientation.Vertical" Gap="0.1rem">
                    <RadzenLabel Text="Consumo" Component="Consumo_Opcion" />
                    <NsRangeNumeric Format="n0" Name="Consumo_Opcion" @bind-OpcionSeleccionado="@FiltroBusqueda.Consumo_Opcion" @bind-Valor1="@FiltroBusqueda.Consumo_Valor1" @bind-Valor2="@FiltroBusqueda.Consumo_Valor2" />
                </RadzenStack>
