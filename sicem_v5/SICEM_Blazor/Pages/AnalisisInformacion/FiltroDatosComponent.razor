                    <RadzenLabel Text="Nombre Comercial" Component="NombreComercial" />
                    <RadzenTextBox @bind-Value=@FiltroBusqueda.NombreComercial Name="NombreComercial" Style="width: 100%;" />
                </RadzenStack>
            </div>

            <div class="item">
                <RadzenStack Orientation="Orientation.Vertical" Gap="0.1rem">
                    <RadzenLabel Text="Direccion" Component="Direccion" />
                    <RadzenTextBox @bind-Value=@FiltroBusqueda.Direccion Name="Direccion" Style="width: 100%;" />
                </RadzenStack>
            </div>

            <div class="item">
                <RadzenStack Orientation="Orientation.Vertical" Gap="0.1rem">
                    <RadzenLabel Text="Colonia" Component="Colonia" />
                    <RadzenTextBox @bind-Value=@FiltroBusqueda.Colonia Name="Colonia" Style="width: 100%;" />
                </RadzenStack>
            </div>

            <div class="item">
                <RadzenStack Orientation="Orientation.Vertical" Gap="0.1rem">
