            <div class="item">
                <RadzenStack Orientation="Orientation.Vertical" Gap="0.1rem">
                    <RadzenLabel Text="Tiene Ubicacion" Component="TieneUbicacion" />
                    <RadzenDropDown Name="TieneUbicacion" TValue="int" @bind-Value=@FiltroBusqueda.TieneUbicacion
                        Data=@_opcionesSiNo
                        TextProperty="Value"
                        ValueProperty="Key"
                        Style="width: 100%;" />
                </RadzenStack>
            </div>

            <div class="item">
                <RadzenStack Orientation="Orientation.Vertical" Gap="0.1rem">
                    <RadzenLabel Text="Telefono Registrado" Component="TelefonoRegistrado" />
                    <RadzenDropDown Name="TelefonoRegistrado" TValue="int" @bind-Value=@FiltroBusqueda.TelefonoRegistrado
