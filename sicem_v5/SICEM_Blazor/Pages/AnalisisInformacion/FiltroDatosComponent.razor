    @******* Acciones *******@
    <div class="d-flex mt-auto justify-content-center aling-items-center w-100">
        <RadzenButton Click="OnProcesar_Click" Text="Realizar Consulta" Icon="action_key" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Large" />
    </div>

</div>

<BusyIndicator Busy="cargando" ContentText="Cargando catalogos..." />

@code
{

    [Parameter]
    public EventCallback<AnalisysInfoFilter> ProcesarConsulta {get;set;}

    [Parameter]
    public List<IEnlace> CatOficinas {get;set;}

    [Parameter]
    public Dictionary<int, string> CatEstatus {get;set;}

    [Parameter]
    public Dictionary<int, string> CatTipoCalculo {get;set;}

    [Parameter]
    public Dictionary<int, string> CatSetvicios {get;set;}

    [Parameter]
    public Dictionary<int, string> CatTarifas {get;set;}

    [Parameter]
    public Dictionary<int, string> CatAnomalias {get;set;}

    [Parameter]
    public Dictionary<int, string> CatGiro {get;set;}

    [Parameter]
    public Dictionary<int, string> CatClaseUsuaro {get;set;}

    bool cargando {get;set;} = false;

    public AnalisysInfoFilter FiltroBusqueda {get;set;} = new AnalisysInfoFilter();

    // Opciones de los filtros Si/No (antes <select> con 0 = Cualquiera, 1 = Si, 2 = No)
    private static readonly Dictionary<int, string> _opcionesSiNo = new Dictionary<int, string>()
    {
        { 0, "Cualquiera" },
        { 1, "Si" },
        { 2, "No" }
    };

    private async Task OnProcesar_Click()
    {
        await ProcesarConsulta.InvokeAsync(this.FiltroBusqueda);
    }

    private async Task LoadFiles(InputFileChangeEventArgs e)
    {
        cargando = true;
        await Task.Delay(100);

        // * procesar archivo excel
        IBrowserFile browserFile = e.File;
        logger.LogInformation("Archivo seleccionado {fileName}", browserFile.Name);
        var _tmpPath = string.Format("{0}/tmp_{1}.{2}", System.IO.Path.GetTempPath(), Guid.NewGuid().ToString(), browserFile.Name.Split(".").Last());
        using (FileStream fs = new FileStream(_tmpPath, System.IO.FileMode.CreateNew))
        {
            using(var stream = browserFile.OpenReadStream())
            {
                await stream.CopyToAsync(fs);
            }
        }
        var procesarExcel = new ProcesarExcel();
        var _datos = procesarExcel.ToDataTableFirstCol(_tmpPath);

        // * obtener cuentas
        var _cuentas = new List<int>();
        foreach(DataRow row in _datos.Rows)
        {
            var _cuenta = ConvertUtils.ParseInteger(row[0].ToString());
            if(!_cuentas.Contains(_cuenta))
            {
                _cuentas.Add(_cuenta);
            }
        }

        this.logger.LogInformation("Total Cuentas: {cuentas}", _cuentas.Count);
        FiltroBusqueda.Cuentas = _cuentas;
        await Task.Delay(100);
        cargando = false;
    }

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            // Seleccionar la primera oficina solo si aún no hay ninguna (antes se agregaba en cada cambio de parámetros)
            if (FiltroBusqueda.Id_Oficinas.Count > 0)
            {
                return;
            }
            var oficina = this.CatOficinas.First();
            FiltroBusqueda.Id_Oficinas.Add(oficina.Id);
            await Task.Delay(100);
            this.StateHasChanged();
            await Task.Delay(100);
        }
        catch (Exception ex)
        {
            this.logger.LogError("Error no controlado", ex);
        }
    }

}