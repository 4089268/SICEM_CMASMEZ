                    <NsRangeNumeric Format="n0" Name="Subsistema_Opcion" @bind-OpcionSeleccionado="@FiltroBusqueda.Subsistema_Opcion" @bind-Valor1="@FiltroBusqueda.Subsistema_Valor1" @bind-Valor2="@FiltroBusqueda.Subsistema_Valor2" />
