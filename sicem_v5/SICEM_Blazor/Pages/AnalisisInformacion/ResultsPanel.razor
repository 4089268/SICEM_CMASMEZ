@using Microsoft.Extensions.Configuration
@inject IConfiguration Configuration
@inject IJSRuntime JSRuntime

<div class="p-2 d-flex align-items-center">
                
    <div class="button px-3 py-2 bg-success mr-4" @onclick="HandleExportDataClick" >
        <i class="fa fa-file-excel mr-2"></i>
        <span>Exportar Resultados</span>
    </div>

    <div class="button px-3 py-2 bg-success mr-4" @onclick="@(e => HandleShowMapClick(null))" >
        <i class="fa fa-map-marker mr-2"></i>
        <span>Mostrar Ubicaciones</span>
    </div>

    <div class="button px-3 py-2 bg-success mr-4" @onclick="@(e => HandleNotificationPanelClick(null))" >
        <i class="fa fa-whatsapp mr-2"></i>
        <span>Notificar Whatsapp</span>
    </div>

</div>

<div class="m-2 w-100 ns-small"  style="height: calc(100% - 106px)">
    <RadzenDataGrid @ref="DataGrid" TItem="CatPadron" Data="@DatosGrid" AllowGrouping="true" Groups="@_grupos" AllowColumnResize="true" AllowSorting="true"
        AllowPaging="true" PageSize="200" Density="Density.Compact" class="grid-sin-panel-grupos" Style="height:100%; width:100%;">
        <GroupHeaderTemplate Context="grupo">
            <div>OFICINA @grupo.Data.Key - @grupo.Data.Count.ToString("n0") cuentas</div>
        </GroupHeaderTemplate>
        <Columns>
            <RadzenDataGridColumn Title="" TextAlign="TextAlign.Center" Width="120px" Sortable="false" Filterable="false" Groupable="false">
                <Template Context="data">
                    <div class="d-flex px-2">
                        <button type="button" class="btn btn-primary btn-sm @(data.TieneUbicacion?"bg-success border-success":"bg-danger border-danger") mr-2" data-toggle="tooltip" data-placement="top" title="Mostrar Ubicacion" @onclick="@( e => HandleShowMapClick( data.Id_Padron ))" disabled="@(!data.TieneUbicacion)">
                            <i class="fa fa-map-marker" aria-hidden="true"></i>
                        </button>
                        <button type="button" class="btn btn-primary btn-sm @(data.TieneTelefono?"bg-success border-success":"bg-danger border-danger") mr-2" data-toggle="tooltip" data-placement="top" title="Notificar Whatsapp" @onclick="@( e => HandleNotificationPanelClick( data.Id_Padron ))"  disabled="@(!data.TieneTelefono)">
                            <i class="fa fa-phone" aria-hidden="true"></i>
                        </button>
                    </div>
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Property="@nameof(CatPadron.Oficina)" Title="Oficina" TextAlign="TextAlign.Left" Width="170px" />
            <RadzenDataGridColumn Property="@nameof(CatPadron.Id_Cuenta)" Title="Cuenta" TextAlign="TextAlign.Center" Width="140px" />
            <RadzenDataGridColumn Property="@nameof(CatPadron.RazonSocial)" Title="Razon Social" TextAlign="TextAlign.Left" Width="210px" />
            <RadzenDataGridColumn Property="@nameof(CatPadron.Estatus)" Title="Estatus" TextAlign="TextAlign.Center" Width="120px" />
            <RadzenDataGridColumn Property="@nameof(CatPadron.Poblacion)" Title="Poblacion" TextAlign="TextAlign.Center" Width="120px" />
            <RadzenDataGridColumn Property="@nameof(CatPadron.Calculo)" Title="Calculo" TextAlign="TextAlign.Left" Width="120px" />
            <RadzenDataGridColumn Property="@nameof(CatPadron.MesFacturado)" Title="Mes Facturado" TextAlign="TextAlign.Center" Width="120px" />
            <RadzenDataGridColumn Property="@nameof(CatPadron.Direccion)" Title="Direccion" TextAlign="TextAlign.Left" Width="120px" />
            <RadzenDataGridColumn Property="@nameof(CatPadron.Colonia)" Title="Colonia" TextAlign="TextAlign.Left" Width="120px" />
            <RadzenDataGridColumn Property="@nameof(CatPadron.Ciudad)" Title="Ciudad" TextAlign="TextAlign.Left" Width="120px" />
            <RadzenDataGridColumn Property="@nameof(CatPadron.Telefono1)" Title="Telefono 1" TextAlign="TextAlign.Left" Width="120px" />
            <RadzenDataGridColumn Property="@nameof(CatPadron.Ruta)" Title="Ruta" TextAlign="TextAlign.Left" Width="120px" />
            <RadzenDataGridColumn Property="@nameof(CatPadron.Sb)" Title="Subsistema" TextAlign="TextAlign.Left" Width="120px" />
            <RadzenDataGridColumn Property="@nameof(CatPadron.Sector)" Title="Sector" TextAlign="TextAlign.Left" Width="120px" />
            <RadzenDataGridColumn Property="@nameof(CatPadron.Manzana)" Title="Manzana" TextAlign="TextAlign.Left" Width="120px" />
            <RadzenDataGridColumn Property="@nameof(CatPadron.Lote)" Title="Lote" TextAlign="TextAlign.Left" Width="120px" />
            <RadzenDataGridColumn Property="@nameof(CatPadron.Toma)" Title="Toma" TextAlign="TextAlign.Left" Width="120px" />
            <RadzenDataGridColumn Property="@nameof(CatPadron.Localizacion)" Title="Localizacion" TextAlign="TextAlign.Left" Width="120px" />
            <RadzenDataGridColumn Property="@nameof(CatPadron.Giro)" Title="Giro" TextAlign="TextAlign.Left" Width="120px" />
            <RadzenDataGridColumn Property="@nameof(CatPadron.Estatus)" Title="Estatus" TextAlign="TextAlign.Left" Width="120px" />
            <RadzenDataGridColumn Property="@nameof(CatPadron.Mf)" Title="Mf" TextAlign="TextAlign.Left" Width="120px" />
            <RadzenDataGridColumn Property="@nameof(CatPadron.Af)" Title="Af" TextAlign="TextAlign.Left" Width="120px" />
            <RadzenDataGridColumn Property="@nameof(CatPadron.MesAdeudoAct)" Title="Meses Adeudo" TextAlign="TextAlign.Left" Width="120px" />
            <RadzenDataGridColumn Property="@nameof(CatPadron.Servicio)" Title="Servicio" TextAlign="TextAlign.Left" Width="120px" />
            <RadzenDataGridColumn Property="@nameof(CatPadron.Clase_Usuario)" Title="Clase Usuario" TextAlign="TextAlign.Center" Width="120px" />
            <RadzenDataGridColumn Property="@nameof(CatPadron.Tipo_Usuario)" Title="Tipo Usuario" TextAlign="TextAlign.Left" Width="120px" />
            <RadzenDataGridColumn Property="@nameof(CatPadron.Tarifa_Fija)" Title="Tarifa Fija" TextAlign="TextAlign.Left" Width="120px" />
            <RadzenDataGridColumn Property="@nameof(CatPadron.AnomaliaAct)" Title="Anomalia" TextAlign="TextAlign.Left" Width="120px" />
            <RadzenDataGridColumn Property="@nameof(CatPadron.LecturaAct)" Title="Lectura Actual" TextAlign="TextAlign.Left" Width="120px" />
            <RadzenDataGridColumn Property="@nameof(CatPadron.ConsumoAct)" Title="Consumo Actual" TextAlign="TextAlign.Left" Width="120px" />
            <RadzenDataGridColumn Property="@nameof(CatPadron.Calculo)" Title="Calculo" TextAlign="TextAlign.Left" Width="120px" />
            <RadzenDataGridColumn Property="@nameof(CatPadron.Calculo_Act)" Title="Calculo Act" TextAlign="TextAlign.Left" Width="120px" />
            <RadzenDataGridColumn Property="@nameof(CatPadron.Subtotal)" Title="Subtotal" TextAlign="TextAlign.Right" Width="140px" FormatString="{0:c2}" />
            <RadzenDataGridColumn Property="@nameof(CatPadron.Iva)" Title="Iva" TextAlign="TextAlign.Right" Width="140px" FormatString="{0:c2}" />
            <RadzenDataGridColumn Property="@nameof(CatPadron.Total)" Title="Total" TextAlign="TextAlign.Right" Width="140px" FormatString="{0:c2}" />
            <RadzenDataGridColumn Property="@nameof(CatPadron.EsMacromedidor)" Title="Es Macromedidor" TextAlign="TextAlign.Center" Width="80px">
                <Template Context="padron">
                    <RadzenCheckBox TValue="bool" Value="@padron.EsMacromedidor" Disabled="true" />
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Property="@nameof(CatPadron.EsDraef)" Title="Es DRAEF" TextAlign="TextAlign.Center" Width="80px">
                <Template Context="padron">
                    <RadzenCheckBox TValue="bool" Value="@padron.EsDraef" Disabled="true" />
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Property="@nameof(CatPadron.EsAltoconsumidor)" Title="Es Alto Consumidor" TextAlign="TextAlign.Center" Width="80px">
                <Template Context="padron">
                    <RadzenCheckBox TValue="bool" Value="@padron.EsAltoconsumidor" Disabled="true" />
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Property="@nameof(CatPadron.Id_Medidor)" Title="Medidor" TextAlign="TextAlign.Left" Width="120px" />
            <RadzenDataGridColumn Property="@nameof(CatPadron.Tipotoma)" Title="Tipo Toma" TextAlign="TextAlign.Left" Width="120px" />
            <RadzenDataGridColumn Property="@nameof(CatPadron.MesFacturado)" Title="Mes Facturado" TextAlign="TextAlign.Left" Width="120px" />
            <RadzenDataGridColumn Property="@nameof(CatPadron.FechaAlta)" Title="Fecha Alta" TextAlign="TextAlign.Left" Width="120px" />
            <RadzenDataGridColumn Property="@nameof(CatPadron.FechaLecturaAct)" Title="Fecha Lectura Ant" TextAlign="TextAlign.Left" Width="120px" />
            <RadzenDataGridColumn Property="@nameof(CatPadron.FechaFacturaAct)" Title="Fecha Lectura Act" TextAlign="TextAlign.Left" Width="120px" />
            <RadzenDataGridColumn Property="@nameof(CatPadron.FechaVencimiento)" Title="Fecha Vencimiento" TextAlign="TextAlign.Left" Width="120px" />
            <RadzenDataGridColumn Property="@nameof(CatPadron.Situacion)" Title="Situacion de Toma" TextAlign="TextAlign.Left" Width="120px" />
            <RadzenDataGridColumn Property="@nameof(CatPadron.DiasSinPago)" Title="Dias Sin Pago" TextAlign="TextAlign.Left" Width="120px" FormatString="{0:n0}" />
        </Columns>
    </RadzenDataGrid>
</div>


@code
{
    [Parameter]
    public List<CatPadron> DatosGrid {get;set;}

    [Parameter]
    public EventCallback<long?> ShowMap {get;set;}

    [Parameter]
    public EventCallback<long?> ShowNotificationPanel {get;set;}
    [Parameter]
    public EventCallback<bool> LoadingData {get;set;}
    public RadzenDataGrid<CatPadron> DataGrid {get;set;}

    private bool EnableGridPaging {get;set;}  = false;

    // Agrupación inicial por oficina (en Syncfusion: GridGroupSettings Columns="Oficina")
    private System.Collections.ObjectModel.ObservableCollection<GroupDescriptor> _grupos = new System.Collections.ObjectModel.ObservableCollection<GroupDescriptor>()
    {
        new GroupDescriptor() { Property = nameof(CatPadron.Oficina), Title = "Oficina" }
    };

    private async void HandleShowMapClick(long? id_padron) => await ShowMap.InvokeAsync(id_padron);
    private async void HandleNotificationPanelClick(long? id_padron) => await ShowNotificationPanel.InvokeAsync(id_padron);
    private async void HandleExportDataClick()
    {
        await LoadingData.InvokeAsync(true);
        
        var _tmpFolder = Configuration.GetValue<string>("TempFolder");
        var _exportador = new ExportarExcel<CatPadron>(DatosGrid, new Uri(_tmpFolder) );
        var _archivo = _exportador.GenerarExcel();

        if(!String.IsNullOrEmpty(_archivo))
        {
            var _endPointDownload = Configuration.GetSection("AppSettings").GetValue<string>("Direccion_Api");
            var _targetUrl = $"{_endPointDownload}/download/{_archivo}";
            await JSRuntime.InvokeVoidAsync("OpenNewTabUrl", _targetUrl);
        }
        
        await LoadingData.InvokeAsync(false);

    }

}