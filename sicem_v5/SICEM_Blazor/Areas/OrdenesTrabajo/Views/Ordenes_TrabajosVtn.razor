@using Sicem_Blazor.OrdenesTrabajos.Models

@inject IJSRuntime JSRuntime
@inject IMatToaster Toaster
@inject OrdenesService ordenesService

@if (Visible)
{
    <VentanaSecundaria Titulo="@Titulo" CerrarVentana="@CerrarModal" Filas="@(new double[]{ 50, 580 })" Columnas="@(new double[]{.85})">
        <Content>

            <div class="m-1 p-2 border rounded bg-white" style="grid-row: 1/2; grid-column: 1/2;">
                <div class="w-100 d-flex align-items-center">
                    @* TODO-EXPORT-RADZEN: exportación pendiente (ver docs/MIGRACION.md)
                    <MatButton Class="mr-2" Raised="true" Style="height:2.5rem;" OnClick="@GenerarExcel">Exportar Excel <i class="fa fa-file-excel-o ml-2" aria-hidden="true"></i> </MatButton>
                    *@
                </div>
            </div>

            <div class="m-1 p-2 border rounded bg-white" style="grid-row: 2/3; grid-column: 1/2;">
                <RadzenDataGrid TItem="Ordenes_Agrupado" @ref="DataGrid" Data="@datosGrid" AllowPaging="@_allowPagesGrid" AllowSorting="true" AllowColumnResize="true" AllowFiltering="false" PageSize="1000" Style="height:100%; width:100%;">
                    <Columns>
                        <RadzenDataGridColumn Title="" TextAlign="TextAlign.Center" Width="55px">
                            <Template>
                                @{
                                    var data = (context as Ordenes_Agrupado);
                                    <button type="button" class="btn btn-primary btn-sm" data-toggle="tooltip" data-placement="top" title="Ver Detalle" @onclick="@( e => MostrarDetalle(data))">
                                        <i class="fa fa-file-text-o" aria-hidden="true"></i>
                                    </button>
                                }
                            </Template>
                        </RadzenDataGridColumn>

                        <RadzenDataGridColumn Property="@nameof(Ordenes_Agrupado.Descripcion)" Title="Trabajo" TextAlign="TextAlign.Left" Width="260px" />
                        <RadzenDataGridColumn Property="@nameof(Ordenes_Agrupado.Pendientes)" Title="Pendientes" TextAlign="TextAlign.Center" Width="100px" />
                        <RadzenDataGridColumn Property="@nameof(Ordenes_Agrupado.En_Ejecucion)" Title="En Ejecucion" TextAlign="TextAlign.Center" Width="100px" />
                        <RadzenDataGridColumn Property="@nameof(Ordenes_Agrupado.Realizadas)" Title="Realizadas" TextAlign="TextAlign.Center" Width="100px" />
                        <RadzenDataGridColumn Property="@nameof(Ordenes_Agrupado.Canceladas)" Title="Canceladas" TextAlign="TextAlign.Center" Width="100px" />
                        <RadzenDataGridColumn Property="@nameof(Ordenes_Agrupado.Ejecutadas)" Title="Ejecutadas" TextAlign="TextAlign.Center" Width="100px" />
                        <RadzenDataGridColumn Property="@nameof(Ordenes_Agrupado.No_Ejecutadas)" Title="No Ejecutadas" TextAlign="TextAlign.Center" Width="100px" />
                        <RadzenDataGridColumn Property="@nameof(Ordenes_Agrupado.Total)" Title="Total" TextAlign="TextAlign.Center" Width="100px" />
                    </Columns>
                </RadzenDataGrid>
            </div>

        </Content>
    </VentanaSecundaria>
    
    <BusyIndicator Busy="@_busyDialog" ContentText="Cargando datos...." />
    <Ordenes_DetalleVtn @ref="_vtn_detalle" Visible="@vtn_detalle_visible" CerrarModal="@( e => this.vtn_detalle_visible = false)" Fecha1="@Fecha1" Fecha2="@Fecha2" Subsistema="@Subsistema" Sector="@Sector" Filtro_Trabajos="false" />

}

@code
{

    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback CerrarModal { get; set; }
    [Parameter] public DateTime Fecha1 { get; set; }
    [Parameter] public DateTime Fecha2 { get; set; }
    [Parameter] public int Subsistema { get; set; }
    [Parameter] public int Sector { get; set; }
    public string Titulo = "";
    public Ruta OficinaActual = null;

    private async Task Cerrar_Modal()
    {
        this.datosGrid.Clear();
        this._allowPagesGrid = false;
        await CerrarModal.InvokeAsync("");
    }


    //"******** Variables ********"
    RadzenDataGrid<Ordenes_Agrupado> DataGrid { get; set; }
    public List<Ordenes_Agrupado> datosGrid { get; set; } = new List<Ordenes_Agrupado>();
    bool _allowPagesGrid = false;
    bool _busyDialog = false, vtn_detalle_visible = false;
    Ordenes_DetalleVtn _vtn_detalle;


    // ******** Funciones Generales ********
    public async Task Inicializar(Ordenes_Agrupado[] _datos)
    {
        if(_datos.Length > 2000)
        {
            this._allowPagesGrid = true;
        }
        this.datosGrid = _datos.ToList();
        await Task.Delay(100);
    }
    private async Task MostrarDetalle(Ordenes_Agrupado data)
    {
        if(!vtn_detalle_visible)
        {
            this._busyDialog = true;
            await Task.Delay(100);

            var titulo = $"{OficinaActual.Oficina} / Ordenes {data.Descripcion} del {Fecha1.ToString("dd/MM/yyyy")} al {Fecha2.ToString("dd/MM/yyyy")}";
            
            // Obtener detalle ordenes
            var _xmlFiltro = OrdenesService.GenerarFiltro_Detalle(trabajo: data.Id);
            var datos = ordenesService.ObtenerOrdenesDetalle(OficinaActual, Fecha1.ToString("yyyyMMdd"), Fecha2.ToString("yyyyMMdd"), Subsistema, Sector, _xmlFiltro);
            
            // Obtener pagos de ordenes
            IEnumerable<Ordenes_PagoRealizadoItem> datosPagos = ordenesService.Ordenes_PagosRealizadosOrdenes(OficinaActual, Fecha1.ToString("yyyyMMdd"), Fecha2.ToString("yyyyMMdd"), id_trabajo: data.Id );
            foreach(var ordTrabajo in datos)
            {
                ordTrabajo.SetPagoRealizado(datosPagos.Where( pagoInfo => pagoInfo.Orden == ordTrabajo.Orden).FirstOrDefault() );
            }

            if(datos == null)
            {
                _busyDialog = false;
                Toaster.Add("No hay datos disponibles", MatToastType.Info, "Sin Datos", null);
                return;
            }
            if (datos.Length <= 0)
            {
                _busyDialog = false;
                Toaster.Add("No hay datos disponibles", MatToastType.Info, "Sin Datos", null);
                return;
            }
            vtn_detalle_visible = true;
            await _vtn_detalle.Inicializar(datos, titulo);

            await Task.Delay(100);
            this._busyDialog = false;
        }
    }
    // TODO-EXPORT-RADZEN: exportación pendiente (ver docs/MIGRACION.md). Código original de Syncfusion:
    /*
    private async Task GenerarExcel() {
        await this.DataGrid.ExcelExport(new ExcelExportProperties {
            FileName = string.Format("sicem_{0}.xlsx", Guid.NewGuid().ToString().Replace("-", ""))
        });
    }
    */

}