        border-radius: .8rem;
        margin-top: .6rem;
        margin-bottom: .4rem;
        height: 17rem;
        width: 15rem;
        background: white;
        justify-content: space-around;
        cursor: pointer;
        transition: margin .2s, background .2s;
    }

        .card-s:hover {
            border-radius: .8rem;
            margin-top: .4rem;
            background: #dfe5eb;
        }

        .card-s .c-label {
            font-size: 1.1rem;
            text-transform: uppercase;
