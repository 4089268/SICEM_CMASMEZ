@page "/Ordenes"
@namespace Sicem_Blazor.OrdenesTrabajos.Views
@using Sicem_Blazor.OrdenesTrabajos.Models
@using Sicem_Blazor.Areas.OrdenesTrabajo.Views

<div class="layout-page1">
    <div class="title-page" style="grid-area:1/1/2/2;">ORDENES DE TRABAJO</div>

    <div class="border rounded bg-white px-2 d-flex align-items-center justify-content-between" style="grid-area:2/1/3/2;">
        <SeleccionarFecha ProcesarParam="@Procesar" />
        
        <div>
            <MatNavItem Title="Vista alterna" Href="/ordenesoficina/1" Class="btn-primary rounded text-white">
                <MatIcon Icon="event_note"/>&nbsp;Vista Alterna
            </MatNavItem>
        </div>
    </div>

    @* ****** Acciones ****** *@
    <div class="border rounded bg-white p-2 d-flex align-items-center" style="grid-area:3/1/4/2;">
        <MatButton Class="mx-2" style="min-width: 130px;" Raised="true" @onclick="ExportarExcel_Click">Exportar Excel</MatButton>
        <MatButton Class="mx-2" style="min-width: 130px;" Raised="true" Disabled="true">Generar Reporte</MatButton>
    </div>

    @* ****** DataGrid ****** *@
    <div class="border rounded bg-white p-2 d-flex" style="grid-area:4/1/5/2;">
        <RadzenDataGrid TItem="OrdenesResumenOficina" SelectionMode="DataGridSelectionMode.Single" @ref="DataGrid" Data="@DatosGrid" AllowColumnResize="true" AllowSorting="true" AllowFiltering="false" Style="height:99%; width:100%;">
            <Columns>
                <RadzenDataGridColumn Width="40px">
                    <Template>
                        @{
                            var data = (context as OrdenesResumenOficina);
                            if (data.IdOficina > 0 && data.IdOficina < 999)
                            {
                                @switch (data.Estatus)
                                {
                                    case ResumenOficinaEstatus.Completado:
                                        <i class="fas fa-check-circle" style="color:green; font-size:1.5rem;"></i>
                                        break;

                                    case ResumenOficinaEstatus.Error:
                                        <i class="fas fa-exclamation-circle" style="color:red; font-size:1.5rem;"></i>
                                        break;

                                    default:
                                        <div class="spinner-border p-2" role="status"> </div>
                                        break;
                                }
                            }
                        }
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn Property="@nameof(OrdenesResumenOficina.Oficina)" Title="Oficina" TextAlign="TextAlign.Left" Width="140px" />
                <RadzenDataGridColumn Property="@nameof(OrdenesResumenOficina.Pendi)" Title="Ordenes Pendientes" TextAlign="TextAlign.Center" Width="125px" FormatString="{0:n0}" />
                <RadzenDataGridColumn Property="@nameof(OrdenesResumenOficina.Eneje)" Title="Ordenes en Ejecucion" TextAlign="TextAlign.Center" Width="125px" FormatString="{0:n0}" />
                <RadzenDataGridColumn Property="@nameof(OrdenesResumenOficina.Reali)" Title="Ordenes Realizadas" TextAlign="TextAlign.Center" Width="125px" FormatString="{0:n0}" />
                <RadzenDataGridColumn Property="@nameof(OrdenesResumenOficina.Cance)" Title="Ordenes Canceladas" TextAlign="TextAlign.Center" Width="125px" FormatString="{0:n0}" />
                <RadzenDataGridColumn Property="@nameof(OrdenesResumenOficina.Eje)" Title="Ordenes Ejecutadas" TextAlign="TextAlign.Center" Width="125px" FormatString="{0:n0}" />
                <RadzenDataGridColumn Property="@nameof(OrdenesResumenOficina.No_eje)" Title="Ordenes No Ejecutadas" TextAlign="TextAlign.Center" Width="125px" FormatString="{0:n0}" />
                <RadzenDataGridColumn Property="@nameof(OrdenesResumenOficina.Total)" Title="Total Ordenes" TextAlign="TextAlign.Center" Width="125px" FormatString="{0:n0}" />
                <RadzenDataGridColumn Title="Acciones" TextAlign="TextAlign.Left" Width="140px">
                    <Template>
                        @{
                            var data = (context as OrdenesResumenOficina);
                            if (data.IdOficina > 0 && data.IdOficina < 999)
                            {
                                <div class="d-flex p-1">
                                    <button type="button" class="btn btn-primary btn-sm mx-1" data-toggle="tooltip" data-placement="top" title="Ordenes por Colonia" disabled="@(data.Estatus != ResumenOficinaEstatus.Completado)" @onclick=@( e => Mostrar_Vtn_Colonias(data) )>
                                        <i class="fa fa-building" aria-hidden="true"></i>
                                    </button>
                                    <button type="button" class="btn btn-primary btn-sm mx-1" data-toggle="tooltip" data-placement="top" title="Ordenes por Trabajos" disabled="@(data.Estatus != ResumenOficinaEstatus.Completado)" @onclick=@( e => Mostrar_Vtn_Trabajos(data) )>
                                        <i class="fa fa-tag" aria-hidden="true"></i>
                                    </button>
                                    <button type="button" class="btn btn-primary btn-sm mx-1" data-toggle="tooltip" data-placement="top" title="Ordenes por Realizacion" disabled="@(data.Estatus != ResumenOficinaEstatus.Completado)" @onclick="( e => Mostrar_Vtn_Realizacion(data))">
                                        <i class="fa fa-clipboard-check" aria-hidden="true"></i>
                                    </button>
                                    <button type="button" class="btn btn-primary btn-sm mx-1" data-toggle="tooltip" data-placement="top" title="Ordenes por Captura" disabled="@(data.Estatus != ResumenOficinaEstatus.Completado)" @onclick="( e => Mostrar_Vtn_Capturacion(data))">
                                        <i class="fa fa-clipboard" aria-hidden="true"></i>
                                    </button>
                                </div>
                            }
                        }
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    </div>

    <!--- ****** Graficas ****** -->
    <div class="border rounded bg-white d-flex flex-column align-items-center p-1" style="grid-area:5/1/6/2;">
        <div class="text-center font-weight-bold">ORDENES DE TRABAJO</div>
        <RadzenChart @ref="GraficaUsuarios" Style="flex: 1; min-height: 0; width: 100%;">
            <RadzenCategoryAxis />
            <RadzenValueAxis Visible="false" FormatString="{0:n0}" />
            <RadzenChartTooltipOptions Shared="true" />
            <RadzenLegend Visible="true" Position="LegendPosition.Right" />
            <RadzenStackedBarSeries Data="@DatosGrafica" Title="Pendientes" CategoryProperty="Descripcion" ValueProperty="Valor1">
                <TooltipTemplate Context="item">
                    <b>Pendientes</b> : @item.Valor1
                </TooltipTemplate>
                <ChildContent>
                    <RadzenSeriesDataLabels Visible="true" />
                </ChildContent>
            </RadzenStackedBarSeries>
            <RadzenStackedBarSeries Data="@DatosGrafica" Title="En Ejecucion" CategoryProperty="Descripcion" ValueProperty="Valor2">
                <TooltipTemplate Context="item">
                    <b>En Ejecucion</b> : @item.Valor2
                </TooltipTemplate>
                <ChildContent>
                    <RadzenSeriesDataLabels Visible="true" />
                </ChildContent>
            </RadzenStackedBarSeries>
            <RadzenStackedBarSeries Data="@DatosGrafica" Title="Realizadas" CategoryProperty="Descripcion" ValueProperty="Valor3">
                <TooltipTemplate Context="item">
                    <b>Realizadas</b> : @item.Valor3
                </TooltipTemplate>
                <ChildContent>
                    <RadzenSeriesDataLabels Visible="true" />
                </ChildContent>
            </RadzenStackedBarSeries>
            <RadzenStackedBarSeries Data="@DatosGrafica" Title="Canceladas" CategoryProperty="Descripcion" ValueProperty="Valor4">
                <TooltipTemplate Context="item">
                    <b>Canceladas</b> : @item.Valor4
                </TooltipTemplate>
                <ChildContent>
                    <RadzenSeriesDataLabels Visible="true" />
                </ChildContent>
            </RadzenStackedBarSeries>
        </RadzenChart>
    </div>
</div>


<style type="text/css">
    .txt-usuarios {
        font-weight: bold;
        font-size: 1.2rem;
    }
</style>


@* ****** Dialogos y ventanas secundarias ****** *@
<Ordenes_DetalleVtn @ref="_vtn_detalle" Visible="@_vtn_detalle_visible" CerrarModal="@(()=> _vtn_detalle_visible = false)" Fecha1="@_f1" Fecha2="@_f2" Subsistema="@_subsistema" Sector="@_sector" Filtro_Estatus="false" />
<Ordenes_ColoniasVtn @ref="_vtn_colonias" Visible="@vtn_colonias_visible" CerrarModal="@(()=> vtn_colonias_visible = false)" Fecha1="@_f1" Fecha2="@_f2" Subsistema="@_subsistema" Sector="@_sector" />
<Ordenes_TrabajosVtn @ref="_vtn_trabajos" Visible="@vtn_trabajos_visible" CerrarModal="@(()=> vtn_trabajos_visible = false)" Fecha1="@_f1" Fecha2="@_f2" Subsistema="@_subsistema" Sector="@_sector" />
<Ordenes_RealizacionVtn @ref="_vtn_realizacion" Visible="@vtn_realizacion_visible" CerrarModal="@(()=> vtn_realizacion_visible = false)" Fecha1="@_f1" Fecha2="@_f2" Subsistema="@_subsistema" Sector="@_sector" />
<Ordenes_CapturacionVtn @ref="_vtn_capturacion" Visible="@vtn_capturacion_visible" CerrarModal="@(()=> vtn_capturacion_visible = false)" Fecha1="@_f1" Fecha2="@_f2" Subsistema="@_subsistema" Sector="@_sector" />

<BusyIndicator Busy="@_busyDialog" ContentText="Cargando datos...." />