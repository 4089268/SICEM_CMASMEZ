@using Sicem_Blazor.Facturacion.Models
@if(Visible)
{
    <VentanaSecundaria Titulo="@Titulo" Filas="@_filasTemplate" Columnas="@_columnasTemplate" CerrarVentana="@CerrarClick">
        <Content>
            <div class="d-flex align-items-center p-2 mb-2 border bg-white runded">
                @* TODO-EXPORT-RADZEN: exportación pendiente (ver docs/MIGRACION.md)
                <div class="button bg-success px-3 py-2" @onclick="OnExportExcel_Click" >
                    <i class="fa fa-file-excel mr-2"></i>
                    <span>Exportar Datos</span>
                </div>
                *@
            </div>

            <div class="p-2 border bg-white runded">
                <RadzenDataGrid TItem="Factura" @ref="DataGrid" Data="@DatosGrid" AllowColumnResize="true" AllowPaging="true" PageSize="1000" Style="width:100%; height:100%;">
                    <Columns>
                        @* <RadzenDataGridColumn Property="@nameof(Factura.IdFactura)" Title="Id Factura" TextAlign="TextAlign.Left" Width="170px" /> *@
                        <RadzenDataGridColumn Property="@nameof(Factura.IdCuenta)" Title="Cuenta" TextAlign="TextAlign.Center" Width="100px" />
                        <RadzenDataGridColumn Property="@nameof(Factura.AguaSb)" Title="Agua" TextAlign="TextAlign.Right" Width="80px" FormatString="{0:c2}" />
                        <RadzenDataGridColumn Property="@nameof(Factura.DrenajeSb)" Title="Drenaje" TextAlign="TextAlign.Right" Width="80px" FormatString="{0:c2}" />
                        <RadzenDataGridColumn Property="@nameof(Factura.SaneamientoSb)" Title="Saneamiento" TextAlign="TextAlign.Right" Width="80px" FormatString="{0:c2}" />
                        <RadzenDataGridColumn Property="@nameof(Factura.ActualizacionSb)" Title="Actualizacion" TextAlign="TextAlign.Right" Width="80px" FormatString="{0:c2}" />
                        <RadzenDataGridColumn Property="@nameof(Factura.OtrosSb)" Title="Otros" TextAlign="TextAlign.Right" Width="80px" FormatString="{0:c2}" />
                        <RadzenDataGridColumn Property="@nameof(Factura.Subtotal)" Title="Subtotal" TextAlign="TextAlign.Right" Width="80px" FormatString="{0:c2}" />
                        <RadzenDataGridColumn Property="@nameof(Factura.Iva)" Title="Iva" TextAlign="TextAlign.Right" Width="60px" FormatString="{0:c2}" />
                        <RadzenDataGridColumn Property="@nameof(Factura.Total)" Title="Total" TextAlign="TextAlign.Right" Width="100px" FormatString="{0:c2}" />
                        <RadzenDataGridColumn Property="@nameof(Factura.Sucursal)" Title="Sucursal" TextAlign="TextAlign.Center" Width="140px" />
                        <RadzenDataGridColumn Property="@nameof(Factura.Localidad)" Title="Localidad" TextAlign="TextAlign.Center" Width="140px" />
                        <RadzenDataGridColumn Property="@nameof(Factura.Subsistema)" Title="Subsistema" TextAlign="TextAlign.Center" Width="60px" />
                        <RadzenDataGridColumn Property="@nameof(Factura.Sector)" Title="Sector" TextAlign="TextAlign.Center" Width="60px" />
                        <RadzenDataGridColumn Property="@nameof(Factura.Estatus)" Title="Estatus" TextAlign="TextAlign.Center" Width="100px" />
                        <RadzenDataGridColumn Property="@nameof(Factura.Mf)" Title="Mf" TextAlign="TextAlign.Center" Width="60px" />
                        <RadzenDataGridColumn Property="@nameof(Factura.Af)" Title="Af" TextAlign="TextAlign.Center" Width="80px" />
                        <RadzenDataGridColumn Property="@nameof(Factura.Servicio)" Title="Servicio" TextAlign="TextAlign.Left" Width="180px" />
                        <RadzenDataGridColumn Property="@nameof(Factura.Tarifa)" Title="Tarifa" TextAlign="TextAlign.Left" Width="140px" />
                        <RadzenDataGridColumn Property="@nameof(Factura.Consumo)" Title="M3 Consumidos" TextAlign="TextAlign.Center" Width="100px" FormatString="{0:n0}" />
                        <RadzenDataGridColumn Property="@nameof(Factura.ConsumoFacturado)" Title="M3 Facturados" TextAlign="TextAlign.Center" Width="100px" FormatString="{0:n0}" />
                        <RadzenDataGridColumn Property="@nameof(Factura.TipoCalculado)" Title="Tipo Calculo" TextAlign="TextAlign.Center" Width="100px" />
                        
                        @* <RadzenDataGridColumn Property="@nameof(Factura.Genero)" Title="Genero" TextAlign="TextAlign.Left" Width="auto" />
                        <RadzenDataGridColumn Property="@nameof(Factura.Lecturista)" Title="Lecturista" TextAlign="TextAlign.Left" Width="auto" />
                        <RadzenDataGridColumn Property="@nameof(Factura.Capturo)" Title="Capturo" TextAlign="TextAlign.Left" Width="auto" />
                        <RadzenDataGridColumn Property="@nameof(Factura.Fecha)" Title="Fecha" TextAlign="TextAlign.Center" Width="auto" /> *@
                    </Columns>
                </RadzenDataGrid>
            </div>

        </Content>
    </VentanaSecundaria>
    <BusyIndicator Busy="@_isBusy" ContentText="Preparando documento..." />
}

@code
{
    [Parameter] public bool Visible {get;set;} = false;
    [Parameter] public string Titulo {get;set;} = "Lista Facturas";
    [Parameter] public EventCallback OnClose {get;set;}
    private RadzenDataGrid<Factura> DataGrid {get;set;}
    private List<Factura> DatosGrid {get;set;}
    private Ruta Oficina {get;set;}
    private bool _isBusy = false;

    private double[] _columnasTemplate = new double[]{.85};
    private double[] _filasTemplate = new double[]{50, .75};

    public void Inicializar(List<Factura> datos, Ruta oficina)
    {
        DatosGrid = datos;
        this.Oficina = oficina;
    }
    private async Task CerrarClick()
    {
        await this.OnClose.InvokeAsync(null);
    }
