@using Radzen
@using Radzen.Blazor
@using Sicem_Blazor.Eficiencia.Data
@using Sicem_Blazor.Eficiencia.Models
@inject IJSRuntime JSRuntime

@if (Visible)
{
    <div class="busy-control">

        <div id="draggable" class="SicemDialog-control" style="width:auto; height:auto;">

            @* *********** Cabecera *********** *@
            <div class="SicemDialog-header">
                <div>Eficiencia Por Conceptos</div>
                <MatIcon @onclick="@Cerrar_Modal" Class="close-icon" style="margin-left: auto;" Icon="clear"></MatIcon>
            </div>

            @* *********** Contenido *********** *@
            <div class="SicemDialog-content" style="@ObtnerDimensiones()">

                <div class="m-1 p-2 border rounded bg-white" style="grid-row: 1/2; grid-column: 1/2;">
                    <div class="w-100 d-flex align-items-center">
                        @* TODO-EXPORT-RADZEN: exportación pendiente (ver docs/MIGRACION.md)
                        <MatButton Class="ml-1 mr-2" Raised="true" Style="height:2.5rem;" OnClick="@GenerarExcel">Exportar Excel <i class="fa fa-file-excel-o ml-2" aria-hidden="true"></i> </MatButton>
                        *@
                        <MatButton Class="mr-2" Raised="true" Style="height:2.5rem;" Disabled="true">Generar Reporte <i class="fa fa-file-pdf-o ml-2" aria-hidden="true"></i></MatButton>
                    </div>
                </div>

                <div class="m-1 p-2 border rounded bg-white" style="grid-row: 2/3; grid-column: 1/2;">
                    <RadzenDataGrid TItem="Eficiencia_Conceptos" @ref="_dataGrid" Data="@datosGrid" AllowColumnResize="true" AllowSorting="true" AllowFiltering="false" Style="height:100%; width:auto;">
                        <Columns>
                            <RadzenDataGridColumn Property="@nameof(Eficiencia_Conceptos.Tipo_Usuario)" Title="Tipo_Usuario" TextAlign="TextAlign.Left" Width="120px" />
                            <RadzenDataGridColumn Property="@nameof(Eficiencia_Conceptos.Facturacion)" Title="Facturado" TextAlign="TextAlign.Right" Width="100px" FormatString="{0:c2}" />
                            <RadzenDataGridColumn Property="@nameof(Eficiencia_Conceptos.Cobrado)" Title="Cobrado" TextAlign="TextAlign.Right" Width="100px" FormatString="{0:c2}" />
                            <RadzenDataGridColumn Property="@nameof(Eficiencia_Conceptos.Por_Cob)" Title="% Cob." TextAlign="TextAlign.Center" Width="80px" />
                            <RadzenDataGridColumn Property="@nameof(Eficiencia_Conceptos.Descontado)" Title="Descontado" TextAlign="TextAlign.Right" Width="100px" FormatString="{0:c2}" />
                            <RadzenDataGridColumn Property="@nameof(Eficiencia_Conceptos.Por_Des)" Title="% Desc." TextAlign="TextAlign.Center" Width="80px" />
                            <RadzenDataGridColumn Property="@nameof(Eficiencia_Conceptos.Anticipado)" Title="Anticipado" TextAlign="TextAlign.Right" Width="100px" FormatString="{0:c2}" />
                            <RadzenDataGridColumn Property="@nameof(Eficiencia_Conceptos.Por_Ant)" Title="% Ant." TextAlign="TextAlign.Center" Width="80px" />
                            <RadzenDataGridColumn Property="@nameof(Eficiencia_Conceptos.Por_Efi)" Title="Eficiencia" TextAlign="TextAlign.Center" Width="90px" />

                            <RadzenDataGridColumn Property="@nameof(Eficiencia_Conceptos.Fac_Agua)" Title="Fac. Agua" TextAlign="TextAlign.Right" Width="100px" FormatString="{0:c2}" />
                            <RadzenDataGridColumn Property="@nameof(Eficiencia_Conceptos.Fac_Dren)" Title="Fac. Drenaje" TextAlign="TextAlign.Right" Width="100px" FormatString="{0:c2}" />
                            <RadzenDataGridColumn Property="@nameof(Eficiencia_Conceptos.Fac_Sane)" Title="Fac. Sanea." TextAlign="TextAlign.Right" Width="100px" FormatString="{0:c2}" />
                            <RadzenDataGridColumn Property="@nameof(Eficiencia_Conceptos.Cob_Agua)" Title="Cob. Agua" TextAlign="TextAlign.Right" Width="100px" FormatString="{0:c2}" />
                            <RadzenDataGridColumn Property="@nameof(Eficiencia_Conceptos.Cob_Dren)" Title="Cob. Drenaje" TextAlign="TextAlign.Right" Width="100px" FormatString="{0:c2}" />
                            <RadzenDataGridColumn Property="@nameof(Eficiencia_Conceptos.Cob_Sane)" Title="Cob. Sanea." TextAlign="TextAlign.Right" Width="100px" FormatString="{0:c2}" />
                            <RadzenDataGridColumn Property="@nameof(Eficiencia_Conceptos.Ant_Agua)" Title="Ant. Agua" TextAlign="TextAlign.Right" Width="100px" FormatString="{0:c2}" />
                            <RadzenDataGridColumn Property="@nameof(Eficiencia_Conceptos.Ant_Dren)" Title="Ant. Drenaje" TextAlign="TextAlign.Right" Width="100px" FormatString="{0:c2}" />
                            <RadzenDataGridColumn Property="@nameof(Eficiencia_Conceptos.Ant_Sane)" Title="Ant. Sanea." TextAlign="TextAlign.Right" Width="100px" FormatString="{0:c2}" />
                            <RadzenDataGridColumn Property="@nameof(Eficiencia_Conceptos.Des_Agua)" Title="Des. Agua" TextAlign="TextAlign.Right" Width="100px" FormatString="{0:c2}" />
                            <RadzenDataGridColumn Property="@nameof(Eficiencia_Conceptos.Des_Dren)" Title="Des. Drenaje" TextAlign="TextAlign.Right" Width="100px" FormatString="{0:c2}" />
                            <RadzenDataGridColumn Property="@nameof(Eficiencia_Conceptos.Des_Sane)" Title="Des. Sanea." TextAlign="TextAlign.Right" Width="100px" FormatString="{0:c2}" />
                        </Columns>
                    </RadzenDataGrid>
                </div>

                <div class="m-1 p-2 border rounded bg-white" style="grid-row: 3/4; grid-column: 1/2;">
                    <RadzenChart AllowZoom="true" @ref="_grafiaIngresos" Style="width:auto; height:280px;">
                        <RadzenCategoryAxis Visible="true" />
                        <RadzenValueAxis Visible="false" />
                        <RadzenChartTooltipOptions Shared="true" />
                        <RadzenLegend Visible="false" Position="LegendPosition.Right" />
                        <RadzenColumnSeries CategoryProperty="X" Data="@itemsGrafica" ValueProperty="Y1" Title="Eficiencia">
                            <TooltipTemplate Context="item">
                                Eficiencia @item.X : @item.Y1%
                            </TooltipTemplate>
                            <ChildContent>
                                <RadzenMarkers MarkerType="MarkerType.Circle" />
                            </ChildContent>
                        </RadzenColumnSeries>
                    </RadzenChart>
                </div>

            </div>
        </div>
    </div>

    <BusyIndicator Busy="@_busyDialog" ContentText="Cargando datos...." />
}

@code
{

    #region  "******** Parametros ********"
    [Parameter]
    public bool Visible { get; set; }

    [Parameter]
    public EventCallback CerrarModal { get; set; }
    [Parameter]
    public DateTime Fecha1 { get; set; }
    [Parameter]
    public DateTime Fecha2 { get; set; }
    [Parameter]
    public int Subsistema { get; set; }
    [Parameter]
    public int Sector { get; set; }

    List<int> _gridFilas = new List<int>() { 50, 240, 300 };
    List<int> _gridColumnas = new List<int>() { 1180 };
    #endregion
    #region "******** Funciones Base ********"
    private async Task Cerrar_Modal()
    {
        this.datosGrid = new Eficiencia_Conceptos[] { };
        await CerrarModal.InvokeAsync("");
    }
    private string ObtnerDimensiones()
    {
        var xB = new System.Text.StringBuilder();
        xB.Append("height: 100%; width:100%; ");
        xB.Append("display:grid; ");
        xB.Append("grid-template-rows: ");
        foreach (int FilaH in _gridFilas)
        {
            xB.Append(string.Format("{0}px ", FilaH));
        }
        xB.Append("; ");

        xB.Append("grid-template-columns: ");
        foreach (int ColW in _gridColumnas)
        {
            xB.Append(string.Format("{0}px ", ColW));
        }
        xB.Append("; ");

        return xB.ToString();
    }
    #endregion


    //"******** Variables ********"

    RadzenDataGrid<Eficiencia_Conceptos> _dataGrid;
    RadzenChart _grafiaIngresos;

    public Eficiencia_Conceptos[] datosGrid;
    public List<ChartData> itemsGrafica = new List<ChartData>();
    private bool _busyDialog = false;


    //"******** Funciones Generales ********"
    public async Task Inicializar(Eficiencia_Conceptos[] datos)
    {
        await JSRuntime.InvokeVoidAsync("ConfigurateDragg", null);
        this.datosGrid = datos;
        if (datosGrid.Length > 0)
        {
            ProcesarDatosGrafica();
        }
    }

    private void ProcesarDatosGrafica()
    {
        itemsGrafica = new List<ChartData>();
        foreach (Eficiencia_Conceptos xItem in this.datosGrid)
        {
            if( !xItem.Tipo_Usuario.Contains("TOTAL") )
            {
                itemsGrafica.Add(new ChartData()
                {
                    X = xItem.Tipo_Usuario,
                    Y1 = (decimal)xItem.Por_Efi
                });
            }
        }
    }
    // TODO-EXPORT-RADZEN: exportación pendiente (ver docs/MIGRACION.md). Código original de Syncfusion:
    /*
    private async Task GenerarExcel() {
        await this._dataGrid.ExcelExport(new ExcelExportProperties {
            FileName = string.Format("sicem_{0}.xlsx", Guid.NewGuid().ToString().Replace("-", ""))
        });
    }
    */

    public class ChartData
    {
        public string X;
        public decimal Y1;
        public decimal Y2;
    }

}