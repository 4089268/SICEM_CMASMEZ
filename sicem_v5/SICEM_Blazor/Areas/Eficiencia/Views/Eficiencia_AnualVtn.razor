@using Sicem_Blazor.Eficiencia.Data
@using Sicem_Blazor.Eficiencia.Models
@inject IJSRuntime JSRuntime
@inject RadzenDataGridExportacionExcelService ExportacionExcel

<VentanaSecundaria Titulo="@Titulo" Filas="@_gridFilas" Columnas="_gridColumnas" CerrarVentana="Cerrar_Modal">
    <Content>

        <div class="m-1 p-2 border rounded bg-white" style="grid-row: 1/2; grid-column: 1/2;">
            <div class="w-100 d-flex align-items-center">
                <MatButton Class="ml-1 mr-2" Raised="true" Style="height:2.5rem;" OnClick="@GenerarExcel">Exportar Excel <i class="fa fa-file-excel-o ml-2" aria-hidden="true"></i> </MatButton>
                <MatButton Class="mr-2" Raised="true" Style="height:2.5rem;" Disabled="true">Generar Reporte <i class="fa fa-file-pdf-o ml-2" aria-hidden="true"></i></MatButton>
            </div>
        </div>

        <div class="m-1 p-2 border rounded bg-white" style="grid-row: 2/3; grid-column: 1/2;">
            <RadzenDataGrid TItem="EficienciaResumen" @ref="_dataGrid" Data="@DatosGrid" AllowColumnResize="true" AllowSorting="true" AllowFiltering="false" Style="height:100%; width:auto;">
                <Columns>
                    <RadzenDataGridColumn Property="@nameof(EficienciaResumen.Oficina)" Title="Oficina" TextAlign="TextAlign.Left" Width="170px" Visible="false" />
                    <RadzenDataGridColumn Property="@nameof(EficienciaResumen.Mes)" Title="Mes" TextAlign="TextAlign.Left" Width="100px" />
                    <RadzenDataGridColumn Property="@nameof(EficienciaResumen.Facturado)" Title="Facturado" TextAlign="TextAlign.Right" Width="120px" FormatString="{0:c2}" />
                    <RadzenDataGridColumn Property="@nameof(EficienciaResumen.Refacturado)" Title="Refacturado" TextAlign="TextAlign.Right" Width="120px" FormatString="{0:c2}" />
                    <RadzenDataGridColumn Property="@nameof(EficienciaResumen.Anticipado)" Title="Anticipado" TextAlign="TextAlign.Right" Width="120px" FormatString="{0:c2}" />
                    <RadzenDataGridColumn Property="@nameof(EficienciaResumen.Descontado)" Title="Descontado" TextAlign="TextAlign.Right" Width="120px" FormatString="{0:c2}" />
                    <RadzenDataGridColumn Property="@nameof(EficienciaResumen.Cobrado)" Title="Cobrado" TextAlign="TextAlign.Right" Width="120px" FormatString="{0:c2}" />
                    <RadzenDataGridColumn Property="@nameof(EficienciaResumen.Porcentaje)" Title="Eficiencia" TextAlign="TextAlign.Center" Width="110px" FormatString="{0:n2}" />
                </Columns>
            </RadzenDataGrid>
        </div>

        <div class="m-1 p-2 border rounded bg-white" style="grid-row: 3/4; grid-column: 1/2;">
            <RadzenChart title="EFICIENCIA ANUAL" Style="width:100%; height:100%;">
                <RadzenCategoryAxis />
                <RadzenValueAxis Visible="false" FormatString="{0:n2}" />
                <RadzenChartTooltipOptions Shared="true" />
                <RadzenLegend Visible="false" Position="LegendPosition.Right" />
                <RadzenLineSeries Data="@itemsGrafica" Title="Eficiencia" CategoryProperty="Descripcion" ValueProperty="Valor1">
                    <TooltipTemplate Context="item">
                        <b>Eficiencia</b> : @item.Valor1
                    </TooltipTemplate>
                    <ChildContent>
                        <RadzenMarkers MarkerType="MarkerType.Circle" />
                        <RadzenSeriesDataLabels Visible="true" />
                    </ChildContent>
                </RadzenLineSeries>
            </RadzenChart>
        </div>

    </Content>
</VentanaSecundaria>


@code
{

    [Parameter] public EventCallback CerrarModal { get; set; }
    [Parameter] public DateTime Fecha1 { get; set; }
    [Parameter] public DateTime Fecha2 { get; set; }
    [Parameter] public int Subsistema { get; set; }
    [Parameter] public int Sector { get; set; }
    [Parameter] public IEnlace Enlace { get; set; }
    [Parameter] public List<EficienciaResumen> DatosGrid { get; set; }
    [Parameter] public String Titulo {get;set;} = "EFICIENCIA COMERCIAL ANUAL";
    
    
    private RadzenDataGrid<EficienciaResumen> _dataGrid;
    private List<double> _gridFilas = new List<double>() { 50, 460, 240 };
    private List<double> _gridColumnas = new List<double>() { .8 };
    public List<ChartItem> itemsGrafica = new List<ChartItem>();
    

    //"******** Funciones Generales ********"

    protected override void OnInitialized()
    {
        foreach(var item in DatosGrid)
        {
            itemsGrafica.Add(
                new ChartItem()
                {
                    Descripcion = item.Mes,
                    Valor1 = (decimal) item.Porcentaje
                }
            );
        }
    }

    private async Task GenerarExcel()
    {
        await ExportacionExcel.ExportarAsync(this._dataGrid, new ExcelExportProperties
        {
            IncludeHiddenColumn = true,
            FileName = string.Format("sicem_{0}.xlsx", Guid.NewGuid().ToString().Replace("-", ""))
        });
    }

    private async Task Cerrar_Modal()
    {
        await CerrarModal.InvokeAsync("");
    }

}