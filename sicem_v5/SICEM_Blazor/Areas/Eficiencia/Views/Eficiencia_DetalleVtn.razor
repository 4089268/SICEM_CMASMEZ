@using Sicem_Blazor.Eficiencia.Data
@using Sicem_Blazor.Eficiencia.Models
@inject IJSRuntime JSRuntime

@if (Visible)
{
    <div class="busy-control">

        <div id="draggable2" class="SicemDialog-control" style="width:auto; height:auto;">

            @* *********** Cabecera *********** *@
            <div class="SicemDialog-header">
                <div>DETALLE EFICIENCIA</div>
                <MatIcon @onclick="@Cerrar_Modal" Class="close-icon" style="margin-left: auto;" Icon="clear"></MatIcon>
            </div>

            @* *********** Contenido *********** *@
            <div class="SicemDialog-content" style="@ObtnerDimensiones()">

                <div class="m-1 p-2 border rounded bg-white" style="grid-row: 1/2; grid-column: 1/2;">
                    <div class="w-100 d-flex align-items-center">
                        @* TODO-EXPORT-RADZEN: exportación pendiente (ver docs/MIGRACION.md)
                        <MatButton Class="ml-1 mr-2" Raised="true" Style="height:2.5rem;" OnClick="@GenerarExcel">Exportar Excel <i class="fa fa-file-excel-o ml-2" aria-hidden="true"></i> </MatButton>
                        *@
                        <MatButton Class="mr-2" Raised="true" Style="height:2.5rem;" Disabled="true">Generar Reporte <i class="fa fa-file-pdf-o ml-2" aria-hidden="true"></i></MatButton>
                    </div>
                </div>

                <div class="m-1 p-2 border rounded bg-white" style="grid-row: 2/3; grid-column: 1/2;">
                    <RadzenDataGrid TItem="Eficiencia_Detalle" @ref="_dataGrid" Data="@datosGrid" AllowSorting="true" AllowColumnResize="true" AllowFiltering="false" Style="height:100%; width:auto;">
                        <Columns> 
                            <RadzenDataGridColumn Property="@nameof(Eficiencia_Detalle.Tipo_Usuario)" Title="Tipo Usuario" TextAlign="TextAlign.Left" Width="120px" />
                            <RadzenDataGridColumn Property="@nameof(Eficiencia_Detalle.Facturacion)" Title="Facturado" TextAlign="TextAlign.Right" Width="100px" FormatString="{0:c2}" />
                            <RadzenDataGridColumn Property="@nameof(Eficiencia_Detalle.Por_Fac)" Title="% Fact." TextAlign="TextAlign.Center" Width="80px" />
                            <RadzenDataGridColumn Property="@nameof(Eficiencia_Detalle.Cobrado)" Title="Cobrado" TextAlign="TextAlign.Right" Width="100px" FormatString="{0:c2}" />
                            <RadzenDataGridColumn Property="@nameof(Eficiencia_Detalle.Por_Cob)" Title="% Cobr." TextAlign="TextAlign.Center" Width="80px" />
                            <RadzenDataGridColumn Property="@nameof(Eficiencia_Detalle.Descontado)" Title="Descontado" TextAlign="TextAlign.Right" Width="100px" FormatString="{0:c2}" />
                            <RadzenDataGridColumn Property="@nameof(Eficiencia_Detalle.Por_Des)" Title="% Desc." TextAlign="TextAlign.Center" Width="80px" />
                            <RadzenDataGridColumn Property="@nameof(Eficiencia_Detalle.Anticipado)" Title="Anticipado" TextAlign="TextAlign.Right" Width="100px" FormatString="{0:c2}" />
                            <RadzenDataGridColumn Property="@nameof(Eficiencia_Detalle.Por_Ant)" Title="% Anti." TextAlign="TextAlign.Center" Width="80px" />
                            <RadzenDataGridColumn Property="@nameof(Eficiencia_Detalle.Por_Efi)" Title="Eficiencia" TextAlign="TextAlign.Center" Width="90px" />
                        </Columns>
                    </RadzenDataGrid>
                </div>

            </div>
        </div>

    </div>

}

@code
{

    #region  "******** Parametros ********"
    [Parameter]
    public bool Visible { get; set; }

    [Parameter]
    public EventCallback CerrarModal { get; set; }
    [Parameter]
    public DateTime Fecha1 { get; set; }
    [Parameter]
    public DateTime Fecha2 { get; set; }
    [Parameter]
    public int Subsistema { get; set; }
    [Parameter]
    public int Sector { get; set; }

    List<int> _gridFilas = new List<int>() { 50, 350};
    List<int> _gridColumnas = new List<int>() { 1020 };
    #endregion
    #region "******** Funciones Base ********"
    private async Task Cerrar_Modal()
    {
        this.datosGrid = new Eficiencia_Detalle[]{ };
        await CerrarModal.InvokeAsync("");
    }
    private string ObtnerDimensiones()
    {
        var xB = new System.Text.StringBuilder();
        xB.Append("height: 100%; width:100%; ");
        xB.Append("display:grid; ");
        xB.Append("grid-template-rows: ");
        foreach (int FilaH in _gridFilas)
        {
            xB.Append(string.Format("{0}px ", FilaH));
        }
        xB.Append("; ");

        xB.Append("grid-template-columns: ");
        foreach (int ColW in _gridColumnas)
        {
            xB.Append(string.Format("{0}px ", ColW));
        }
        xB.Append("; ");

        return xB.ToString();
    }
    #endregion


    //"******** Variables ********"

    RadzenDataGrid<Eficiencia_Detalle> _dataGrid;
    public Eficiencia_Detalle[] datosGrid;


    //"******** Funciones Generales ********"
    public async Task Inicializar(Eficiencia_Detalle[] datos)
    {
        await JSRuntime.InvokeVoidAsync("ConfigurateDragg2", "#draggable2");
        this.datosGrid = datos;
    }

