@using Sicem_Blazor.Recaudacion.Data
@using Sicem_Blazor.Recaudacion.Models
@inject NavigationManager NavManager
@inject SicemService sicemService
@inject IRecaudacionService recaudacionService
@inject IJSRuntime JSRuntime
@inject IMatToaster Toaster
@inject RadzenDataGridExportacionExcelService ExportacionExcel

    @if(Visible)
    {
    <VentanaSecundaria Titulo="@Titulo" CerrarVentana="@Cerrar_Modal" Filas="@_filasGrid" Columnas="@_columnasGrid">
        <Content>

            <div class="m-1 p-2 border rounded bg-white" style="grid-row: 1/2; grid-column: 1/2;">
                <div class="w-100 d-flex align-items-center">
                    <MatButton Class="mr-2" Raised="true" Style="height:2.4rem;" OnClick="@GenerarExcel">Exportar Excel <i class="fa fa-file-excel-o ml-2" aria-hidden="true"></i> </MatButton>
                </div>
            </div>

            <div class="m-1 p-2 border rounded bg-white" style="grid-row: 2/3; grid-column: 1/2;">
                <div class="w-100 h-100">
                    <RadzenDataGrid TItem="ConceptoTipoUsuario" SelectionMode="DataGridSelectionMode.Single" @ref="DataGrid" Data="@DatosGrid" AllowGrouping="true" Groups="@_grupos" class="grid-sin-panel-grupos" AllowSorting="false" AllowColumnResize="true" AllowFiltering="false" Density="Density.Compact" Style="height:100%; width:auto;">
                        <GroupHeaderTemplate Context="grupo">
                            @if (grupo.Data.Key?.ToString().Contains("--*--") == true)
                            {
                                <div class="pt-4 pb-3">TOTAL</div>
                            }
                            else
                            {
                                <div class="pt-4 pb-3">@grupo.Data.Key - @grupo.Data.Count.ToString("n0") Conceptos</div>
                            }
                        </GroupHeaderTemplate>
                        <Columns>
                            <RadzenDataGridColumn Property="@nameof(ConceptoTipoUsuario.TipoConcepto)" Title="Tipo Concepto" TextAlign="TextAlign.Left" Width="90px" />
                            <RadzenDataGridColumn Property="@nameof(ConceptoTipoUsuario.Descripcion)" Title="Concepto" TextAlign="TextAlign.Left" Width="220px" />

                            <RadzenDataGridColumn Property="@nameof(ConceptoTipoUsuario.DomesticoSubTot)" Title="Dom SubTotal" TextAlign="TextAlign.Right" Width="110px" FormatString="{0:c2}" />
                            <RadzenDataGridColumn Property="@nameof(ConceptoTipoUsuario.DomesticoIVA)" Title="Dom IVA" TextAlign="TextAlign.Right" Width="110px" FormatString="{0:c2}" />
                            <RadzenDataGridColumn Property="@nameof(ConceptoTipoUsuario.DomesticoTotal)" Title="Dom Total" TextAlign="TextAlign.Right" Width="110px" FormatString="{0:c2}" />
                            <RadzenDataGridColumn Property="@nameof(ConceptoTipoUsuario.DomesticoUsu)" Title="Dom Usrs" TextAlign="TextAlign.Center" Width="100px" FormatString="{0:n0}" />

                            <RadzenDataGridColumn Property="@nameof(ConceptoTipoUsuario.HoteleroSubTot)" Title="Hot SubTotal" TextAlign="TextAlign.Right" Width="110px" FormatString="{0:c2}" />
                            <RadzenDataGridColumn Property="@nameof(ConceptoTipoUsuario.HoteleroIVA)" Title="Hot IVA" TextAlign="TextAlign.Right" Width="110px" FormatString="{0:c2}" />
                            <RadzenDataGridColumn Property="@nameof(ConceptoTipoUsuario.HoteleroTotal)" Title="Hot Total" TextAlign="TextAlign.Right" Width="110px" FormatString="{0:c2}" />
                            <RadzenDataGridColumn Property="@nameof(ConceptoTipoUsuario.HoteleroUsu)" Title="Hot Usrs" TextAlign="TextAlign.Center" Width="100px" FormatString="{0:n0}" />

                            <RadzenDataGridColumn Property="@nameof(ConceptoTipoUsuario.ComercialSubTot)" Title="Com SubTotal" TextAlign="TextAlign.Right" Width="110px" FormatString="{0:c2}" />
                            <RadzenDataGridColumn Property="@nameof(ConceptoTipoUsuario.ComercialIVA)" Title="Com IVA" TextAlign="TextAlign.Right" Width="110px" FormatString="{0:c2}" />
                            <RadzenDataGridColumn Property="@nameof(ConceptoTipoUsuario.ComercialTotal)" Title="Com Total" TextAlign="TextAlign.Right" Width="110px" FormatString="{0:c2}" />
                            <RadzenDataGridColumn Property="@nameof(ConceptoTipoUsuario.ComercialUsu)" Title="Com Usrs" TextAlign="TextAlign.Center" Width="100px" FormatString="{0:n0}" />

                            <RadzenDataGridColumn Property="@nameof(ConceptoTipoUsuario.IndustrialSubTot)" Title="Ind SubTotal" TextAlign="TextAlign.Right" Width="110px" FormatString="{0:c2}" />
                            <RadzenDataGridColumn Property="@nameof(ConceptoTipoUsuario.IndustrialIVA)" Title="Ind IVA" TextAlign="TextAlign.Right" Width="110px" FormatString="{0:c2}" />
                            <RadzenDataGridColumn Property="@nameof(ConceptoTipoUsuario.IndustrialTotal)" Title="Ind Total" TextAlign="TextAlign.Right" Width="110px" FormatString="{0:c2}" />
                            <RadzenDataGridColumn Property="@nameof(ConceptoTipoUsuario.IndustrialUsu)" Title="Ind Usrs" TextAlign="TextAlign.Center" Width="100px" FormatString="{0:n0}" />

                            <RadzenDataGridColumn Property="@nameof(ConceptoTipoUsuario.GeneralSubTot)" Title="Serv SubTotal" TextAlign="TextAlign.Right" Width="110px" FormatString="{0:c2}" />
                            <RadzenDataGridColumn Property="@nameof(ConceptoTipoUsuario.GeneralIVA)" Title="Serv IVA" TextAlign="TextAlign.Right" Width="110px" FormatString="{0:c2}" />
                            <RadzenDataGridColumn Property="@nameof(ConceptoTipoUsuario.GeneralTotal)" Title="Serv Total" TextAlign="TextAlign.Right" Width="110px" FormatString="{0:c2}" />
                            <RadzenDataGridColumn Property="@nameof(ConceptoTipoUsuario.GeneralUsu)" Title="Serv Usrs" TextAlign="TextAlign.Center" Width="100px" FormatString="{0:n0}" />

                            <RadzenDataGridColumn Property="@nameof(ConceptoTipoUsuario.Subtotal)" Title="Subtotal" TextAlign="TextAlign.Right" Width="110px" FormatString="{0:c2}" />
                            <RadzenDataGridColumn Property="@nameof(ConceptoTipoUsuario.IVA)" Title="IVA" TextAlign="TextAlign.Right" Width="110px" FormatString="{0:c2}" />
                            <RadzenDataGridColumn Property="@nameof(ConceptoTipoUsuario.Total)" Title="Total" TextAlign="TextAlign.Right" Width="90px" FormatString="{0:c2}" />
                            
                            <RadzenDataGridColumn Property="@nameof(ConceptoTipoUsuario.Usuarios)" Title="Usuarios" TextAlign="TextAlign.Center" Width="110px" FormatString="{0:n0}" />
                            
                        </Columns>
                    </RadzenDataGrid>
                </div>
            </div>

        </Content>
    </VentanaSecundaria>
    }

    <BusyIndicator Busy="@_busyDialog" ContentText="Cargando datos...." />

@code
{

    [Parameter] public EventCallback CerrarModal { get; set; }
    [Parameter] public DateTime Fecha1 { get; set; }
    [Parameter] public DateTime Fecha2 { get; set; }
    [Parameter] public int Subsistema { get; set; }
    [Parameter] public int Sector { get; set; }
    [Parameter] public bool Visible {get;set;} = false;
    public IEnlace Enlace { get; set; }
    public string Titulo {get;set;} = "RECAUDACION POR CONCEPTOS Y TIPOS DE USUARIO";
    
    private RadzenDataGrid<ConceptoTipoUsuario> DataGrid {get;set;}

    // Agrupación inicial por tipo de concepto (en Syncfusion: GridGroupSettings Columns="TipoConcepto")
    private System.Collections.ObjectModel.ObservableCollection<GroupDescriptor> _grupos = new System.Collections.ObjectModel.ObservableCollection<GroupDescriptor>()
    {
        new GroupDescriptor() { Property = nameof(ConceptoTipoUsuario.TipoConcepto), Title = "Tipo Concepto" }
    };

    private List<ConceptoTipoUsuario> DatosGrid { get; set; }
    
    private double[] _filasGrid = new double[]{ 50, .8};
    private double[] _columnasGrid = new double[]{.85};


    private bool _busyDialog = false;
    

    //******** Funciones Generales ********
    public void Inicializar(IEnlace enlace, IEnumerable<ConceptoTipoUsuario> datos)
    {
        this.Enlace = enlace;
        this.Titulo = $"{Enlace.Nombre} - RECAUDACION POR CONCEPTOS Y TIPOS DE USUARIO DEL {this.Fecha1.ToString("dd/MM/yyyy")} AL {this.Fecha2.ToString("dd/MM/yyyy")} ";
        this.DatosGrid = datos.OrderBy(item => item.Id_Tipo).OrderBy(item => item.EsRezago).OrderBy(item => item.Id_Concepto).ToList();
    }
    private async Task Cerrar_Modal()
    {
        this.DatosGrid.Clear();
        await CerrarModal.InvokeAsync("");
    }
    private async Task GenerarExcel()
    {
        await ExportacionExcel.ExportarAsync(this.DataGrid, new ExcelExportProperties
        {
            IncludeHiddenColumn = true,
            FileName = string.Format("sicem_ingresosPorConceptosyUsuarios_{0}.xlsx", Guid.NewGuid().ToString().Replace("-", ""))
        });
    }

}