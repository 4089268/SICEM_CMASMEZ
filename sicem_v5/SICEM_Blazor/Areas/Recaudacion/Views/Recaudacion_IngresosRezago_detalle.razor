@using Radzen
@using Radzen.Blazor
@using Sicem_Blazor.Recaudacion.Data
@using Sicem_Blazor.Recaudacion.Models
@inject IJSRuntime JSRuntime
@inject NavigationManager NavManager

@if (MostrarVentana)
{

    <VentanaSecundaria Titulo="@Titulo" Filas="@_filasTemplate" Columnas="@_columnasTemplate" CerrarVentana="@(e => Cerrar_Modal())">
        <Content>

            <div class="m-1 p-2 border rounded bg-white" style="grid-row: 1/2; grid-column: 1/2;">
                <div class="w-100 d-flex align-items-center">
                    @* TODO-EXPORT-RADZEN: exportación pendiente (ver docs/MIGRACION.md)
                    <MatButton Class="mr-2" Raised="true" Style="height:2.5rem;" OnClick="@GenerarExcel">Exportar Excel <i class="fa fa-file-excel-o ml-2" aria-hidden="true"></i> </MatButton>
                    *@
                    <MatButton Class="mr-2" Raised="true" Style="height:2.5rem;" Disabled="true">Generar Reporte <i class="fa fa-file-pdf-o ml-2" aria-hidden="true"></i></MatButton>
                </div>
            </div>

            <div class="m-1 p-2 border rounded bg-white" style="grid-row: 2/3; grid-column: 1/2;">
                <RadzenDataGrid TItem="Recaudacion_Rezago_Detalle" @ref="_dataGrid" Data="@Datos" AllowSorting="true" AllowColumnResize="true" AllowFiltering="false" AllowPaging="@(Datos.Count() > 1500)" PageSize="1000" Style="height:100%; width:auto;">
                    <Columns>
                            <RadzenDataGridColumn Title="" TextAlign="TextAlign.Center" Width="55px">
                                <Template>
                                    @{
                                        var data = (context as Recaudacion_Rezago_Detalle);
                                        <button type="button" class="btn btn-primary btn-sm" data-toggle="tooltip" data-placement="top" title="Mostrar en Consulta General" @onclick="@( e => MostrarDatosGenerales_Click(data))" disabled="@(data.Cuenta.Length <= 0 || data.Cuenta == "0" )">
                                            <i class="fa fa-address-book-o" aria-hidden="true"></i>
                                        </button>
                                    }
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn Property="@nameof(Recaudacion_Rezago_Detalle.Cuenta)" Title="Cuenta" TextAlign="TextAlign.Center" Width="110px" />
                            <RadzenDataGridColumn Property="@nameof(Recaudacion_Rezago_Detalle.Usuario)" Title="Usuario" TextAlign="TextAlign.Left" Width="220px" />
                            <RadzenDataGridColumn Property="@nameof(Recaudacion_Rezago_Detalle.Tarifa)" Title="Tarifa" TextAlign="TextAlign.Left" Width="120px" />
                            <RadzenDataGridColumn Property="@nameof(Recaudacion_Rezago_Detalle.Meses_Adeudo)" Title="Meses Adeudo" TextAlign="TextAlign.Center" Width="110px" FormatString="{0:n0}" />
                            <RadzenDataGridColumn Property="@nameof(Recaudacion_Rezago_Detalle.Agua)" Title="Agua" TextAlign="TextAlign.Center" Width="120px" FormatString="{0:c2}" />
                            <RadzenDataGridColumn Property="@nameof(Recaudacion_Rezago_Detalle.Dren)" Title="Drenaje" TextAlign="TextAlign.Right" Width="120px" FormatString="{0:c2}" />
                            <RadzenDataGridColumn Property="@nameof(Recaudacion_Rezago_Detalle.Trat)" Title="Sanea" TextAlign="TextAlign.Right" Width="120px" FormatString="{0:c2}" />
                            <RadzenDataGridColumn Property="@nameof(Recaudacion_Rezago_Detalle.Otros)" Title="Otros" TextAlign="TextAlign.Right" Width="120px" FormatString="{0:c2}" />
                            <RadzenDataGridColumn Property="@nameof(Recaudacion_Rezago_Detalle.Recar)" Title="Recargos" TextAlign="TextAlign.Right" Width="120px" FormatString="{0:c2}" />
                            <RadzenDataGridColumn Property="@nameof(Recaudacion_Rezago_Detalle.Subtotal)" Title="Subtotal" TextAlign="TextAlign.Right" Width="140px" FormatString="{0:c2}" />
                            <RadzenDataGridColumn Property="@nameof(Recaudacion_Rezago_Detalle.Iva)" Title="Iva" TextAlign="TextAlign.Right" Width="140px" FormatString="{0:c2}" />
                            <RadzenDataGridColumn Property="@nameof(Recaudacion_Rezago_Detalle.Total)" Title="Total" TextAlign="TextAlign.Right" Width="140px" FormatString="{0:c2}" />
                        </Columns>
                </RadzenDataGrid>
            </div>

        </Content>
    </VentanaSecundaria>

    @if(_datosGeneralesVisible)
    {
        <DatosGenerales_Dialog Cuenta="@_cuentaSeleccionada" IdOficina="@Enlace.Id" CerrarVentana="@(e => _datosGeneralesVisible = false)" />
    }

}

@code
{

    [Parameter] public bool MostrarVentana { get; set; }
    [Parameter] public EventCallback CerrarModal { get; set; }
    public IEnlace Enlace {get;set;}
    public string Titulo{get;set;} = "";

    private double[] _filasTemplate = new double[]{ 47, .8 };
    private double[] _columnasTemplate = new double[] { .85 };
    private RadzenDataGrid<Recaudacion_Rezago_Detalle> _dataGrid;
    private List<Recaudacion_Rezago_Detalle> Datos{get;set;}

    private bool _datosGeneralesVisible = false;
    private string _cuentaSeleccionada = "0";

    public void Inicializar(IEnlace e, IEnumerable<Recaudacion_Rezago_Detalle> datos, int Mes)
    {
        this.Titulo = $"DETALLE REZAGO CON {Mes} MESES DE ADEUDO";
        this.Enlace = e;
        this.Datos = datos.ToList();
    }
    private async Task Cerrar_Modal()
    {
        if(Datos != null)
        {
            Datos.Clear();
        }
        this.Titulo = "DETALLE REZAGO";
        await CerrarModal.InvokeAsync("");
    }
    // TODO-EXPORT-RADZEN: exportación pendiente (ver docs/MIGRACION.md). Código original de Syncfusion:
    /*
    private async Task GenerarExcel() {
        await this._dataGrid.ExcelExport(new ExcelExportProperties {
            FileName = string.Format("sicem_ingresosDetalle_{0}.xlsx", Guid.NewGuid().ToString().Replace("-", ""))
        });
    }
    */
    private void MostrarDatosGenerales_Click(Recaudacion_Rezago_Detalle e)
    {
        this._cuentaSeleccionada = e.Cuenta;
        this._datosGeneralesVisible = true;
    }

}