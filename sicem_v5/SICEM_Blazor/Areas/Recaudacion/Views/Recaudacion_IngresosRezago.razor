@using Sicem_Blazor.Recaudacion.Data
@using Sicem_Blazor.Recaudacion.Models
@inject IJSRuntime JSRuntime
@inject IMatToaster Toaster
@inject IRecaudacionService recaudacionService

@if (MostrarVentana)
{
    <VentanaSecundaria Titulo="@Titulo" CerrarVentana="@Cerrar_Modal" Filas="@(new double[]{50, 620})" Columnas="@(new double[]{.80})" >
        <Content>
            <div class="m-1 p-2 border rounded bg-white" style="grid-row: 1/2; grid-column: 1/2;">
                <div class="w-100 d-flex align-items-center">
                    @* TODO-EXPORT-RADZEN: exportación pendiente (ver docs/MIGRACION.md)
                    <MatButton Class="ml-1 mr-2" Raised="true" Style="height:2.5rem;" OnClick="@GenerarExcel">Exportar Excel <i class="fa fa-file-excel-o ml-2" aria-hidden="true"></i> </MatButton>
                    *@
                </div>
            </div>

            <div class="m-1 p-2 border rounded bg-white" style="grid-row: 2/3; grid-column: 1/2;">
                <RadzenDataGrid TItem="Recaudacion_Rezago" @ref="DataGrid" Data="@IngresosRezago" AllowColumnResize="true" AllowSorting="true" AllowFiltering="false" Density="Density.Compact" Style="height:100%; width:100%;">
                    <Columns>
                        <RadzenDataGridColumn Title="" TextAlign="TextAlign.Center" Width="55px" Visible="false">
                            <Template>
                                @{
                                    var data = (context as Recaudacion_Rezago);
                                    @if (!data.Mes.Contains("TOTAL"))
                                    {
                                        <button type="button" class="btn btn-primary btn-sm" data-toggle="tooltip" data-placement="top" title="Ver detalle" @onclick="@( e => MostrarVentanaDetalle(data))">
                                            <i class="fa fa-th" aria-hidden="true"></i>
                                        </button>
                                    }
                                }
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn Property="@nameof(Recaudacion_Rezago.Mes)" Title="Mes" TextAlign="TextAlign.Center" Width="80px" FormatString="{0:n0}" />
                        <RadzenDataGridColumn Property="@nameof(Recaudacion_Rezago.Usuarios)" Title="Usuarios" TextAlign="TextAlign.Center" Width="90px" FormatString="{0:n0}" />
                        <RadzenDataGridColumn Property="@nameof(Recaudacion_Rezago.Rez_agua)" Title="Rez. Agua" TextAlign="TextAlign.Right" Width="130px" FormatString="{0:c2}" />
                        <RadzenDataGridColumn Property="@nameof(Recaudacion_Rezago.Rez_dren)" Title="Rez. Drenaje" TextAlign="TextAlign.Right" Width="130px" FormatString="{0:c2}" />
                        <RadzenDataGridColumn Property="@nameof(Recaudacion_Rezago.Rez_sane)" Title="Rez. Saneamiento" TextAlign="TextAlign.Right" Width="130px" FormatString="{0:c2}" />
                        <RadzenDataGridColumn Property="@nameof(Recaudacion_Rezago.Rez_otros)" Title="Rez. Otros" TextAlign="TextAlign.Right" Width="130px" FormatString="{0:c2}" />
                        <RadzenDataGridColumn Property="@nameof(Recaudacion_Rezago.Rez_recargos)" Title="Recargos" TextAlign="TextAlign.Right" Width="130px" FormatString="{0:c2}" />
                        <RadzenDataGridColumn Property="@nameof(Recaudacion_Rezago.Subtotal)" Title="Sub Total" TextAlign="TextAlign.Right" Width="130px" FormatString="{0:c2}" />
                        <RadzenDataGridColumn Property="@nameof(Recaudacion_Rezago.Iva)" Title="I.V.A." TextAlign="TextAlign.Right" Width="130px" FormatString="{0:c2}" />
                        <RadzenDataGridColumn Property="@nameof(Recaudacion_Rezago.Total)" Title="TOTAL" TextAlign="TextAlign.Right" Width="130px" FormatString="{0:c2}" />

                    </Columns>
                </RadzenDataGrid>
            </div>

        </Content>
    </VentanaSecundaria>
     
    <BusyIndicator Busy="@_busyDialog" ContentText="Cargando datos...." />
    <Recaudacion_IngresosRezago_detalle @ref="_vtn_detalle" MostrarVentana="@_mostrarDetalle" CerrarModal="@(x => _mostrarDetalle = false)" />
}

