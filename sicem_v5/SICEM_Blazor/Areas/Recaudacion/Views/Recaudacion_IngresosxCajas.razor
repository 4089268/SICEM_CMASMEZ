                        Facturado = Item.Facturado,
                        Cobrado = Item.Cobrado,
                        Recibos = Item.Recibos
                    });
                }
            }
            this.IngresosCajas_filtrados = tmpList;
        }
        */
    }

    private async Task VerDetalle(Recaudacion_IngresosCajas context)
    {
        if (ventanaDetalleVisible)
        {
            return;
        }

        this.busyDialog = true;
        await Task.Delay(200);

        var _caja = context.Caja.Replace(context.CveCaja, "").Trim();
        var dateRange = new DateRange(this.Fecha1, this.Fecha2, this.Subsistema, this.Sector);
        var tmpData = recaudacionService.ObtenerDetalleIngresos(Enlace, dateRange)
            .Where(item => item.Caja.Equals(_caja, StringComparison.CurrentCultureIgnoreCase))
            .ToArray();
        
        if (tmpData.Count() > 0)
        {
            this.ventanaDetalleVisible = true;
            vtnDetalle.Inicializar(Enlace, tmpData, this.Fecha1);
        }

        await Task.Delay(200);
        busyDialog = false;

        await Task.CompletedTask;
    }

}