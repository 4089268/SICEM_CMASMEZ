    //****** Funciones Generales *******
    public void Inicializar(IEnlace enlace, IEnumerable<Recaudacion_IngresosDias> datos)
    {
        this.Enlace = enlace;
        if(datos.Count() > 1)
        {
            this.DatosIngresos = datos
                .Append(new Recaudacion_IngresosDias
                {
                    Fecha112 = " TOTAL",
                    Fecha_Letras = " TOTAL",
                    Usuarios_Propios = datos.Sum(d=>d.Usuarios_Propios),
                    Usuarios_Otros = datos.Sum(d=>d.Usuarios_Otros),
                    Usuarios_Total = datos.Sum(d=>d.Usuarios_Total),
                    Ingresos_Propios = datos.Sum(d=>d.Ingresos_Propios),
                    Ingresos_Otros = datos.Sum(d=>d.Ingresos_Otros),
                    Importe_Total = datos.Sum(d=>d.Importe_Total),
                    Cobrado = datos.Sum(d=>d.Cobrado)
                })
                .ToList();
        }
        else
        {
            this.DatosIngresos = datos.ToList();
        }
    }
    private async Task Cerrar_Modal()
    {
        if(DatosIngresos != null)
        {
            DatosIngresos.Clear();
        }
        await CerrarModal.InvokeAsync("");
    }
