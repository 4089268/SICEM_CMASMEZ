    */
    private async Task MostrarVentanaDetalle(DescuentosUsuarioAutorizo e)
    {
        if (vtn_autorizoDet_visible)
        {
            return;
        }

        _busyDialog = true;
        await Task.Delay(100);
        var dateRange = new Sicem_Blazor.Data.DateRange(Fecha1, Fecha2);
        var tmpData = descuentosService.ObtenerDetalleDescuentosPorUsuarioAutorizo(_enlaceSeleccionado, dateRange, e.CVE);
        if (tmpData == null)
        {
            _busyDialog = false;
            return;
        }
        if (tmpData.Count() <= 0)
        {
            _busyDialog = false;
            return;
        }

        vtn_autorizoDet_visible = true;
        _vtn_autorizoDet.Titulo = $"DESCUENTOS REALIZADOS POR {e.Autorizo.ToUpper()}";
        _vtn_autorizoDet.Inicializar(_enlaceSeleccionado, tmpData);

        await Task.Delay(100);
        _busyDialog = false;
    }

}