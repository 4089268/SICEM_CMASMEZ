@using Sicem_Blazor.Padron.Models
@inject IJSRuntime JSRuntime
@inject PadronService padronService
@inject NavigationManager NavManager
@inject ExportacionExcelService ExportacionExcel

@if (Visible)
{

    <VentanaSecundaria Titulo="@Titulo" CerrarVentana="@CerrarModal" Filas="@(new double[]{ 50, 670 })" Columnas="@(new double[]{.85})">
        <Content>

            <!-- ****** Filtro y Exportar ****** -->
            <div class="d-flex align-items-center m-1 p-2 border rounded bg-white">
                <MatButton Raised="true" Style="height:2.5rem;" OnClick="@GenerarExcel">Exportar Excel <i class="fa fa-file-excel-o ml-2" aria-hidden="true"></i> </MatButton>
            </div>

            <!-- ****** DataGrid ****** -->
            <div class="m-1 p-2 border rounded bg-white">
                <RadzenDataGrid TItem="PadronColonia" @ref="DataGrid" Data="@DatosGrid" AllowSorting="true" AllowColumnResize="true" Style="height:100%; width:100%;">
                    <Columns>
                        <RadzenDataGridColumn Property="@nameof(PadronColonia.Colonia)" Title="Colonia" TextAlign="TextAlign.Left" Width="180px" />
                        <RadzenDataGridColumn Property="@nameof(PadronColonia.Activo)" Title="Activos" TextAlign="TextAlign.Center" Width="110px" FormatString="{0:n0}" />
                        <RadzenDataGridColumn Property="@nameof(PadronColonia.Espera)" Title="Sala Espera" TextAlign="TextAlign.Center" Width="110px" FormatString="{0:n0}" />
                        <RadzenDataGridColumn Property="@nameof(PadronColonia.BajaTemporal)" Title="Baja Temporal" TextAlign="TextAlign.Center" Width="110px" FormatString="{0:n0}" />
                        <RadzenDataGridColumn Property="@nameof(PadronColonia.BajaDefinitiva)" Title="Baja Definitiva" TextAlign="TextAlign.Center" Width="110px" FormatString="{0:n0}" />
                        <RadzenDataGridColumn Property="@nameof(PadronColonia.Congelado)" Title="Congelados" TextAlign="TextAlign.Center" Width="110px" FormatString="{0:n0}" />
                        <RadzenDataGridColumn Property="@nameof(PadronColonia.TotalUsuarios)" Title="Total Usuarios" TextAlign="TextAlign.Center" Width="110px" FormatString="{0:n0}" />
                    </Columns>
                </RadzenDataGrid>
            </div>
        </Content>
    </VentanaSecundaria>

}

@code
{

    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback CerrarModal { get; set; }
    public string Titulo = "Padron por Colonias";
    public IEnlace OficinaActual {get;set;}

    private RadzenDataGrid<PadronColonia> DataGrid {get;set;}
    private List<PadronColonia> DatosGrid {get;set;}


    //"******** Funciones ********"
    private async Task Cerrar_Modal()
    {
        this.DatosGrid = new List<PadronColonia>();
        await CerrarModal.InvokeAsync("");
    }
    public void Inicializar(List<PadronColonia> datos, IEnlace enlace)
    {
        this.DatosGrid = datos.ToList();
        this.OficinaActual = enlace;
    }
    private async Task GenerarExcel()
    {
        await ExportacionExcel.ExportarAsync(this.DataGrid, new ExcelExportProperties
        {
            FileName = string.Format("sicem_{0}.xlsx", Guid.NewGuid().ToString().Replace("-", ""))
        });
    }

}