@using Sicem_Blazor.Padron.Models

<div class="border rounded bg-white d-flex align-itenms-center p-2">
    @* TODO-EXPORT-RADZEN: exportación pendiente (ver docs/MIGRACION.md)
    <button class="button px-4" @onclick="ExportarExcel"><i class="fa fa-file-excel mr-3"></i> Exportar Excel</button>
    *@
</div>

<div class="div_grid" style="height: calc(100% - 35px);">
    <RadzenDataGrid TItem="ResumenSector" @ref="DataGrid" Data="@DatosGrid" AllowColumnResize="true" AllowSorting="true" Style="height:100%; width:100%;">
        <Columns> 
            <RadzenDataGridColumn Title="" TextAlign="TextAlign.Left" Width="40px">
                <Template>
                    @{
                        var data = (context as ResumenSector);
                        <div class="d-flex p-1">
                            <button type="button" class="btn btn-primary btn-sm mx-1" data-toggle="tooltip" data-placement="top" title="Detalle" @onclick=@( e => OnClick(data) )>
                                <i class="fa fa-bookmark" aria-hidden="true"></i>
                            </button>
                        </div>
                    }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Property="@nameof(ResumenSector.Sector)" Title="Sector" TextAlign="TextAlign.Left" Width="170px" />
            <RadzenDataGridColumn Property="@nameof(ResumenSector.Usuarios)" Title="Usuarios" TextAlign="TextAlign.Center" Width="115px" FormatString="{0:n0}" />
            <RadzenDataGridColumn Property="@nameof(ResumenSector.Subtotal)" Title="Subtotal" TextAlign="TextAlign.Right" Width="125px" FormatString="{0:c2}" />
            <RadzenDataGridColumn Property="@nameof(ResumenSector.IVA)" Title="IVA" TextAlign="TextAlign.Right" Width="125px" FormatString="{0:c2}" />
            <RadzenDataGridColumn Property="@nameof(ResumenSector.Total)" Title="Total" TextAlign="TextAlign.Right" Width="125px" FormatString="{0:c2}" />
        </Columns>
    </RadzenDataGrid>
</div>



@code
{
    private RadzenDataGrid<ResumenSector> DataGrid {get;set;}
    [Parameter] public List<ResumenSector> DatosGrid {get;set;}
    [Parameter] public EventCallback<string> OnDetailClick {get;set;}
    private async Task OnClick(ResumenSector e)
    {
        await OnDetailClick.InvokeAsync(e.Sector);
    }

