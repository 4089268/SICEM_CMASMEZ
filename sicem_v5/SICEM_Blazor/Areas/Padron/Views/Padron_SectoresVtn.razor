@using Radzen
@using Radzen.Blazor
@using Sicem_Blazor.Padron.Models
@inject IJSRuntime JSRuntime
@inject PadronService padronService
@inject NavigationManager NavManager

@if (Visible)
{

    <VentanaSecundaria Titulo="@Titulo" CerrarVentana="@CerrarModal" Filas="@(new double[]{ 50, 670 })" Columnas="@(new double[]{.85})">
        <Content>

            <!-- ****** Filtro y Exportar ****** -->
            <div class="d-flex align-items-center m-1 p-2 border rounded bg-white">
                @* TODO-EXPORT-RADZEN: exportación pendiente (ver docs/MIGRACION.md)
                <MatButton Raised="true" Style="height:2.5rem;" OnClick="@GenerarExcel">Exportar Excel <i class="fa fa-file-excel-o ml-2" aria-hidden="true"></i> </MatButton>
                *@
            </div>

            <!-- ****** DataGrid ****** -->
            <div class="m-1 p-2 border rounded bg-white">
                <RadzenDataGrid TItem="PadronSector" @ref="DataGrid" Data="@DatosGrid" AllowSorting="true" AllowColumnResize="true" Style="height:100%; width:100%;">
                    <Columns>
                        <RadzenDataGridColumn Property="@nameof(PadronSector.Sector)" Title="Sector" TextAlign="TextAlign.Center" Width="90px" />
                        <RadzenDataGridColumn Property="@nameof(PadronSector.Activo)" Title="Activos" TextAlign="TextAlign.Center" Width="110px" FormatString="{0:n0}" />
                        <RadzenDataGridColumn Property="@nameof(PadronSector.Espera)" Title="Sala Espera" TextAlign="TextAlign.Center" Width="110px" FormatString="{0:n0}" />
                        <RadzenDataGridColumn Property="@nameof(PadronSector.BajaTemporal)" Title="Baja Temporal" TextAlign="TextAlign.Center" Width="110px" FormatString="{0:n0}" />
                        <RadzenDataGridColumn Property="@nameof(PadronSector.BajaDefinitiva)" Title="Baja Definitiva" TextAlign="TextAlign.Center" Width="110px" FormatString="{0:n0}" />
                        <RadzenDataGridColumn Property="@nameof(PadronSector.Congelado)" Title="Congelados" TextAlign="TextAlign.Center" Width="110px" FormatString="{0:n0}" />
                        <RadzenDataGridColumn Property="@nameof(PadronSector.TotalUsuarios)" Title="Total Usuarios" TextAlign="TextAlign.Center" Width="110px" FormatString="{0:n0}" />
                    </Columns>
                </RadzenDataGrid>
            </div>
        </Content>
    </VentanaSecundaria>

}

@code
{

    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback CerrarModal { get; set; }
    public string Titulo = "Padron por Sectores";
    public IEnlace OficinaActual {get;set;}

    private RadzenDataGrid<PadronSector> DataGrid {get;set;}
    private List<PadronSector> DatosGrid {get;set;}


    //"******** Funciones ********"
    private async Task Cerrar_Modal()
    {
        this.DatosGrid = new List<PadronSector>();
        await CerrarModal.InvokeAsync("");
    }
    public void Inicializar(List<PadronSector> datos, IEnlace enlace)
    {
        this.DatosGrid = datos.ToList();
        this.OficinaActual = enlace;
    }
    // TODO-EXPORT-RADZEN: exportación pendiente (ver docs/MIGRACION.md). Código original de Syncfusion:
    /*
    private async Task GenerarExcel() {
        await this.DataGrid.ExcelExport(new ExcelExportProperties {
            FileName = string.Format("sicem_{0}.xlsx", Guid.NewGuid().ToString().Replace("-", ""))
        });
    }
    */

}