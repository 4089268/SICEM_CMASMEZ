@using Radzen
@using Radzen.Blazor
@using Sicem_Blazor.Micromedicion.Models

<div class="w-100 h-100">
    <div class="m-1 p-2 border rounded bg-white">
        <div class="w-100 d-flex align-items-center">
            @* TODO-EXPORT-RADZEN: exportación pendiente (ver docs/MIGRACION.md)
            <MatButton Class="ml-1 mr-2" Raised="true" Style="height:2.5rem;" OnClick="@GenerarExcel">Exportar Excel <i class="fa fa-file-excel-o ml-2" aria-hidden="true"></i> </MatButton>
            *@
        </div>
    </div>

    <div class="m-1 p-2 border rounded bg-white" style="width:100%; height: calc(100% - 4rem);">
        <RadzenDataGrid TItem="Resumen_Tarifa" @ref="DataGrid" Data="@DatosGrid" AllowColumnResize="true" AllowSorting="true" AllowFiltering="false" Density="Density.Compact" class="grid-sin-panel-grupos" AllowGrouping="true" Groups="@_grupos" Style="height:100%; width:auto;">
            <GroupHeaderTemplate>
                    @{
                        var order = new { Key = context.Data.Key?.ToString() ?? "", Count = context.Data.Count };
                        if(order.Key.Contains("--*--"))
                        {
                            <div class="pt-4 pb-3">TOTAL</div>
                        }
                        else
                        {
                            <div Class="pt-4 pb-3"> @order.Key.ToString().ToUpper()</div>
                        }
                    }
            </GroupHeaderTemplate>
            <Columns>
                <RadzenDataGridColumn Property="@nameof(Resumen_Tarifa.Localidad)" Title="Localidad" TextAlign="TextAlign.Left" Width="280px" />
                <RadzenDataGridColumn Property="@nameof(Resumen_Tarifa.Descripcion)" Title="Tarifa" TextAlign="TextAlign.Left" Width="280px" />
                <RadzenDataGridColumn Property="@nameof(Resumen_Tarifa.UsuMedidorFun)" Title="Medidores Funcionando" TextAlign="TextAlign.Center" Width="150px" FormatString="{0:n0}" />
                <RadzenDataGridColumn Property="@nameof(Resumen_Tarifa.UsuMedidorNoFun)" Title="Medidores No Funcionando" TextAlign="TextAlign.Center" Width="150px" FormatString="{0:n0}" />
                <RadzenDataGridColumn Property="@nameof(Resumen_Tarifa.UsuConMedidor)" Title="Usu Con Medidor" TextAlign="TextAlign.Center" Width="150px" FormatString="{0:n0}" />
                <RadzenDataGridColumn Property="@nameof(Resumen_Tarifa.UsuSinMedidor)" Title="Usu Sin Medidor" TextAlign="TextAlign.Center" Width="150px" FormatString="{0:n0}" />
                <RadzenDataGridColumn Property="@nameof(Resumen_Tarifa.UsuDren)" Title="Tomas Con Drenaje" TextAlign="TextAlign.Center" Width="150px" FormatString="{0:n0}" />
                <RadzenDataGridColumn Property="@nameof(Resumen_Tarifa.UsuTomas)" Title="Total Tomas" TextAlign="TextAlign.Center" Width="150px" FormatString="{0:n0}" />
            </Columns>
        </RadzenDataGrid>
    </div>
</div>

@code
{

    // Agrupación inicial (en Syncfusion: GridGroupSettings Columns)
    private System.Collections.ObjectModel.ObservableCollection<GroupDescriptor> _grupos = new System.Collections.ObjectModel.ObservableCollection<GroupDescriptor>() { new GroupDescriptor() { Property = "Localidad" } };

    [Parameter] public IEnlace Enlace { get; set; }
    [Parameter] public List<Resumen_Tarifa> DatosGrid {get;set;}
    private RadzenDataGrid<Resumen_Tarifa> DataGrid {get;set;}
    
    protected override void OnParametersSet()
    {
       if(DatosGrid != null)
       {
            DatosGrid = DatosGrid
                .OrderBy(item => item.Localidad)
                .OrderBy(item => item.IdTarifa)
                .ToList();
        }
   }

    
