@page "/PagoLineaAnalitycs"
@namespace Sicem_Blazor.PagoLinea.Views
@using System.IO
@using Sicem_Blazor.PagoLinea.Models
@using Sicem_Blazor.PagoLinea.Data

<div class="pagoAnalitycLayout">

    <div class="title-page" style="grid-area:1/1/2/3;">Incorporación de Pagos al Sistema</div>

    <div class="nav-tabs">
        <MatTabBar @ref="_mattabbar" ActiveChanged="MatTabBarActiveChanged">
            <MatTabLabel Id="archivos">
                <h6>Cargar Archivos</h6>
            </MatTabLabel>
            <MatTabLabel Id="cargados">
                <h6>Transacciones Almacenadas</h6>
            </MatTabLabel>
        </MatTabBar>
    </div>

    <div class="global-actions">
        @* <button class="btn btn-secondary rounded px-3 py-2 mr-1" disabled>
            Some action
        </button> *@
    </div>

    <div class="nav-content">
        @if(_tabIndex == 0)
        {
            <div class="w-100 h-100 d-flex flex-column">
                <div class="w-100">
                    <label for="uploadFile" class="btn btn-primary px-3 py-2 mx-2 my-2">
                        <i class="fa fa-upload mr-1"></i>
                        <span>Cargar Archivo</span>
                        <InputFile id="uploadFile" style="display: none;" OnChange="HandleUploadFile" accept=".csv,.xlsx,.xls" />
                    </label>
                </div>
                <div class="h-100 w-100 border-top mt-1">
                    <RadzenDataGrid TItem="UploadFilePayloadJob" @ref="DataGridFiles" Data="@RecordsFiles" AllowColumnResize="true" AllowSorting="true" Style="height:100%; width:100%;">
                        <Columns>
                            <RadzenDataGridColumn Title="" TextAlign="TextAlign.Center" Width="40px">
                                <Template>
                                    @{
                                        var data = (context as UploadFilePayloadJob);
                                        @switch (data.Status)
                                        {
                                            case UploadFileJobStatusEnum.Completed:
                                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="22" viewBox="0 0 24 24"><path fill="none" stroke="#65a30d" stroke-width="2" d="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2S2 6.477 2 12s4.477 10 10 10ZM7 12l4 3l5-7"/></svg>
                                                break;
                                            case UploadFileJobStatusEnum.Fail:
                                                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24"><path fill="none" stroke="#db2777" stroke-linejoin="round" stroke-width="2" d="m12 3l10 18H2zm0 6v6m0 1v2"/></svg>
                                                break;
                                            case UploadFileJobStatusEnum.Pending:
                                                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24"><path fill="none" stroke="#0284c7" stroke-width="2" d="M2 3.99C2 2.892 2.898 2 3.99 2h16.02C21.108 2 22 2.898 22 3.99v16.02c0 1.099-.898 1.99-1.99 1.99H3.99A1.995 1.995 0 0 1 2 20.01zM12 10v8m0-12v2"/></svg>
                                                break;
                                            default:
                                                <div class="spinner-border p-2" role="status"></div>
                                                break;
                                        }
                                    }
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn Property="@nameof(UploadFilePayloadJob.Id)" Title="id" TextAlign="TextAlign.Left" Width="170px" />
                            <RadzenDataGridColumn Property="@nameof(UploadFilePayloadJob.FileName)" Title="Archivo" TextAlign="TextAlign.Left" Width="240px" />
                            <RadzenDataGridColumn Property="@nameof(UploadFilePayloadJob.CreatedAt)" Title="Registro" TextAlign="TextAlign.Left" Width="120px" FormatString="{0:d}" />
                            <RadzenDataGridColumn Property="@nameof(UploadFilePayloadJob.UploadedAt)" Title="Ultima Actualizacion" TextAlign="TextAlign.Left" Width="120px" FormatString="{0:d}" />
                            <RadzenDataGridColumn Property="@nameof(UploadFilePayloadJob.Records)" Title="Total" TextAlign="TextAlign.Left" Width="120px" FormatString="{0:n0}" />
                            <RadzenDataGridColumn Property="@nameof(UploadFilePayloadJob.Message)" Title="Mensaje" TextAlign="TextAlign.Left" Width="200px" ShowCellDataAsTooltip="true" />
                        </Columns>
                    </RadzenDataGrid>
                </div>
            </div>
        }

        @if(_tabIndex == 1)
        {
            <div class="area-payments">
                <div class="actions">
                    <SeleccionarFecha OcultarSector="true" ProcesarParam="@Procesar" />
                    
                    <div class="mx-2 vr"></div>
                    
                    @* TODO-EXPORT-RADZEN: exportación pendiente (ver docs/MIGRACION.md)
                    <button class="btn btn-success rounded px-3 py-2 mr-1" @onclick="DownloadExcel">
                        <i class="fa fa-arrow-circle-down mr-1" />
                        Exportar Datos
                    </button>
                    *@

                    <div class="mx-2 vr"></div>

                    <label class="d-flex align-items-center mb-0 mr-2">
                        <input type="checkbox" checked="@_soloPendientes" @onchange="@((e) => OnSoloPendientesChanged((bool)e.Value))" class="mr-1" />
                        Solo pendientes de aplicar
                    </label>

                    @if(_showButton)
                    {
                        <MatButton Class="mx-2 bg-info" Raised="true" Style="height:2.5rem;" OnClick="@AplicarPagosClick" Disabled="@_taskOnProgress">
                            Aplicar Pagos
                            <i class="fa fa-check-double ml-2" aria-hidden="true"></i>
                        </MatButton>
                    }
                </div>
                <div class="datatable">
                    <RadzenDataGrid TItem="TransactionRecord" @ref="DataGridRecords" Data="@_recordsView" AllowColumnResize="true" AllowSorting="true" AllowFiltering="false" AllowPaging="true" PageSize="100" Style="height:100%; width:100%;">
                        <Columns>
                            <RadzenDataGridColumn Title="Estatus Aplicado" TextAlign="TextAlign.Center" Width="150px">
                                <Template>
                                    @{
                                        var data = (context as TransactionRecord);
                                        @switch (data.Aplicado)
                                        {
                                            case EstatusAplicacionPagoEnum.ERROR:
                                                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24"><path fill="none" stroke="#db2777" stroke-linejoin="round" stroke-width="2" d="m12 3l10 18H2zm0 6v6m0 1v2"/></svg>
                                                <span class="ml-1 ms-1">@data.Aplicado.ToString()</span>
                                                break;
                                            case EstatusAplicacionPagoEnum.APLICADO:
                                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="22" viewBox="0 0 24 24"><path fill="none" stroke="#65a30d" stroke-width="2" d="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2S2 6.477 2 12s4.477 10 10 10ZM7 12l4 3l5-7"/></svg>
                                                <span class="ml-1 ms-1">@data.Aplicado.ToString()</span>
                                                break;
                                            case EstatusAplicacionPagoEnum.PROGRESS:
                                                <div class="spinner-border p-2" role="status"></div>
                                                break;
                                            default:
                                                <div class="d-inline-flex align-items-center justify-content-center">
                                                    <button type="button" class="btn bg-info btn-primary btn-sm mx-1" data-toggle="tooltip" data-placement="top" title="Aplicar Pago" @onclick="@(e => AplicarPagoClick(data))">
                                                        <i class="fa fa-check-double" aria-hidden="true"></i>
                                                        <span>Aplicar Pago</span>
                                                    </button>
                                                </div>
                                                break;
                                        }
                                    }
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn Property="@nameof(TransactionRecord.Id)" Title="Id" TextAlign="TextAlign.Left" Width="170px" Visible="false" />
                            <RadzenDataGridColumn Property="@nameof(TransactionRecord.Folio)" Title="Folio" TextAlign="TextAlign.Left" Width="200px" />
                            <RadzenDataGridColumn Property="@nameof(TransactionRecord.Fecha)" Title="Fecha" TextAlign="TextAlign.Left" Width="150px" />
                            @* <RadzenDataGridColumn Property="@nameof(TransactionRecord.Servicio)" Title="Servicio" TextAlign="TextAlign.Left" Width="250px" /> *@
                            <RadzenDataGridColumn Property="@nameof(TransactionRecord.Concepto)" Title="Concepto" TextAlign="TextAlign.Left" Width="250px" />
                            <RadzenDataGridColumn Property="@nameof(TransactionRecord.Referencia)" Title="Referencia" TextAlign="TextAlign.Left" Width="115px" />
                            <RadzenDataGridColumn Property="@nameof(TransactionRecord.Autorizacion)" Title="Autorizacion" TextAlign="TextAlign.Left" Width="115px" />
                            <RadzenDataGridColumn Property="@nameof(TransactionRecord.Usuario)" Title="Usuario Pago" TextAlign="TextAlign.Left" Width="120px" />
                            <RadzenDataGridColumn Title="Estatus Pago" TextAlign="TextAlign.Center" Width="160px">
                                <Template>
                                    @{
                                        var data = (context as TransactionRecord);
                                        <span>@data.EstatusPago.ToString()</span>
                                    }
                                </Template>
                            </RadzenDataGridColumn>
                            @* <RadzenDataGridColumn Property="@nameof(TransactionRecord.FechaCreacion)" Title="Fecha Registro" TextAlign="TextAlign.Center" Width="160px" /> *@
                            <RadzenDataGridColumn Property="@nameof(TransactionRecord.UltimaModificacion)" Title="Fecha Modificacion" TextAlign="TextAlign.Center" Width="160px" />
                            <RadzenDataGridColumn Property="@nameof(TransactionRecord.IdPadron)" Title="Id Padron" TextAlign="TextAlign.Center" Width="120px" />
                            <RadzenDataGridColumn Property="@nameof(TransactionRecord.FechaAplicacion)" Title="Fecha Aplicacion Comercial" TextAlign="TextAlign.Left" Width="180px" />
                            <RadzenDataGridColumn Property="@nameof(TransactionRecord.MensajeAplicacion)" Title="Mensaje Apliacion Comercial" TextAlign="TextAlign.Left" Width="240px" ShowCellDataAsTooltip="true" />
                        </Columns>
                    </RadzenDataGrid>
                </div>
            </div>
        }
    </div>

</div>


@* ****** Dialogos y ventanas secundarias ****** *@
<BusyIndicator Busy="@_busyDialog" ContentText="Cargando datos...." />

<style>
    .pagoAnalitycLayout {
        display: grid;
        width: 100%;
        height: calc(100% - 1rem);
        grid-gap: 0px;
        grid-template-columns: 700px calc(100% - 710px);
        grid-template-rows: 3rem 5rem calc(100% - 8rem);
    }

    .nav-tabs
    {
        grid-area:2/1/3/2;
    }

    .global-actions
    {
        grid-area:2/2/3/3;
        display:flex;
        align-items: center;
        justify-content: flex-end;
        padding: .5rem 1rem;
    }
    .nav-content
    {
        border: 1px solid #bbb;
        width: 100%;
        height: 100%;
        padding: .5rem;
        background-color: white;
        grid-area:3/1/4/3;
    }

    .area-payments
    {
        width: 100%;
        height: 100%;
        display: flex;
        flex-flow: column;
    }
    .area-payments .actions
    {
        width: 100%;
        height: 4.5rem;
        display: flex;
        align-items: center;
    }

    .area-payments .datatable
    {
        width: 100%;
        height: calc(100% - 3.5rem);
    }

</style>