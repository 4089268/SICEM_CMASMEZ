@page "/PagoLineaAnalitycs"
@namespace Sicem_Blazor.PagoLinea.Views
@using System.IO
@using Syncfusion.Blazor.Grids
@using Syncfusion.Blazor.Charts
@using Sicem_Blazor.PagoLinea.Models
@using Sicem_Blazor.PagoLinea.Data

<div class="pagoAnalitycLayout">

    <div class="title-page" style="grid-area:1/1/2/3;">Incorporación de Pagos al Sistema</div>

    <div class="nav-tabs">
        <MatTabBar @ref="mattabbar" ActiveChanged="MatTabBarActiveChanged">
            <MatTabLabel Id="archivos">
                <h6>Cargar Archivos</h6>
            </MatTabLabel>
            <MatTabLabel Id="cargados">
                <h6>Transacciones Almacenadas</h6>
            </MatTabLabel>
        </MatTabBar>
    </div>

    <div class="global-actions">
        @* <button class="btn btn-secondary rounded px-3 py-2 mr-1" disabled>
            Some action
        </button> *@
    </div>

    <div class="nav-content">
        @if(tabIndex == 0)
        {
            <div class="w-100 h-100 d-flex flex-column">
                <div class="w-100">
                    <label for="uploadFile" class="btn btn-primary px-3 py-2 mx-2 my-2">
                        <i class="fa fa-upload mr-1"></i>
                        <span>Cargar Archivo</span>
                        <InputFile id="uploadFile" style="display: none;" OnChange="HandleUploadFile" accept=".csv,.xlsx,.xls" />
                    </label>
                </div>
                <div class="h-100 w-100 border-top mt-1">
                    <SfGrid @ref="DataGridFiles" DataSource="@RecordsFiles" TValue="UploadFilePayloadJob" AllowResizing="true" AllowSorting="true" Height="100%" Width="100%" EnableHover="true">
                        <GridColumns>
                            <GridColumn HeaderText="" TextAlign="TextAlign.Center" Width="40">
                                <Template>
                                    @{
                                        var data = (context as UploadFilePayloadJob);
                                        @switch (data.Status)
                                        {
                                            case UploadFileJobStatusEnum.Completed:
                                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="22" viewBox="0 0 24 24"><path fill="none" stroke="#65a30d" stroke-width="2" d="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2S2 6.477 2 12s4.477 10 10 10ZM7 12l4 3l5-7"/></svg>
                                                break;
                                            case UploadFileJobStatusEnum.Fail:
                                                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24"><path fill="none" stroke="#db2777" stroke-linejoin="round" stroke-width="2" d="m12 3l10 18H2zm0 6v6m0 1v2"/></svg>
                                                break;
                                            case UploadFileJobStatusEnum.Pending:
                                                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24"><path fill="none" stroke="#0284c7" stroke-width="2" d="M2 3.99C2 2.892 2.898 2 3.99 2h16.02C21.108 2 22 2.898 22 3.99v16.02c0 1.099-.898 1.99-1.99 1.99H3.99A1.995 1.995 0 0 1 2 20.01zM12 10v8m0-12v2"/></svg>
                                                break;
                                            default:
                                                <div class="spinner-border p-2" role="status"></div>
                                                break;
                                        }
                                    }
                                </Template>
                            </GridColumn>
                            <GridColumn Field="@nameof(UploadFilePayloadJob.Id)" HeaderText="id" TextAlign="TextAlign.Left" Width="170"/>
                            <GridColumn Field="@nameof(UploadFilePayloadJob.FileName)" HeaderText="Archivo" TextAlign="TextAlign.Left" Width="240"/>
                            <GridColumn Field="@nameof(UploadFilePayloadJob.CreatedAt)" HeaderText="Registro" TextAlign="TextAlign.Left" Width="120" Format="d"/>
                            <GridColumn Field="@nameof(UploadFilePayloadJob.UploadedAt)" HeaderText="Ultima Actualizacion" TextAlign="TextAlign.Left" Width="120" Format="d"/>
                            <GridColumn Field="@nameof(UploadFilePayloadJob.Records)" HeaderText="Total" TextAlign="TextAlign.Left" Width="120" Format="n0"/>
                            <GridColumn Field="@nameof(UploadFilePayloadJob.Message)" HeaderText="Mensaje" TextAlign="TextAlign.Left" Width="200" ClipMode="ClipMode.EllipsisWithTooltip" />
                        </GridColumns>
                    </SfGrid>
                </div>
            </div>
        }

        @if(tabIndex == 1)
        {
            <div class="area-payments">
                <div class="actions">
                    <SeleccionarFecha OcultarSector="true" ProcesarParam="@Procesar" />
                    
                    <div class="mx-2 vr"></div>
                    
                    <button class="btn btn-success rounded px-3 py-2 mr-1" @onclick="DownloadExcel">
                        <i class="fa fa-arrow-circle-down mr-1" />
                        Exportar Datos
                    </button>

                    <div class="mx-2 vr"></div>

                    <label class="d-flex align-items-center mb-0 mr-2">
                        <input type="checkbox" checked="@soloPendientes" @onchange="@((e) => OnSoloPendientesChanged((bool)e.Value))" class="mr-1" />
                        Solo pendientes de aplicar
                    </label>

                    @if(showButton)
                    {
                        <MatButton Class="mx-2 bg-info" Raised="true" Style="height:2.5rem;" OnClick="@AplicarPagosClick" Disabled="@taskOnProgress">
                            Aplicar Pagos
                            <i class="fa fa-check-double ml-2" aria-hidden="true"></i>
                        </MatButton>
                    }
                </div>
                <div class="datatable">
                    <SfGrid @ref="DataGridRecords" DataSource="@RecordsView" TValue="TransactionRecord" AllowResizing="true" AllowSorting="true" AllowFiltering="false"
                        AllowExcelExport="true" Height="100%" Width="100%" EnableHover="true" AllowPaging="true">
                        <GridPageSettings PageSize="100"></GridPageSettings>
                        <GridColumns>
                            <GridColumn HeaderText="Estatus Aplicado" TextAlign="TextAlign.Center" Width="150">
                                <Template>
                                    @{
                                        var data = (context as TransactionRecord);
                                        @switch (data.Aplicado)
                                        {
                                            case EstatusAplicacionPagoEnum.ERROR:
                                                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24"><path fill="none" stroke="#db2777" stroke-linejoin="round" stroke-width="2" d="m12 3l10 18H2zm0 6v6m0 1v2"/></svg>
                                                <span class="ml-1 ms-1">@data.Aplicado.ToString()</span>
                                                break;
                                            case EstatusAplicacionPagoEnum.APLICADO:
                                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="22" viewBox="0 0 24 24"><path fill="none" stroke="#65a30d" stroke-width="2" d="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2S2 6.477 2 12s4.477 10 10 10ZM7 12l4 3l5-7"/></svg>
                                                <span class="ml-1 ms-1">@data.Aplicado.ToString()</span>
                                                break;
                                            case EstatusAplicacionPagoEnum.PROGRESS:
                                                <div class="spinner-border p-2" role="status"></div>
                                                break;
                                            default:
                                                <div class="d-inline-flex align-items-center justify-content-center">
                                                    <button type="button" class="btn bg-info btn-primary btn-sm mx-1" data-toggle="tooltip" data-placement="top" title="Aplicar Pago" @onclick="@(e => AplicarPagoClick(data))">
                                                        <i class="fa fa-check-double" aria-hidden="true"></i>
                                                        <span>Aplicar Pago</span>
                                                    </button>
                                                </div>
                                                break;
                                        }
                                    }
                                </Template>
                            </GridColumn>
                            <GridColumn Field="@nameof(TransactionRecord.Id)" HeaderText="Id" TextAlign="TextAlign.Left" Width="170" Visible="false" />
                            <GridColumn Field="@nameof(TransactionRecord.Folio)" HeaderText="Folio" TextAlign="TextAlign.Left" Width="200"/>
                            <GridColumn Field="@nameof(TransactionRecord.Fecha)" HeaderText="Fecha" TextAlign="TextAlign.Left" Width="150"/>
                            @* <GridColumn Field="@nameof(TransactionRecord.Servicio)" HeaderText="Servicio" TextAlign="TextAlign.Left" Width="250" /> *@
                            <GridColumn Field="@nameof(TransactionRecord.Concepto)" HeaderText="Concepto" TextAlign="TextAlign.Left" Width="250" />
                            <GridColumn Field="@nameof(TransactionRecord.Referencia)" HeaderText="Referencia" TextAlign="TextAlign.Left" Width="115"/>
                            <GridColumn Field="@nameof(TransactionRecord.Autorizacion)" HeaderText="Autorizacion" TextAlign="TextAlign.Left" Width="115"/>
                            <GridColumn Field="@nameof(TransactionRecord.Usuario)" HeaderText="Usuario Pago" TextAlign="TextAlign.Left" Width="120"/>
                            <GridColumn HeaderText="Estatus Pago" TextAlign="TextAlign.Center" Width="160">
                                <Template>
                                    @{
                                        var data = (context as TransactionRecord);
                                        <span>@data.EstatusPago.ToString()</span>
                                    }
                                </Template>
                            </GridColumn>
                            @* <GridColumn Field="@nameof(TransactionRecord.FechaCreacion)" HeaderText="Fecha Registro" TextAlign="TextAlign.Center" Width="160" /> *@
                            <GridColumn Field="@nameof(TransactionRecord.UltimaModificacion)" HeaderText="Fecha Modificacion" TextAlign="TextAlign.Center" Width="160"/>
                            <GridColumn Field="@nameof(TransactionRecord.IdPadron)" HeaderText="Id Padron" TextAlign="TextAlign.Center" Width="120"/>
                            <GridColumn Field="@nameof(TransactionRecord.FechaAplicacion)" HeaderText="Fecha Aplicacion Comercial" TextAlign="TextAlign.Left" Width="180"/>
                            <GridColumn Field="@nameof(TransactionRecord.MensajeAplicacion)" HeaderText="Mensaje Apliacion Comercial" TextAlign="TextAlign.Left" Width="240" ClipMode="ClipMode.EllipsisWithTooltip"/>
                        </GridColumns>
                    </SfGrid>
                </div>
            </div>
        }
    </div>

</div>


@* ****** Dialogos y ventanas secundarias ****** *@
<BusyIndicator Busy="@busyDialog" ContentText="Cargando datos...." />

<style>
    .pagoAnalitycLayout {
        display: grid;
        width: 100%;
        height: calc(100% - 1rem);
        grid-gap: 0px;
        grid-template-columns: 700px calc(100% - 710px);
        grid-template-rows: 3rem 5rem calc(100% - 8rem);
    }

    .nav-tabs
    {
        grid-area:2/1/3/2;
    }

    .global-actions
    {
        grid-area:2/2/3/3;
        display:flex;
        align-items: center;
        justify-content: flex-end;
        padding: .5rem 1rem;
    }
    .nav-content
    {
        border: 1px solid #bbb;
        width: 100%;
        height: 100%;
        padding: .5rem;
        background-color: white;
        grid-area:3/1/4/3;
    }

    .area-payments
    {
        width: 100%;
        height: 100%;
        display: flex;
        flex-flow: column;
    }
    .area-payments .actions
    {
        width: 100%;
        height: 4.5rem;
        display: flex;
        align-items: center;
    }

    .area-payments .datatable
    {
        width: 100%;
        height: calc(100% - 3.5rem);
    }

</style>