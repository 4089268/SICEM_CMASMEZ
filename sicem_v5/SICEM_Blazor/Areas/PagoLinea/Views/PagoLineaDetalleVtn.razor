@using Sicem_Blazor.PagoLinea.Models;
@namespace Sicem_Blazor.PagoLinea.Views

@if (mostrarVentana)
{
    <VentanaSecundaria Titulo="@titulo" CerrarVentana="@HandleCloseModal" Filas="@(new double[] { 50, 610 })" Columnas="@(new double[]{.9})">
        <Content>

            <div class="m-1 p-2 border rounded bg-white d-flex align-items-center" style="grid-row: 1/2; grid-column: 1/2; font-size:1.2rem;">
                
                <MatButton Class="ml-1 mr-2" Raised="true" Style="height:2.5rem;" OnClick="@ExportData">
                    Exportar Excel
                    <i class="fa fa-file-excel-o ml-2" aria-hidden="true"></i>
                </MatButton>

                @if(showButton)
                {
                    <MatButton Class="mx-2 bg-info" Raised="true" Style="height:2.5rem;" OnClick="@AplicarPagosClick" Disabled="@_taskOnProgress">
                        Aplicar Pagos
                        <i class="fa fa-check-double ml-2" aria-hidden="true"></i>
                    </MatButton>
                }
            </div>

            <div class="m-1 p-2 border rounded bg-white" style="grid-row: 2/3; grid-column: 1/2;">
                <RadzenDataGrid TItem="PagoLineaDetalle" @ref="DataGrid" Data="@Datos" AllowColumnResize="true" AllowSorting="true" AllowFiltering="false" Style="height:100%; width:auto;">
                    <Columns>
                        <RadzenDataGridColumn Title="" TextAlign="TextAlign.Center" Width="40px">
                            <Template>
                                @{
                                    var data = (context as PagoLineaDetalle);
                                    if(!data.Aplicado)
                                    {
                                        if( data.aplicarPagoResult == null)
                                        {
                                            <div class="d-flex align-items-center justify-content-center">
                                                <button type="button" class="btn bg-info btn-primary btn-sm mx-1" data-toggle="tooltip" data-placement="top" title="Aplicar Pago" @onclick="@(e => AplicarPagoClick(data))">
                                                    <i class="fa fa-check-double" aria-hidden="true"></i>
                                                </button>
                                            </div>
                                        }
                                        else
                                        {
                                            @switch (data.aplicarPagoResult.Estatus)
                                            {
                                                case ResumenOficinaEstatus.Completado:
                                                    <i class="fas fa-check-circle" style="color:green; font-size:1.5rem;"></i>
                                                    break;

                                                case ResumenOficinaEstatus.Error:
                                                    <i class="fas fa-exclamation-circle" style="color:red; font-size:1.5rem;"></i>
                                                    break;

                                                default:
                                                    <div class="spinner-border p-2" role="status"> </div>
                                                    break;
                                            }
                                        }
                                    }
                                }
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn Property="@nameof(PagoLineaDetalle.Folio)" Title="Folio" TextAlign="TextAlign.Left" Width="160px" />
                        <RadzenDataGridColumn Property="@nameof(PagoLineaDetalle.Fecha)" Title="Fecha de Pago" TextAlign="TextAlign.Center" Width="120px" />
                        <RadzenDataGridColumn Property="@nameof(PagoLineaDetalle.MedioPago)" Title="MedioPago" TextAlign="TextAlign.Center" Width="100px" />
                        <RadzenDataGridColumn Property="@nameof(PagoLineaDetalle.Referencia)" Title="Referencia" TextAlign="TextAlign.Left" Width="120px" />
                        <RadzenDataGridColumn Property="@nameof(PagoLineaDetalle.TipoTarjeta)" Title="Tipo Tarjeta" TextAlign="TextAlign.Center" Width="80px" />
                        <RadzenDataGridColumn Property="@nameof(PagoLineaDetalle.Autorizacion)" Title="Autorizacion" TextAlign="TextAlign.Center" Width="90px" />
                        @* <RadzenDataGridColumn Property="@nameof(PagoLineaDetalle.Cuenta)" Title="Cuenta" TextAlign="TextAlign.Center" Width="75px" /> *@
                        @* <RadzenDataGridColumn Property="@nameof(PagoLineaDetalle.Localidad)" Title="Localidad" TextAlign="TextAlign.Center" Width="90px" /> *@
                        <RadzenDataGridColumn Property="@nameof(PagoLineaDetalle.Importe)" Title="Importe" TextAlign="TextAlign.Right" Width="120px" FormatString="{0:c2}" />
                        <RadzenDataGridColumn Property="@nameof(PagoLineaDetalle.ImporteAplicado)" Title="Importe Aplicado" TextAlign="TextAlign.Right" Width="120px" FormatString="{0:c2}" />
                        @* <RadzenDataGridColumn Property="@nameof(PagoLineaDetalle.Diferencia)" Title="Diferencia" TextAlign="TextAlign.Right" Width="120px" FormatString="{0:c2}" /> *@
                    </Columns>
                </RadzenDataGrid>
            </div>

        </Content>
    </VentanaSecundaria>

}