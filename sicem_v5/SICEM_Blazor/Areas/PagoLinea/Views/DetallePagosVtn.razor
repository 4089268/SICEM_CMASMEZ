@using Sicem_Blazor.PagoLinea.Models;
@namespace Sicem_Blazor.PagoLinea.Views

@if (mostrarVentana)
{
    <VentanaSecundaria Titulo="@titulo" CerrarVentana="@HandleCloseModal" Filas="@(new double[] { 50, 610 })" Columnas="@(new double[]{1100})">
        <Content>

            <div class="m-1 p-2 border rounded bg-white" style="grid-row: 1/2; grid-column: 1/2;">
                <div class="w-100 d-flex align-items-center">
                    <MatButton Class="ml-1 mr-2" Raised="true" Style="height:2.5rem;" OnClick="@ExportData">Exportar Excel <i class="fa fa-file-excel-o ml-2" aria-hidden="true"></i> </MatButton>
                </div>
            </div>

            <div class="m-1 p-2 border rounded bg-white" style="grid-row: 2/3; grid-column: 1/2;">
                <RadzenDataGrid TItem="OprVenta" SelectionMode="DataGridSelectionMode.Single" @ref="DataGrid" Data="@Datos" AllowColumnResize="true" AllowSorting="true" AllowFiltering="false" Style="height:100%; width:auto;">
                    <Columns>
                        <RadzenDataGridColumn Property="@nameof(OprVenta.Id)" Title="ID" TextAlign="TextAlign.Left" Width="120px" />
                        <RadzenDataGridColumn Property="@nameof(OprVenta.Fecha)" Title="Fecha de Pago" TextAlign="TextAlign.Center" Width="180px" FormatString="{0:d}" />
                        <RadzenDataGridColumn Property="@nameof(OprVenta.Periodo)" Title="Periodo" TextAlign="TextAlign.Center" Width="100px" />
                        <RadzenDataGridColumn Property="@nameof(OprVenta.IdCuenta)" Title="Cuenta" TextAlign="TextAlign.Center" Width="150px" />
                        <RadzenDataGridColumn Property="@nameof(OprVenta.Subtotal)" Title="Subtotal" TextAlign="TextAlign.Right" Width="150px" FormatString="{0:c2}" />
                        <RadzenDataGridColumn Property="@nameof(OprVenta.Iva)" Title="Iva" TextAlign="TextAlign.Right" Width="150px" FormatString="{0:c2}" />
                        <RadzenDataGridColumn Property="@nameof(OprVenta.Total)" Title="Total" TextAlign="TextAlign.Right" Width="150px" FormatString="{0:c2}" />
                        <RadzenDataGridColumn Property="@nameof(OprVenta.Cobrado)" Title="Cobrado" TextAlign="TextAlign.Right" Width="140px" FormatString="{0:c2}" />
                        <RadzenDataGridColumn Property="@nameof(OprVenta.ReferenciaComercio)" Title="Referencia" TextAlign="TextAlign.Left" Width="140px" FormatString="{0:n0}" />
                    </Columns>
                </RadzenDataGrid>
            </div>

        </Content>
    </VentanaSecundaria>
}