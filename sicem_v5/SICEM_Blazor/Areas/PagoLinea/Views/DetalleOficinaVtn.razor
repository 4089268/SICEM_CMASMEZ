@using Sicem_Blazor.Models.PagoLinea
@namespace Sicem_Blazor.PagoLinea.Views

@if (mostrarVentana)
{
    <VentanaSecundaria Titulo="@titulo.ToUpper()" CerrarVentana="@HandleCloseModal" Filas="@(new double[] { 50, .4, .4 })" Columnas="@(new double[]{.9})">
        <Content>

            <div class="m-1 p-2 border rounded bg-white" style="grid-area: 1/1/2/2;">
                <div class="w-100 d-flex align-items-center">
                    <MatButton Class="ml-1 mr-2" Raised="true" Style="height:2.5rem;" OnClick="@ExportData">Exportar Excel <i class="fa fa-file-excel-o ml-2" aria-hidden="true"></i> </MatButton>
                </div>
            </div>

            <div class="m-1 p-2 border rounded bg-white" style="grid-area: 2/1/3/2;">
                <RadzenDataGrid TItem="PaymentDetails" @ref="DataGrid" Data="@Datos" AllowColumnResize="true" AllowSorting="true" AllowFiltering="false" Style="height:100%; width:auto;">
                    <Columns>
                        <RadzenDataGridColumn Property="@nameof(PaymentDetails.Id)" Title="ID" TextAlign="TextAlign.Left" Width="120px" />
                        <RadzenDataGridColumn Property="@nameof(PaymentDetails.IdPadron)" Title="Id Padron" TextAlign="TextAlign.Center" Width="150px" />
                        <RadzenDataGridColumn Property="@nameof(PaymentDetails.RazonSocial)" Title="Razon Social" TextAlign="TextAlign.Left" Width="220px" />
                        <RadzenDataGridColumn Property="@nameof(PaymentDetails.Periodo)" Title="Periodo Factura" TextAlign="TextAlign.Center" Width="210px" />
                        <RadzenDataGridColumn Property="@nameof(PaymentDetails.Fecha)" Title="Fecha de Pago" TextAlign="TextAlign.Center" Width="180px" FormatString="{0:d}" />
                        <RadzenDataGridColumn Property="@nameof(PaymentDetails.TotalImporte)" Title="Total Importe" TextAlign="TextAlign.Right" Width="150px" FormatString="{0:c2}" />
                        <RadzenDataGridColumn Property="@nameof(PaymentDetails.TotalCobrado)" Title="Total Cobrado" TextAlign="TextAlign.Right" Width="150px" FormatString="{0:c2}" />
                        <RadzenDataGridColumn Property="@nameof(PaymentDetails.Estado)" Title="Estado" TextAlign="TextAlign.Center" Width="140px" />
                    </Columns>
                </RadzenDataGrid>
            </div>

            <div class="border rounded bg-white p-1" style="grid-area: 3/1/4/2;">
                <div class="text-center font-weight-bold">Pagos realizados por dia</div>
                <RadzenChart Style="width:100%; height:100%;">
                    <RadzenCategoryAxis />
                    <RadzenValueAxis Visible="true" FormatString="{0:n0}" />
                    <RadzenChartTooltipOptions Shared="true" />
                    <RadzenLineSeries Data="@IncomeDays" Title="Pagos realizados" CategoryProperty="DayFormat" ValueProperty="TotalMovements" Stroke="#440412">
                        <TooltipTemplate Context="item">
                            <b>@item.DayFormat</b> : @item.TotalMovements pagos
                        </TooltipTemplate>
                        <ChildContent>
                            <RadzenSeriesDataLabels Visible="true" />
                        </ChildContent>
                    </RadzenLineSeries>
                </RadzenChart>
            </div>

        </Content>
    </VentanaSecundaria>
}