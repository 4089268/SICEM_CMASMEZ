@using Radzen
@using Radzen.Blazor
@using Sicem_Blazor.PagoLinea.Models
@namespace Sicem_Blazor.PagoLinea.Views

@if (mostrarVentana)
{
    <VentanaSecundaria Titulo="@titulo.ToUpper()" CerrarVentana="@HandleCloseModal" Filas="@(new double[] { 50, .75 })" Columnas="@(new double[]{.85})">
        <Content>

            <div class="m-1 p-2 border rounded bg-white" style="grid-area: 1/1/2/2;">
                <div class="w-100 d-flex align-items-center">
                    @* TODO-EXPORT-RADZEN: exportación pendiente (ver docs/MIGRACION.md)
                    <MatButton Class="ml-1 mr-2" Raised="true" Style="height:2.5rem;" OnClick="@ExportData">Exportar Excel <i class="fa fa-file-excel-o ml-2" aria-hidden="true"></i> </MatButton>
                    *@
                </div>
            </div>

            <div class="m-1 p-2 border rounded bg-white" style="grid-area: 2/1/3/2;">
                <RadzenDataGrid TItem="PagoLineaResumenDia" @ref="DataGrid" Data="@Datos" AllowColumnResize="true" AllowSorting="true" AllowFiltering="false" Style="height:100%; width:auto;">
                    <Columns>
                        <RadzenDataGridColumn Property="@nameof(PagoLineaResumenDia.FechaString)" Title="Fecha" TextAlign="TextAlign.Left" Width="120px" />
                        <RadzenDataGridColumn Property="@nameof(PagoLineaResumenDia.TotalPagos)" Title="Pagos cobrados" TextAlign="TextAlign.Right" Width="120px" FormatString="{0:n0}" />
                        <RadzenDataGridColumn Property="@nameof(PagoLineaResumenDia.ImportePagos)" Title="Importe cobrado" TextAlign="TextAlign.Right" Width="125px" FormatString="{0:c2}" />
                        <RadzenDataGridColumn Property="@nameof(PagoLineaResumenDia.TotalPagosAplicados)" Title="Pagos aplicados" TextAlign="TextAlign.Right" Width="120px" FormatString="{0:n0}" />
                        <RadzenDataGridColumn Property="@nameof(PagoLineaResumenDia.ImportePagosAplicados)" Title="Importe aplicado" TextAlign="TextAlign.Right" Width="125px" FormatString="{0:c2}" />
                        <RadzenDataGridColumn Property="@nameof(PagoLineaResumenDia.TotalPagosPorAplicar)" Title="Pagos por aplicar" TextAlign="TextAlign.Right" Width="120px" FormatString="{0:n0}" />
                        <RadzenDataGridColumn Property="@nameof(PagoLineaResumenDia.ImportePagosPorAplicar)" Title="Importe por aplicar" TextAlign="TextAlign.Right" Width="125px" FormatString="{0:c2}" />
                        <RadzenDataGridColumn Title="Acciones" TextAlign="TextAlign.Center" Width="40px">
                            <Template>
                                @{
                                    var data = (context as PagoLineaResumenDia);
                                    if (data.Id > 0 && data.Id < 90)
                                    {
                                        <div class="d-flex align-items-center justify-content-center">
                                            <button type="button" class="btn btn-primary btn-sm mx-1" data-toggle="tooltip" data-placement="top" title="Detalle" @onclick="@(e => DetalleClick(data))">
                                                <i class="fa fa-table" aria-hidden="true"></i>
                                            </button>
                                        </div>
                                    }
                                }
                            </Template>
                        </RadzenDataGridColumn>
                    </Columns>
                </RadzenDataGrid>
            </div>

        </Content>
    </VentanaSecundaria>
    
    <BusyIndicator Busy="@_busyDialog" ContentText="Cargando datos...." />
    <PagoLineaDetalleVtn @ref="_pagoLineaDetalleVtn" CerrarModal="@(e => _detalleVtnVisible = false)"/>
}