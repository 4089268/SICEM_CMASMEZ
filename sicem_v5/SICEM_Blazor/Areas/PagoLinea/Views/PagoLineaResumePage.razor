@page "/PagoLineaResume"
@using Radzen
@using Radzen.Blazor
@namespace Sicem_Blazor.PagoLinea.Views
@using Sicem_Blazor.PagoLinea.Models

<div class="layoutPage">

    <div class="title-page text-uppercase" style="grid-area: 1/1/2/2;">Resumen Pagos aplicados de Pago en Linea</div>

    <div class="border rounded bg-white px-2 d-flex align-items-center" style="grid-area: 2/1/3/2;">
        <SeleccionarFecha ProcesarParam="@Procesar" OcultarSector="true" />
    </div>

    @* ****** DataGrid ****** *@
    <div class="d-flex align-items-center" style="grid-area: 3/1/4/2;">
    
        @if(_totalData != null)
        {
            <div class="border rounded bg-white d-flex flex-column align-items-center justify-content-start p-4 mr-4" style="min-width: 24rem;">
                <div> Importe Cobrado</div>
                <div class="d-flex align-items-center justify-content-around">
                    <div class="fa-3x text-center w-100">@_totalData.ImportePagos.ToString("c2", _currentCultureInfo)</div>
                </div>
            </div>

            <div class="border rounded bg-white d-flex flex-column align-items-center justify-content-around p-4 mr-4" style="min-width: 24rem;">
                <div> Importe Aplicado</div>
                <div class="d-flex align-items-center justify-content-around">
                    <div class="fa-3x text-center w-100">@_totalData.ImportePagosAplicados.ToString("c2", _currentCultureInfo)</div>
                </div>
            </div>
            <div class="border rounded bg-white d-flex flex-column align-items-center justify-content-around p-4 mr-4" style="min-width: 24rem;">
                <div> Importe Por Aplicar</div>
                <div class="d-flex align-items-center justify-content-around">
                    <div class="fa-3x text-center w-100">@_totalData.ImportePagosPorAplicar.ToString("c2", _currentCultureInfo)</div>
                </div>
            </div>
        }
        else
        {
            <div class="border rounded bg-white d-flex flex-column align-items-center justify-content-around p-4 mr-4" style="min-width: 24rem;">
                <div> Importe Cobrado</div>
                <div class="fa-3x text-center w-100">0</div>
            </div>

            <div class="border rounded bg-white d-flex flex-column align-items-center justify-content-around p-4 mr-4" style="min-width: 24rem;">
                <div> Importe Aplicado</div>
                <div class="fa-3x text-center w-100">0</div>
            </div>
            <div class="border rounded bg-white d-flex flex-column align-items-center justify-content-around p-4 mr-4" style="min-width: 24rem;">
                <div> Importe Por Aplicar</div>
                <div class="fa-3x text-center w-100">0</div>
            </div>
        }
    </div>

    <div class="border rounded bg-white p-1" style="grid-area: 4/1/5/2;">
        <RadzenDataGrid TItem="PagoLineaResumen" @ref="DataGrid" Data="@DataOffices" AllowColumnResize="true" AllowSorting="true" AllowFiltering="false" Density="Density.Compact" Style="height:100%; width:100%;">
            <Columns>
                <RadzenDataGridColumn Title="" TextAlign="TextAlign.Center" Width="40px">
                    <Template>
                        @{
                            var data = (context as PagoLineaResumen);
                            if(data.Id > 0 && data.Id < 999)
                            {
                                @switch (data.Estatus)
                                {

                                    case ResumenOficinaEstatus.Completado:
                                        <i class="fas fa-check-circle" style="color:green; font-size:1.5rem;"></i>
                                        break;

                                    case ResumenOficinaEstatus.Error:
                                        <i class="fas fa-exclamation-circle" style="color:red; font-size:1.5rem;"></i>
                                        break;

                                    default:
                                        <div class="spinner-border p-2" role="status"> </div>
                                        break;
                                }
                            }
                        }
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn Property="@nameof(PagoLineaResumen.Oficina)" Title="Oficina" TextAlign="TextAlign.Left" Width="100px" />

                <RadzenDataGridColumn Property="@nameof(PagoLineaResumen.TotalPagos)" Title="Pagos cobrados" TextAlign="TextAlign.Right" Width="120px" FormatString="{0:n0}" />
                <RadzenDataGridColumn Property="@nameof(PagoLineaResumen.ImportePagos)" Title="Importe cobrado" TextAlign="TextAlign.Right" Width="125px" FormatString="{0:c2}" />
                
                <RadzenDataGridColumn Property="@nameof(PagoLineaResumen.TotalPagosAplicados)" Title="Pagos aplicados" TextAlign="TextAlign.Right" Width="120px" FormatString="{0:n0}" />
                <RadzenDataGridColumn Property="@nameof(PagoLineaResumen.ImportePagosAplicados)" Title="Importe aplicado" TextAlign="TextAlign.Right" Width="125px" FormatString="{0:c2}" />

                <RadzenDataGridColumn Property="@nameof(PagoLineaResumen.TotalPagosPorAplicar)" Title="Pagos por aplicar" TextAlign="TextAlign.Right" Width="120px" FormatString="{0:n0}" />
                <RadzenDataGridColumn Property="@nameof(PagoLineaResumen.ImportePagosPorAplicar)" Title="Importe por aplicar" TextAlign="TextAlign.Right" Width="125px" FormatString="{0:c2}" />
                <RadzenDataGridColumn Title="Acciones" TextAlign="TextAlign.Center" Width="40px">
                    <Template>
                        @{
                            var data = (context as PagoLineaResumen);
                            if (data.Id > 0 && data.Id < 90)
                            {
                                <div class="d-flex align-items-center justify-content-center">
                                    <button type="button" class="btn btn-primary btn-sm mx-1" data-toggle="tooltip" data-placement="top" title="Resumen Dias" disabled="@(data.Estatus != ResumenOficinaEstatus.Completado)" @onclick="@(e => ResumenDiasClick(data))">
                                        <i class="fa fa-calendar" aria-hidden="true"></i>
                                    </button>

                                    <button type="button" class="btn btn-primary btn-sm mx-1" data-toggle="tooltip" data-placement="top" title="Detalle" disabled="@(data.Estatus != ResumenOficinaEstatus.Completado)" @onclick="@(e => DetalleClick(data))">
                                        <i class="fa fa-table" aria-hidden="true"></i>
                                    </button>
                                </div>
                            }
                        }
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    </div>
</div>


@* ****** Dialogos y ventanas secundarias ****** *@
<BusyIndicator Busy="@_busyDialog" ContentText="Cargando datos...." />
<ResumenDiasVtn @ref="_resumenDiasVtn" CerrarModal="@(e => _resumenDiasVisible = false)"/>
<PagoLineaDetalleVtn @ref="_pagoLineaDetalleVtn" CerrarModal="@(e => _detalleVtnVisible = false)"/>

<style>
    .layoutPage
    {
        display: grid;
        grid-template-columns: 100%;
        grid-template-rows: 3rem 5rem 9rem calc(100% - 18rem);
        grid-gap: 0.5rem;
        width: 100%;
        height: 100%;
        padding-bottom: 1rem;
    }
</style>