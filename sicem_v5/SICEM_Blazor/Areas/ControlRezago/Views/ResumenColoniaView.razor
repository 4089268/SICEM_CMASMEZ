@using Sicem_Blazor.ControlRezago.Models
@inject ExportacionExcelService ExportacionExcel

<div class="d-flex align-itenms-center my-2">
    <div class="button bg-success px-3 py-1" @onclick="OnExportExcel_Click">
        <i class="fa fa-file-excel mr-2"></i>
        <span>Exportar Datos</span>
    </div>
</div>

<div style="height: calc(100% - 3.5rem);" >
    <RadzenDataGrid TItem="ResumenColonia" @ref="DataGrid" Data="@DatosGrid" AllowColumnResize="true" AllowSorting="true" Style="height:100%; width:100%;">
        <Columns> 
            <RadzenDataGridColumn Title="" TextAlign="TextAlign.Left" Width="40px">
                <Template>
                    @{
                        var data = (context as ResumenColonia);
                        <div class="d-flex p-1">
                            <button type="button" class="btn btn-primary btn-sm mx-1" data-toggle="tooltip" data-placement="top" title="Detalle" @onclick=@( e => OnClick(data) )>
                                <i class="fa fa-bookmark" aria-hidden="true"></i>
                            </button>
                        </div>
                    }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Property="@nameof(ResumenColonia.Colonia)" Title="Colonia" TextAlign="TextAlign.Left" Width="170px" />
            <RadzenDataGridColumn Property="@nameof(ResumenColonia.Usuarios)" Title="Usuarios" TextAlign="TextAlign.Center" Width="115px" FormatString="{0:n0}" />
            <RadzenDataGridColumn Property="@nameof(ResumenColonia.Subtotal)" Title="Subtotal" TextAlign="TextAlign.Right" Width="125px" FormatString="{0:c2}" />
            <RadzenDataGridColumn Property="@nameof(ResumenColonia.IVA)" Title="IVA" TextAlign="TextAlign.Right" Width="125px" FormatString="{0:c2}" />
            <RadzenDataGridColumn Property="@nameof(ResumenColonia.Total)" Title="Total" TextAlign="TextAlign.Right" Width="125px" FormatString="{0:c2}" />
        </Columns>
    </RadzenDataGrid>
</div>


@code
{
    public RadzenDataGrid<ResumenColonia> DataGrid {get;set;}
    [Parameter] public List<ResumenColonia> DatosGrid {get;set;}
    [Parameter] public EventCallback<string> OnDetailClick {get;set;}
    private async Task OnClick(ResumenColonia e)
    {
        await OnDetailClick.InvokeAsync(e.Colonia);
    }
    private async Task OnExportExcel_Click()
    {
        var _properties = new ExcelExportProperties()
        {
            IncludeHiddenColumn = true,
            FileName = $"REZAGO_POR_COLONIAS_{Guid.NewGuid().ToString().Replace("-","")}.xlsx"
        };
        await ExportacionExcel.ExportarAsync(DataGrid, _properties);
    }

}