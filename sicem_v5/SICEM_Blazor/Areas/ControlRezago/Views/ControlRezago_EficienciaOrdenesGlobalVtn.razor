                Contents = xconts
            },
            FileName = string.Format("sicem_IngresosxDias{0}.pdf", Guid.NewGuid().ToString().Replace("-", ""))
        });
    }
    */

    public class CharItem
    {
        public string Descripcion { get; set; }
        public int Valor1 { get; set; }
    }
}