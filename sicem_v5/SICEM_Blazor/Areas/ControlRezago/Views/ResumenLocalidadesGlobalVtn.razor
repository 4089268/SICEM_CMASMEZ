@using Sicem_Blazor.ControlRezago.Models
@inject RadzenDataGridExportacionExcelService ExportacionExcel
@if(Visible)
{
    <VentanaSecundaria Titulo="@Titulo" CerrarVentana="@CerrarModalClick" Filas="@(new double[] {.85 })" Columnas="@(new double[]{.85})">
        <Content>
            <div class="w-100 h-100">

                <div class="m-1 p-2 border rounded bg-white" style="">
                    <div class="w-100 d-flex align-items-center">
                        <MatButton Class="ml-1 mr-2" Raised="true" Style="height:2.5rem;" OnClick="@GenerarExcel">Exportar Excel <i class="fa fa-file-excel-o ml-2" aria-hidden="true"></i> </MatButton>
                    </div>
                </div>

                <div class="m-1 p-2 border rounded bg-white" style="width:100%; height: calc(100% - 4rem);">
                    <RadzenDataGrid TItem="HistSaldoLocalidad" SelectionMode="DataGridSelectionMode.Single" @ref="DataGrid" Data="@DatosGrid" AllowColumnResize="true" AllowSorting="true" AllowFiltering="false" Density="Density.Compact" class="grid-sin-panel-grupos" AllowGrouping="true" Groups="@_grupos" Style="height:100%; width:auto;">
                        <GroupHeaderTemplate>
                                @{
                                    var order = new { Key = context.Data.Key?.ToString() ?? "", Count = context.Data.Count };
                                    if(order.Key.Contains("--*--"))
                                    {
                                        <div class="pt-4 pb-3">TOTAL</div>
                                    }
                                    else
                                    {
                                        <div Class="pt-4 pb-3"> @order.Key.ToString().ToUpper()</div>
                                    }
                                }
                        </GroupHeaderTemplate>
                        <Columns>
                            <RadzenDataGridColumn Property="@nameof(HistSaldoLocalidad.Localidad)" Title="Localidad" TextAlign="TextAlign.Left" Width="200px" />
                            <RadzenDataGridColumn Property="@nameof(HistSaldoLocalidad.Colonia)" Title="Colonia" TextAlign="TextAlign.Left" Width="200px" />
                            <RadzenDataGridColumn Property="@nameof(HistSaldoLocalidad.Usu_0)" Title="Usu M.A. 0" TextAlign="TextAlign.Center" Width="115px" FormatString="{0:n0}" />
                            <RadzenDataGridColumn Property="@nameof(HistSaldoLocalidad.Usu_1_2)" Title="Usu M.A. 1-2" TextAlign="TextAlign.Center" Width="115px" FormatString="{0:n0}" />
                            <RadzenDataGridColumn Property="@nameof(HistSaldoLocalidad.Usu_3_5)" Title="Usu M.A. 3-5" TextAlign="TextAlign.Center" Width="115px" FormatString="{0:n0}" />
                            <RadzenDataGridColumn Property="@nameof(HistSaldoLocalidad.Usu_6_10)" Title="Usu M.A. 6-10" TextAlign="TextAlign.Center" Width="115px" FormatString="{0:n0}" />
                            <RadzenDataGridColumn Property="@nameof(HistSaldoLocalidad.Usu_11)" Title="Usu M.A. > 11" TextAlign="TextAlign.Center" Width="115px" FormatString="{0:n0}" />
                            <RadzenDataGridColumn Property="@nameof(HistSaldoLocalidad.Usuarios)" Title="Usu Total" TextAlign="TextAlign.Center" Width="115px" FormatString="{0:n0}" />
                            <RadzenDataGridColumn Property="@nameof(HistSaldoLocalidad.Imp_0)" Title="Imp M.A. 0" TextAlign="TextAlign.Right" Width="120px" FormatString="{0:c2}" />
                            <RadzenDataGridColumn Property="@nameof(HistSaldoLocalidad.Imp_1_2)" Title="Imp M.A. 1-2" TextAlign="TextAlign.Right" Width="120px" FormatString="{0:c2}" />
                            <RadzenDataGridColumn Property="@nameof(HistSaldoLocalidad.Imp_3_5)" Title="Imp M.A. 3-5" TextAlign="TextAlign.Right" Width="120px" FormatString="{0:c2}" />
                            <RadzenDataGridColumn Property="@nameof(HistSaldoLocalidad.Imp_6_10)" Title="Imp M.A. 6-10" TextAlign="TextAlign.Right" Width="120px" FormatString="{0:c2}" />
                            <RadzenDataGridColumn Property="@nameof(HistSaldoLocalidad.Imp_11)" Title="Imp M.A. > 11" TextAlign="TextAlign.Right" Width="120px" FormatString="{0:c2}" />
                            <RadzenDataGridColumn Property="@nameof(HistSaldoLocalidad.Total)" Title="Imp Total" TextAlign="TextAlign.Right" Width="120px" FormatString="{0:c2}" />
                        </Columns>
                    </RadzenDataGrid>
                </div>
            </div>
        </Content>
    </VentanaSecundaria>
}

@code
{

    // Agrupación inicial (en Syncfusion: GridGroupSettings Columns)
    private System.Collections.ObjectModel.ObservableCollection<GroupDescriptor> _grupos = new System.Collections.ObjectModel.ObservableCollection<GroupDescriptor>() { new GroupDescriptor() { Property = "Localidad" } };
    [Parameter] public bool Visible {get;set;} = false;
    [Parameter] public EventCallback CerrarModal { get; set; }
    public IEnlace Enlace { get; set; }
    public string Titulo = "RESUMEN HISTORIAL SALDOS POR LOCALIDADES";
    
    private RadzenDataGrid<HistSaldoLocalidad> DataGrid {get;set;}
    public List<HistSaldoLocalidad> DatosGrid {get;set;}

    //"******** Funciones ********"
    public void Inicializar(IEnlace e, IEnumerable<HistSaldoLocalidad> datos)
    {
        this.Enlace = e;
        Titulo = $"{Enlace.Nombre.ToUpper()} - RESUMEN HISTORIAL SALDOS POR LOCALIDADES";
        this.DatosGrid = datos.OrderBy(item => item.Localidad).ToList();
    }
    private async Task CerrarModalClick()
    {
        await CerrarModal.InvokeAsync(null);
    }
    private async Task GenerarExcel()
    {
        await ExportacionExcel.ExportarAsync(DataGrid);
    }
    
}