@using Sicem_Blazor.ControlRezago.Models
@inject IJSRuntime JSRuntime
@inject RadzenDataGridExportacionExcelService ExportacionExcel

    <VentanaSecundaria Titulo="@Titulo" Columnas="@_gridColumnas" Filas="@_gridFilas" CerrarVentana="@( e => Cerrar_Modal() )">
        <Content>

            <div class="p-2 border rounded bg-white" style="grid-row: 1/2; grid-column: 1/2;">
                <MatButton Class="mx-1 bg-success" Raised="true" OnClick="@GenerarExcel">Exportar Excel <i class="fa fa-file-excel-o ml-2" aria-hidden="true"></i> </MatButton>
            </div>

            <div class="m-1 p-2 border rounded bg-white" style="grid-row: 2/3; grid-column: 1/2;">
                <RadzenDataGrid TItem="DetalleRezago" SelectionMode="DataGridSelectionMode.Single" @ref="_dataGrid" Data="@DatosGrid" AllowPaging="@_allowPagesGrid" AllowSorting="true" AllowColumnResize="true" AllowFiltering="false" PageSize="1000" Style="height:100%; width:auto;">
                    <Columns>
                        <RadzenDataGridColumn Title="" TextAlign="TextAlign.Center" Width="55px">
                            <Template>
                                @{
                                    var data = (context as DetalleRezago);
                                    <button type="button" class="btn btn-primary btn-sm" data-toggle="tooltip" data-placement="top" title="Mostrar en Consulta General" @onclick="@( e => MostrarDatosGenerales(data))">
                                        <i class="fa fa-address-book-o" aria-hidden="true"></i>
                                    </button>
                                }
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn Property="@nameof(DetalleRezago.Cuenta)" Title="Cuenta" TextAlign="TextAlign.Left" Width="110px" />
                        <RadzenDataGridColumn Property="@nameof(DetalleRezago.Nombre)" Title="Nombre" TextAlign="TextAlign.Left" Width="180px" />
                        <RadzenDataGridColumn Property="@nameof(DetalleRezago.Estatus)" Title="Estatus" TextAlign="TextAlign.Left" Width="120px" />
                        <RadzenDataGridColumn Property="@nameof(DetalleRezago.Localizacion)" Title="Localizacion" TextAlign="TextAlign.Left" Width="210px" />
                        <RadzenDataGridColumn Property="@nameof(DetalleRezago.Direccion)" Title="Direccion" TextAlign="TextAlign.Left" Width="190px" />
                        <RadzenDataGridColumn Property="@nameof(DetalleRezago.Tarifa)" Title="Tarifa" TextAlign="TextAlign.Left" Width="180px" />
                        <RadzenDataGridColumn Property="@nameof(DetalleRezago.Colonia)" Title="Colonia" TextAlign="TextAlign.Left" Width="180px" />
                        <RadzenDataGridColumn Property="@nameof(DetalleRezago.Lec_ant)" Title="Lect. Ant." TextAlign="TextAlign.Center" Width="90px" />
                        <RadzenDataGridColumn Property="@nameof(DetalleRezago.Lec_act)" Title="Lect. Act." TextAlign="TextAlign.Center" Width="90px" />
                        <RadzenDataGridColumn Property="@nameof(DetalleRezago.Consumo)" Title="Consumo" TextAlign="TextAlign.Center" Width="90px" />
                        <RadzenDataGridColumn Property="@nameof(DetalleRezago.Calculo)" Title="Calculo" TextAlign="TextAlign.Center" Width="90px" />
                        <RadzenDataGridColumn Property="@nameof(DetalleRezago.Promedio)" Title="Promedio" TextAlign="TextAlign.Center" Width="90px" />
                        <RadzenDataGridColumn Property="@nameof(DetalleRezago.Medidor)" Title="Medidor" TextAlign="TextAlign.Center" Width="90px" />
                        <RadzenDataGridColumn Property="@nameof(DetalleRezago.Agua)" Title="Agua" TextAlign="TextAlign.Right" Width="90px" FormatString="{0:c2}" />
                        <RadzenDataGridColumn Property="@nameof(DetalleRezago.Dren)" Title="Dren" TextAlign="TextAlign.Right" Width="90px" FormatString="{0:c2}" />
                        <RadzenDataGridColumn Property="@nameof(DetalleRezago.Sane)" Title="Sane" TextAlign="TextAlign.Right" Width="90px" FormatString="{0:c2}" />
                        <RadzenDataGridColumn Property="@nameof(DetalleRezago.Otros)" Title="Actuali" TextAlign="TextAlign.Right" Width="90px" FormatString="{0:c2}" />
                        <RadzenDataGridColumn Property="@nameof(DetalleRezago.RezAgua)" Title="Rez Agua" TextAlign="TextAlign.Right" Width="90px" FormatString="{0:c2}" />
                        <RadzenDataGridColumn Property="@nameof(DetalleRezago.RezDren)" Title="Rez Dren" TextAlign="TextAlign.Right" Width="90px" FormatString="{0:c2}" />
                        <RadzenDataGridColumn Property="@nameof(DetalleRezago.RezTrat)" Title="Rez Trat" TextAlign="TextAlign.Right" Width="90px" FormatString="{0:c2}" />
                        <RadzenDataGridColumn Property="@nameof(DetalleRezago.Subtotal)" Title="Subtotal" TextAlign="TextAlign.Right" Width="90px" FormatString="{0:c2}" />
                        <RadzenDataGridColumn Property="@nameof(DetalleRezago.Iva)" Title="IVA" TextAlign="TextAlign.Right" Width="90px" FormatString="{0:c2}" />
                        <RadzenDataGridColumn Property="@nameof(DetalleRezago.Total)" Title="Total" TextAlign="TextAlign.Right" Width="90px" FormatString="{0:c2}" />
                    </Columns>
                </RadzenDataGrid>
            </div>
            
        </Content>
    </VentanaSecundaria>

    @if(_datosGenerales_visible)
    {
        <DatosGenerales_Dialog IdOficina="@EnlaceSeleccionado.Id" Cuenta="@_cuentaActual" CerrarVentana="@(e => _datosGenerales_visible = false)"/>
    }

@code
{
    [Parameter] public string Titulo {get;set;} = "";
    [Parameter] public EventCallback CerrarModal { get; set; }
    [Parameter] public DateTime Fecha1 { get; set; }
    [Parameter] public DateTime Fecha2 { get; set; }
    [Parameter] public int Subsistema { get; set; }
    [Parameter] public int Sector { get; set; }
    [Parameter] public List<DetalleRezago> DatosGrid {get;set;}
    [Parameter] public IEnlace EnlaceSeleccionado {get;set;}

    RadzenDataGrid<DetalleRezago> _dataGrid;
    bool _allowPagesGrid = false;
    private List<double> _gridFilas = new List<double>() { 50, .75 };
    private List<double> _gridColumnas = new List<double>() { .95 };
    private string _cuentaActual = "0";
    private bool _datosGenerales_visible = false;
    
    
    protected override void OnInitialized()
    {
        if(DatosGrid != null)
        {
            if(DatosGrid.Count() > 2000)
            {
                this._allowPagesGrid = true;
            }
        }
    }
    private async Task Cerrar_Modal()
    {
       await CerrarModal.InvokeAsync(null);
    }
    private async Task GenerarExcel()
    {
        await ExportacionExcel.ExportarAsync(this._dataGrid, new ExcelExportProperties
        {
            FileName = string.Format("sicem_{0}.xlsx", Guid.NewGuid().ToString().Replace("-", ""))
        });
    }
    private void MostrarDatosGenerales(DetalleRezago e)
    {
        Console.WriteLine("Cuenta seleccionado:" + e.Cuenta + "  Enlace Seleccionado: " + EnlaceSeleccionado.Nombre);
        this._cuentaActual = e.Cuenta.ToString();
        this._datosGenerales_visible = true;
    }

}