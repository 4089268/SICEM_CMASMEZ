@page "/seguimiento_cobros"
@using Sicem_Blazor.SeguimientoCobros.Models;
@using Sicem_Blazor.SeguimientoCobros.Data;
@using System.Threading
@inject IJSRuntime JSRuntime
@inject IncomeOfficeService incomeOfficeService
@inject IMatToaster Toaster
@implements IDisposable


<div id="map" style="height:100%;width:100%;"></div>

<div class="d-flex p-2 justify-content-end" style="height:90vh; position:fixed; right:0; ">
    <div class="border rounded-lg m-2 p-2 bg-white" style=" width: 45rem;">
        <div class="d-flex flex-column" style="height:40%" >
            <div class="text-center font-weight-bold">Ingresos por Sucursal</div>
            <RadzenChart @ref="_chartIngresos" Style="flex:1; width:100%;">
                <RadzenLegend Visible="true" Position="LegendPosition.Top" />
                <RadzenDonutSeries Data="@IncomeDataGraph" CategoryProperty="@nameof(OfficePushpinMap.Office)" ValueProperty="@nameof(OfficePushpinMap.Income)" Title="Ingresos" Fills="@_palettes">
                    <RadzenSeriesDataLabels Visible="true" />
                </RadzenDonutSeries>
            </RadzenChart>
        </div>
        <div class="d-flex flex-column" style="height:35%">
            <div class="text-center font-weight-bold">Recibos por Sucursal</div>
            <RadzenChart @ref="_chartRecibos" Style="flex:1; width:100%;">
                <RadzenLegend Visible="false" />
                <RadzenDonutSeries Data="@IncomeDataGraph" CategoryProperty="@nameof(OfficePushpinMap.Office)" ValueProperty="@nameof(OfficePushpinMap.Bills)" Title="Recibos" Fills="@_palettes">
                    <RadzenSeriesDataLabels Visible="true" />
                </RadzenDonutSeries>
            </RadzenChart>
        </div>
        <div style="height:25%">
            <RadzenDataGrid @ref="_dataGrid" TItem="OfficePushpinMap" Data="@IncomeData" Style="height:100%; width:100%;">
                <Columns>
                    <RadzenDataGridColumn Property="@nameof(OfficePushpinMap.Office)" Title="Sucursal" TextAlign="TextAlign.Left" />
                    <RadzenDataGridColumn Property="@nameof(OfficePushpinMap.Bills)" Title="Recibos" TextAlign="TextAlign.Right" FormatString="{0:n0}" />
                    <RadzenDataGridColumn Property="@nameof(OfficePushpinMap.Income)" Title="Ingresos" TextAlign="TextAlign.Right" FormatString="{0:c2}" />
                </Columns>
            </RadzenDataGrid>
        </div>
    </div>
</div>


@code
{
    // Antes era static: el timer se compartía entre todas las sesiones de usuario
    private Timer _fetchTimer;
    private List<OfficePushpinMap> IncomeData { get; set; }
    private List<OfficePushpinMap> IncomeDataGraph
    {
        get => IncomeData.Where(item => item.Id < 900).ToList();
    }
    private RadzenDataGrid<OfficePushpinMap> _dataGrid;
    private RadzenChart _chartIngresos;
    private RadzenChart _chartRecibos;
    private string[] _palettes = { "#2e86c1", "#28b463", "#d68910", "#884ea0" };

    protected override void OnInitialized()
    {
        IncomeData = incomeOfficeService.GetIncomes().ToList();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JSRuntime.InvokeVoidAsync("initIncomeMap");
            await JSRuntime.InvokeVoidAsync("actualizarItems", IncomeData);
            await Task.Delay(8000);
            _fetchTimer = new Timer(FetchData, null, 0, 6000);
        }
    }

    private async void FetchData(object state)
    {
        try
        {
            var tmpIncomeData = incomeOfficeService.GetIncomes().ToList();
            await RefreIncomesData(tmpIncomeData);

            await JSRuntime.InvokeVoidAsync("actualizarItems", tmpIncomeData);

        }
        catch (Exception err)
        {
            Console.WriteLine(err.Message);
        }
    }

    private async Task RefreIncomesData(List<OfficePushpinMap> data)
    {
        try
        {
            foreach (var newData in data)
            {
                var refdata = IncomeData.Where(item => item.Id == newData.Id).FirstOrDefault();
                if (refdata != null)
                {
                    refdata.Bills = newData.Bills;
                    refdata.Income = newData.Income;
                }
            }

            // El timer corre fuera del hilo de render: refrescar a través de InvokeAsync
            await InvokeAsync(async () =>
            {
                await _dataGrid.Reload();
                await _chartIngresos.Reload();
                await _chartRecibos.Reload();
                StateHasChanged();
            });
        }
        catch (Exception err)
        {
            Console.WriteLine(err.Message);
        }
    }

    public async void Dispose()
    {
        await JSRuntime.InvokeVoidAsync("cerrarVentanaCobroCaja");

        try
        {
            _fetchTimer?.Dispose();
        }
        catch (Exception)
        {
        }
    }

}
