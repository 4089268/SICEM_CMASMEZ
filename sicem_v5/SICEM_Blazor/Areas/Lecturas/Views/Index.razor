@page "/lecturas"
@using Radzen
@using Radzen.Blazor
@using Sicem_Blazor.Lecturas.Data
@using Sicem_Blazor.Lecturas.Models
@inject IMatToaster Toaster
@inject IJSRuntime JSRuntime
@inject SicemService sicemService
@inject LecturasService lecturasService  


<div class="layout-page1">

    <div class="title-page" style="grid-area:1/1/2/2;">CONSULTA DE LECTURAS</div>

    <MatTabGroup @ref="_tabGroup" Class="mx-1 mt-2 mb-1 p-1 border rounded bg-white" Style="grid-row:2/6; grid-column:1/2;">
        <MatTab >
            <LabelContent><span class="h5">Desempeño Lecturistas</span></LabelContent>
            <ChildContent>
                <DesempenioLecturistas />
            </ChildContent>
        </MatTab>
        <MatTab>
            <LabelContent><span class="h5">Resumen de Incidencias</span></LabelContent>
            <ChildContent>
                <IncidenciasLecturas />
            </ChildContent>
        </MatTab>
    </MatTabGroup> 

</div>

@code
{
      MatTabGroup _tabGroup;
}