@using Sicem_Blazor.Lecturas.Models
@using Sicem_Blazor.Lecturas.Data
@inject IMatToaster Toaster
@inject RadzenDataGridExportacionExcelService ExportacionExcel

<VentanaSecundaria Titulo="@Title" Filas="@(new double[]{40, 750})" Columnas="@(new double[]{.85})" CerrarVentana="CerrarModal">
    <Content>
        <div role="actions">
            <MatButton Class="mx-2" style="min-width: 130px;" Raised="true" @onclick="ExportarExcel_Click">Exportar Excel</MatButton>
        </div>

        <RadzenDataGrid TItem="DetalleLecturista" SelectionMode="DataGridSelectionMode.Single" @ref="DataGrid" Data="@Datos" AllowColumnResize="true" AllowSorting="false" AllowFiltering="false" Density="Density.Compact" Style="height:100%; width:100%;">
            <Columns>
                <RadzenDataGridColumn Property="@nameof(DetalleLecturista.Id_Localidad)" Title="Id Localidad" TextAlign="TextAlign.Center" Width="100px" Visible="false" />
                <RadzenDataGridColumn Property="@nameof(DetalleLecturista.Localidad)" Title="Concepto" TextAlign="TextAlign.Left" Width="140px" />
                <RadzenDataGridColumn Property="@nameof(DetalleLecturista.Cuenta)" Title="Cuenta" TextAlign="TextAlign.Center" Width="100px" />
                <RadzenDataGridColumn Property="@nameof(DetalleLecturista.Localizacion)" Title="Localizacion" TextAlign="TextAlign.Center" Width="200px" />
                <RadzenDataGridColumn Property="@nameof(DetalleLecturista.Usuario)" Title="Usuario" TextAlign="TextAlign.Left" Width="200px" />
                <RadzenDataGridColumn Property="@nameof(DetalleLecturista.Direccion)" Title="Direccion" TextAlign="TextAlign.Left" Width="200px" />
                <RadzenDataGridColumn Property="@nameof(DetalleLecturista.Tarifa)" Title="Tarifa" TextAlign="TextAlign.Center" Width="100px" />
                <RadzenDataGridColumn Property="@nameof(DetalleLecturista.Fecha)" Title="Fecha" TextAlign="TextAlign.Center" Width="170px" />
                <RadzenDataGridColumn Property="@nameof(DetalleLecturista.Lectura_Anterior)" Title="Lectura Ant." TextAlign="TextAlign.Center" Width="90px" FormatString="{0:n0}" />
                <RadzenDataGridColumn Property="@nameof(DetalleLecturista.Lectura_Actual)" Title="Lectura Act." TextAlign="TextAlign.Center" Width="90px" FormatString="{0:n0}" />
                <RadzenDataGridColumn Property="@nameof(DetalleLecturista.Consumo)" Title="Consumo" TextAlign="TextAlign.Center" Width="90px" FormatString="{0:n0}" />
                <RadzenDataGridColumn Property="@nameof(DetalleLecturista.Anomalia)" Title="Anomalia" TextAlign="TextAlign.Center" Width="160px" />
                <RadzenDataGridColumn Property="@nameof(DetalleLecturista.Incidencia)" Title="Incidencias" TextAlign="TextAlign.Center" Width="160px" />
            </Columns>
        </RadzenDataGrid>

    </Content>
    
</VentanaSecundaria>

@code
{
    [Parameter] public string Title {get;set;} = "Detalle lecturista";
    [Parameter] public IEnlace Oficina {get;set;}
    [Parameter] public IEnumerable<DetalleLecturista> Datos {get;set;}
    [Parameter] public EventCallback<bool> Cerrar {get;set;}

    private RadzenDataGrid<DetalleLecturista> DataGrid { get; set; }
    
    private async Task CerrarModal()
    {
        await Cerrar.InvokeAsync(false);
    }

    private async Task ExportarExcel_Click()
    {
        var _options = new ExcelExportProperties()
        {
            IncludeHiddenColumn = true
        };
        await ExportacionExcel.ExportarAsync(this.DataGrid, _options);
    }

}