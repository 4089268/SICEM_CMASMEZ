@using Sicem_Blazor.Lecturas.Models
@using Sicem_Blazor.Lecturas.Data
@inject IMatToaster Toaster

<VentanaSecundaria Titulo="@Title" Filas="@(new double[]{40, 750})" Columnas="@(new double[]{.85})" CerrarVentana="CerrarModal">
    <Content>
        <div role="actions">
            <MatButton Class="mx-2" style="min-width: 130px;" Raised="true" @onclick="ExportarExcel_Click">Exportar Excel</MatButton>
        </div>

        <SfGrid @ref="dataGrid" DataSource="@Datos" TValue="DetalleLecturista" AllowExcelExport="true" AllowResizing="true" AllowSorting="false" AllowFiltering="false" Height="100%" Width="100%" RowHeight="24">
            <GridColumns>
                <GridColumn Field="@nameof(DetalleLecturista.Id_Localidad)" HeaderText="Id Localidad" TextAlign="TextAlign.Center" Width="100" Visible="false" />
                <GridColumn Field="@nameof(DetalleLecturista.Localidad)" HeaderText="Concepto" TextAlign="TextAlign.Left" Width="140" />
                <GridColumn Field="@nameof(DetalleLecturista.Cuenta)" HeaderText="Cuenta" TextAlign="TextAlign.Center" Width="100"/>
                <GridColumn Field="@nameof(DetalleLecturista.Localizacion)" HeaderText="Localizacion" TextAlign="TextAlign.Center" Width="200" />
                <GridColumn Field="@nameof(DetalleLecturista.Usuario)" HeaderText="Usuario" TextAlign="TextAlign.Left" Width="200" />
                <GridColumn Field="@nameof(DetalleLecturista.Direccion)" HeaderText="Direccion" TextAlign="TextAlign.Left" Width="200" />
                <GridColumn Field="@nameof(DetalleLecturista.Tarifa)" HeaderText="Tarifa" TextAlign="TextAlign.Center" Width="100" />
                <GridColumn Field="@nameof(DetalleLecturista.Fecha)" HeaderText="Fecha" TextAlign="TextAlign.Center" Width="170"  />
                <GridColumn Field="@nameof(DetalleLecturista.Lectura_Anterior)" HeaderText="Lectura Ant." TextAlign="TextAlign.Center" Width="90" Format="n0"/>
                <GridColumn Field="@nameof(DetalleLecturista.Lectura_Actual)" HeaderText="Lectura Act." TextAlign="TextAlign.Center" Width="90" Format="n0"/>
                <GridColumn Field="@nameof(DetalleLecturista.Consumo)" HeaderText="Consumo" TextAlign="TextAlign.Center" Width="90" Format="n0"/>
                <GridColumn Field="@nameof(DetalleLecturista.Anomalia)" HeaderText="Anomalia" TextAlign="TextAlign.Center" Width="160" />
                <GridColumn Field="@nameof(DetalleLecturista.Incidencia)" HeaderText="Incidencias" TextAlign="TextAlign.Center" Width="160" />
            </GridColumns>
        </SfGrid>

    </Content>
    
</VentanaSecundaria>

@code {
    [Parameter] public string Title {get;set;} = "Detalle lecturista";
    [Parameter] public IEnlace Oficina {get;set;}
    [Parameter] public IEnumerable<DetalleLecturista> Datos {get;set;}
    [Parameter] public EventCallback<bool> Cerrar {get;set;}

    private SfGrid<DetalleLecturista> dataGrid { get; set; }
    
    private async Task CerrarModal(){
        await Cerrar.InvokeAsync(false);
    }

    private async Task ExportarExcel_Click()
    {
        var _options = new ExcelExportProperties(){
            IncludeHiddenColumn = true
        };
        await this.dataGrid.ExportToExcelAsync(_options);
    }

}