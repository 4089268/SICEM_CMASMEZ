@using Sicem_Blazor.Lecturas.Data
@using Sicem_Blazor.Lecturas.Models
@inject IMatToaster Toaster
@inject IJSRuntime JSRuntime
@inject SicemService sicemService
@inject LecturasService lecturasService  

<div style="width: 100%; height: calc(100vh - 20rem); display: grid; grid-template-columns: 100%; grid-template-rows: 5rem 4.5rem 1fr 1fr; grid-gap: .4rem .4rem;">

    <div role="filter" class="border rounded bg-white px-2 d-flex align-items-center" style="grid-area:1/1/2/2;">
        <SeleccionarFechaDia fecha1="@_fecha1" fecha2="@_fecha2" ProcesarParam="@Procesar" />
    </div>

    <div role="actions" class="border rounded bg-white px-2 d-flex align-items-center" style="grid-area:2/1/3/2;">
        @* TODO-EXPORT-RADZEN: exportación pendiente (ver docs/MIGRACION.md)
        <MatButton style="min-width: 130px;" Raised="true" @onclick="ExportarExcel_Click">Exportar Excel</MatButton>
        *@
    </div>

    @* ****** DataGrid ****** *@
    <div class="border rounded bg-white p-2 d-flex" style="grid-area:3/1/4/2;">
        <RadzenDataGrid TItem="Lecturista" @ref="dataGrid" Data="@DatosLecturas" AllowColumnResize="true" AllowSorting="true" AllowFiltering="false" Style="height:100%; width:100%;">
            <Columns>
                <RadzenDataGridColumn Property="@nameof(Lecturista.Nombre)" Title="Lecturista" TextAlign="TextAlign.Left" Width="170px" />
                <RadzenDataGridColumn Property="@nameof(Lecturista.TotalLecturas)" Title="Lecturas" TextAlign="TextAlign.Center" Width="115px" FormatString="{0:n0}" />
                <RadzenDataGridColumn Property="@nameof(Lecturista.H0708)" Title="H 07-08" TextAlign="TextAlign.Center" Width="115px" FormatString="{0:n0}" />
                <RadzenDataGridColumn Property="@nameof(Lecturista.H0809)" Title="H 08-09" TextAlign="TextAlign.Center" Width="115px" FormatString="{0:n0}" />
                <RadzenDataGridColumn Property="@nameof(Lecturista.H0910)" Title="H 09-10" TextAlign="TextAlign.Center" Width="115px" FormatString="{0:n0}" />
                <RadzenDataGridColumn Property="@nameof(Lecturista.H1011)" Title="H 10-11" TextAlign="TextAlign.Center" Width="115px" FormatString="{0:n0}" />
                <RadzenDataGridColumn Property="@nameof(Lecturista.H1112)" Title="H 11-12" TextAlign="TextAlign.Center" Width="115px" FormatString="{0:n0}" />
                <RadzenDataGridColumn Property="@nameof(Lecturista.H1213)" Title="H 12-13" TextAlign="TextAlign.Center" Width="115px" FormatString="{0:n0}" />
                <RadzenDataGridColumn Property="@nameof(Lecturista.H1314)" Title="H 13-14" TextAlign="TextAlign.Center" Width="115px" FormatString="{0:n0}" />
                <RadzenDataGridColumn Property="@nameof(Lecturista.H1415)" Title="H 14-15" TextAlign="TextAlign.Center" Width="115px" FormatString="{0:n0}" />
                <RadzenDataGridColumn Property="@nameof(Lecturista.H1516)" Title="H 15-16" TextAlign="TextAlign.Center" Width="115px" FormatString="{0:n0}" />
                <RadzenDataGridColumn Property="@nameof(Lecturista.H1617)" Title="H 16-17" TextAlign="TextAlign.Center" Width="115px" FormatString="{0:n0}" />

                <RadzenDataGridColumn Title="Acciones" TextAlign="TextAlign.Left" Width="240px">
                    <Template>
                        @{
                        var data = (context as Lecturista);
                        <div class="d-flex p-1">
                            <button type="button" class="btn btn-primary btn-sm mx-1" data-toggle="tooltip" data-placement="top" title="Accion 1" @onclick="(e => MostrarDetalle(data) )" >
                                <i class="fa fa-bookmark" aria-hidden="true"></i>
                            </button>
                        </div>
                        }
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    </div>

    @****** Graficas ******@
    <div class="d-flex" style="grid-area:4/1/5/2;">
        <div class="border rounded bg-white mr-1 d-flex flex-column align-items-center" style="width:100%; height:100%;">
            <div class="text-center font-weight-bold">TARIFAS FACTURADAS</div>
            <RadzenChart @ref="Grafica" Style="height:100%; width:100%;">
                <RadzenCategoryAxis />
                <RadzenValueAxis Visible="false" FormatString="{0:n0}" />
                <RadzenChartTooltipOptions Shared="true" />
                <RadzenLegend Visible="true" Position="LegendPosition.Right" />
                <RadzenStackedBarSeries Data="@DatosGrafica" Title="Lecturas" CategoryProperty="Descripcion" ValueProperty="Valor1">
                    <TooltipTemplate Context="item">
                        <b>Lecturas</b> : {point.y}
                    </TooltipTemplate>
                    <ChildContent>
                        <RadzenSeriesDataLabels Visible="true" />
                    </ChildContent>
                </RadzenStackedBarSeries>
            </RadzenChart>
        </div>
    </div>

    <BusyIndicator Busy="@_busyDialog" ContentText="Cargando datos...." />

    @if(_ventanaDetalleVisible)
    {
        <DetalleLecturistaVtn Title="@VentanaDetalleTitle" Oficina="@_enlaceSeleccionado" Datos="@DatosDetalleLecturista" Cerrar="@( e => _ventanaDetalleVisible = false )" />
    }
</div>

@code
{

    private RadzenDataGrid<Lecturista> dataGrid {get;set;}
    private RadzenChart Grafica {get;set;}
    private List<Lecturista> DatosLecturas {get;set;}
    private List<ChartItem> DatosGrafica {get;set;}
    private bool _busyDialog = false;

    private DateTime _fecha1, _fecha2;
    private int _subsistema, _sector;
    private IEnlace _enlaceSeleccionado;

    private IEnumerable<DetalleLecturista> DatosDetalleLecturista {get;set;}
    private bool _ventanaDetalleVisible = false;
    private Lecturista _lecturistaSeleccionado;
    private string VentanaDetalleTitle
    {
        get => $"LECTURISTA -  {_lecturistaSeleccionado.Nombre}";
    }

    //********* Funciones  *********
    protected override void OnInitialized()
    {
        this._fecha1 = DateTime.Now;
        this._fecha2 = DateTime.Now;
        this._subsistema = 0;
        this._sector = 0;
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if(firstRender)
        {
            Procesar(new SeleccionarFechaEventArgs());
        }
    }

    public void Procesar(SeleccionarFechaEventArgs e)
    {
        this._fecha1 = e.Fecha1;
        this._fecha2 = e.Fecha2;
        this._subsistema = e.Subsistema;
        this._sector = e.Sector;

        DatosLecturas = new List<Lecturista>();
        DatosGrafica = new List<ChartItem>();
        var enlaces = sicemService.ObtenerOficinasDelUsuario();
        var oficinas = sicemService.ObtenerEnlaces().Where(item => enlaces.Select(i => i.Id).Contains(item.Id)).ToArray();

        this._enlaceSeleccionado = oficinas.FirstOrDefault();
        
        ProcesarConsulta(this._enlaceSeleccionado);

    }

    private async void ProcesarConsulta(IEnlace oficina)
    {
        this._busyDialog = true;
        await Task.Delay(100);
    
        var dateRange = new DateRange(_fecha1, _fecha2);
        
        this.DatosLecturas = lecturasService.ObtenerLecturasPorLecturisa(dateRange, oficina).ToList();

        // Actualizar Grafica
        var items = new List<ChartItem>();
        foreach(var item in this.DatosLecturas)
        {
            items.Add( new ChartItem()
            {
                Id = (int) item.IdLecturista,
                Descripcion = item.Nombre,
                Valor1 = item.TotalLecturas
            });
        }
        this.DatosGrafica = items;



        await Task.Delay(100);
        this._busyDialog = false;
        StateHasChanged();
    }

    private async Task MostrarDetalle(Lecturista lecturista)
    {
        this._busyDialog = true;
        await Task.Delay(200);
        this._lecturistaSeleccionado = lecturista;
        this.DatosDetalleLecturista = this.lecturasService.DetalleLecturista( new DateRange(lecturista.Inicio, lecturista.Fin), this._enlaceSeleccionado, (int) lecturista.IdLecturista).ToArray();

        if(this.DatosDetalleLecturista.Count() > 0)
        {
            this._ventanaDetalleVisible = true;
        }else
        {
            Toaster.Add("No hay datos disponibles para esta fecha", MatToastType.Info);
        }
        await Task.Delay(200);
        this._busyDialog = false;
        
    }

    // TODO-EXPORT-RADZEN: exportación pendiente (ver docs/MIGRACION.md). Código original de Syncfusion:
    /*
    private async Task ExportarExcel_Click()
    {
        var _options = new ExcelExportProperties(){
            IncludeHiddenColumn = true
        };
        await this.dataGrid.ExportToExcelAsync(_options);
    }
    */
}
